{{- range .Records}}
{{- $b := .Decl}}
{{- $m := .Data}}
{{- $start := index $b.Types.Items 0}}
{{- $tp := typeparams $b.TypeParams}}
{{- $ta := typeargs $b.TypeParams}}
{{- $v := spell $m.Value}}
{{- $s := spellvalue $m.Struct}}

{{docs (wrapdocs (printf `%s constructs %s values. %s.%s and %s.%s return a new builder.
Each setter sets one member and returns the builder, so the calls chain. build
returns the value.` $b.Name $m.Subject $b.Name $m.New $b.Name $m.From))}}
{{- ""}}export class {{$b.Name}}{{$tp}} {
  private readonly v: {{$v}};

  private constructor(v: {{$v}}) {
    this.v = v;
  }
{{- if eq $m.Seed "companion"}}

  /**
   * {{$m.New}} returns a builder of the value that the companion function
   * returns. The declared default of each member applies over that value.
   */
  static {{$m.New}}{{$tp}}(): {{$b.Name}}{{$ta}} {
{{memberbody $start}}    return new {{$b.Name}}{{$ta}}(v);
  }
{{- else if eq $m.Seed "defaults"}}

  /**
   * {{$m.New}} returns a builder of the declared defaults. A member without a
   * declared default has the value of a new {{$m.Subject}}.
   */
  static {{$m.New}}{{$tp}}(): {{$b.Name}}{{$ta}} {
    const v = new {{$s}}();
{{memberbody $start}}    return new {{$b.Name}}{{$ta}}(v);
  }
{{- else}}

  /** {{$m.New}} returns a builder of a new {{$m.Subject}}. */
  static {{$m.New}}{{$tp}}(): {{$b.Name}}{{$ta}} {
    return new {{$b.Name}}{{$ta}}(new {{$s}}());
  }
{{- end}}

  /** {{$m.From}} returns a builder of a copy of value. */
  static {{$m.From}}{{$tp}}(value: {{$v}}): {{$b.Name}}{{$ta}} {
    return new {{$b.Name}}{{$ta}}(Object.assign(new {{$s}}(), value));
  }
{{- range $m.Members}}
{{- $f := .Field}}
{{- $n := .Names}}
{{- if eq .Form "list"}}

  /**
   * {{$n.With}} replaces the elements of {{$f}} with values. A call without
   * arguments empties {{$f}}.
   */
  {{$n.With}}(...values: {{spell .Elem}}[]): this {
    this.v.{{$f}} = values;
    return this;
  }

  /** {{$n.Append}} appends values to the elements of {{$f}}. */
  {{$n.Append}}(...values: {{spell .Elem}}[]): this {
    this.v.{{$f}} = [...this.v.{{$f}}, ...values];
    return this;
  }
{{- else if eq .Form "bytes"}}

  /**
   * {{$n.With}} replaces {{$f}} with value. The builder keeps value without a
   * copy.
   */
  {{$n.With}}(value: {{spell .Type}}): this {
    this.v.{{$f}} = value;
    return this;
  }
{{- else if eq .Form "set"}}

  /**
   * {{$n.With}} replaces {{$f}} with value. The builder keeps value without a
   * copy.
   */
  {{$n.With}}(value: {{spell .Type}}): this {
    this.v.{{$f}} = value;
    return this;
  }

  /** {{$n.Entry}} adds key to {{$f}}. */
  {{$n.Entry}}(key: {{spell .Elem}}): this {
    this.v.{{$f}} = new Set([...this.v.{{$f}}, key]);
    return this;
  }

  /** {{$n.Entries}} adds each key of keys to {{$f}}. */
  {{$n.Entries}}(...keys: {{spell .Elem}}[]): this {
    this.v.{{$f}} = new Set([...this.v.{{$f}}, ...keys]);
    return this;
  }
{{- else if eq .Form "map"}}

  /**
   * {{$n.With}} replaces {{$f}} with value. The builder keeps value without a
   * copy.
   */
  {{$n.With}}(value: {{spell .Type}}): this {
    this.v.{{$f}} = value;
    return this;
  }

  /** {{$n.Entry}} sets the entry of key in {{$f}} to value. */
  {{$n.Entry}}(key: {{spell .Key}}, value: {{spell .Value}}): this {
    this.v.{{$f}} = {{if mapclass .Type}}new Map([...this.v.{{$f}}, [key, value]]){{else}}{ ...this.v.{{$f}}, [key]: value }{{end}};
    return this;
  }

  /**
   * {{$n.Entries}} copies each entry of entries into {{$f}}. A key of entries
   * replaces the value of that key in {{$f}}.
   */
  {{$n.Entries}}(entries: {{spell .Type}}): this {
    this.v.{{$f}} = {{if mapclass .Type}}new Map([...this.v.{{$f}}, ...entries]){{else}}{ ...this.v.{{$f}}, ...entries }{{end}};
    return this;
  }
{{- else if eq .Form "optional"}}

  /** {{$n.With}} replaces {{$f}} with value. mutate can set {{$f}} to undefined. */
  {{$n.With}}(value: {{spell .Elem}}): this {
    this.v.{{$f}} = value;
    return this;
  }
{{- else}}

  /** {{$n.With}} replaces {{$f}} with value. */
  {{$n.With}}(value: {{if .Type}}{{spell .Type}}{{else}}{{$v}}["{{$f}}"]{{end}}): this {
    this.v.{{$f}} = value;
    return this;
  }
{{- end}}
{{- end}}

  /**
   * mutate applies fn to the value under construction. It changes what no
   * setter changes, such as several members in one step.
   */
  mutate(fn: (value: {{$v}}) => void): this {
    fn(this.v);
    return this;
  }

  /**
   * clone returns a builder of a copy of the value under construction. The
   * copy has its own arrays, maps, sets and byte arrays, so a change of one
   * builder leaves the other unchanged. The two builders share the elements of
   * those members and every other member that refers to an object.
   */
  clone(): {{$b.Name}}{{$ta}} {
    const out = new {{$b.Name}}{{$ta}}(Object.assign(new {{$s}}(), this.v));
{{- range $m.Members}}
{{- if .Copied}}
{{- if eq .Form "list"}}
    out.v.{{.Field}} = [...out.v.{{.Field}}];
{{- else if eq .Form "map"}}
    out.v.{{.Field}} = {{if mapclass .Type}}new Map(out.v.{{.Field}}){{else}}{ ...out.v.{{.Field}} }{{end}};
{{- else if eq .Form "set"}}
    out.v.{{.Field}} = new Set(out.v.{{.Field}});
{{- else}}
    out.v.{{.Field}} = out.v.{{.Field}}.slice();
{{- end}}
{{- end}}
{{- end}}
    return out;
  }

  /**
   * build returns a shallow copy of the value under construction. The builder
   * remains usable, and a later call returns the value with the changes since.
   * The copy shares its arrays, maps and sets with the builder, and clone
   * returns a builder that shares none of them.
   */
  build(): {{$v}} {
    return Object.assign(new {{$s}}(), this.v);
  }
}
{{- end}}
