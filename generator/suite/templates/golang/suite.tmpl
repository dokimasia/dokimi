{{docs (wrapdocs (printf `%s calls %s on subject with the arguments args, and returns the values of the call beside its error.` (suiteCamel .Call) .Name))}}
{{- ""}}func {{suiteCamel .Call}}(ctx {{$context}}.Context, subject {{with .Receiver}}{{spell .}}{{else}}{{$.Subject}}{{end}}, args []any) ([]any, error) {
{{- with .Builder}}
	{{$first := true}}{{range $st.Params}}{{if ge .Arg 0}}{{if not $first}}, {{end}}{{$first = false}}{{.Local}}{{end}}{{end}} := {{spell .Func}}({{if .Subject}}subject{{end}})
{{- else}}
{{- range .Params}}{{if ge .Arg 0}}
	{{.Local}}, _ := args[{{.Arg}}].({{if or .Variadic .Receive}}[]{{else if .Address}}*{{end}}{{spell .Type}})
{{- end}}{{end}}
