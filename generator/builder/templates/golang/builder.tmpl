{{- range .Records}}
{{- $m := .Data}}
{{- if and (ne .Decl.Name $m.New) (ne .Decl.Name $m.From)}}
{{- $b := .Decl}}
{{- $start := index $b.Types.Items 0}}
{{- $tp := typeparams $b.TypeParams}}
{{- $ta := typeargs $b.TypeParams}}
{{- $v := spell $m.Value}}

{{docs (wrapdocs (printf `%s constructs [%s] values. [%s] and [%s] return a new builder. Each
setter sets one member and returns the builder, so the calls chain. [%s.Build]
returns the value. A builder is not safe for concurrent use.` $b.Name $m.Subject $m.New $m.From $b.Name))}}
{{- ""}}type {{$b.Name}}{{$tp}} struct {
	v {{$v}}
}
{{- if eq $m.Seed "companion"}}

{{docs (wrapdocs (printf `%s returns a builder of the value that the companion function returns.
The declared default of each member applies over that value.` $m.New))}}
{{- ""}}func {{$m.New}}{{$tp}}() *{{$b.Name}}{{$ta}} {
{{body $start}}	return &{{$b.Name}}{{$ta}}{v: v}
}
{{- else if eq $m.Seed "defaults"}}

{{docs (wrapdocs (printf `%s returns a builder of the declared defaults. A member without a
declared default has its zero value.` $m.New))}}
{{- ""}}func {{$m.New}}{{$tp}}() *{{$b.Name}}{{$ta}} {
	var v {{$v}}
{{body $start}}	return &{{$b.Name}}{{$ta}}{v: v}
}
{{- else}}

{{docs (wrapdocs (printf `%s returns a builder of the zero value.` $m.New))}}
{{- ""}}func {{$m.New}}{{$tp}}() *{{$b.Name}}{{$ta}} {
	return &{{$b.Name}}{{$ta}}{}
}
{{- end}}

{{docs (wrapdocs (printf `%s returns a builder of v.` $m.From))}}
{{- ""}}func {{$m.From}}{{$tp}}(v {{$v}}) *{{$b.Name}}{{$ta}} {
	return &{{$b.Name}}{{$ta}}{v: v}
}
{{- range $m.Members}}
{{- $f := .Field}}
{{- $n := .Names}}
{{- if eq .Form "list"}}

{{docs (wrapdocs (printf `%s replaces the elements of %s with v. A call without arguments
empties %s.` $n.With $f $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v ...{{spell .Elem}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = v
	return b
}

{{docs (wrapdocs (printf `%s appends v to the elements of %s.` $n.Append $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Append}}(v ...{{spell .Elem}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = append(b.v.{{$f}}, v...)
	return b
}
{{- else if eq .Form "bytes"}}

{{docs (wrapdocs (printf `%s replaces %s with v. The builder keeps v without a copy.` $n.With $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v {{spell .Type}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = v
	return b
}

{{docs (wrapdocs (printf `%s replaces %s with the bytes of s.` $n.Text $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Text}}(s string) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = {{spell .Type}}(s)
	return b
}
{{- else if eq .Form "set"}}

{{docs (wrapdocs (printf `%s replaces %s with v. The builder keeps v without a copy.` $n.With $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v {{spell .Type}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = v
	return b
}

{{docs (wrapdocs (printf `%s adds the key k to %s. It allocates the set where %s is nil.` $n.Entry $f $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Entry}}(k {{spell .Elem}}) *{{$b.Name}}{{$ta}} {
	if b.v.{{$f}} == nil {
		b.v.{{$f}} = make({{spell .Type}})
	}
	b.v.{{$f}}[k] = struct{}{}
	return b
}

{{docs (wrapdocs (printf `%s adds each key of keys to %s. It allocates the set where %s is nil.` $n.Entries $f $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Entries}}(keys ...{{spell .Elem}}) *{{$b.Name}}{{$ta}} {
	if b.v.{{$f}} == nil {
		b.v.{{$f}} = make({{spell .Type}}, len(keys))
	}
	for _, k := range keys {
		b.v.{{$f}}[k] = struct{}{}
	}
	return b
}
{{- else if eq .Form "map"}}{{use "maps"}}

{{docs (wrapdocs (printf `%s replaces %s with v. The builder keeps v without a copy.` $n.With $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v {{spell .Type}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = v
	return b
}

{{docs (wrapdocs (printf `%s sets the key k of %s to v. It allocates the map where %s is nil.` $n.Entry $f $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Entry}}({{if eq (spell .Key) (spell .Value)}}k, v {{spell .Key}}{{else}}k {{spell .Key}}, v {{spell .Value}}{{end}}) *{{$b.Name}}{{$ta}} {
	if b.v.{{$f}} == nil {
		b.v.{{$f}} = make({{spell .Type}})
	}
	b.v.{{$f}}[k] = v
	return b
}

{{docs (wrapdocs (printf `%s copies each entry of entries into %s. A key of entries replaces the
value of that key in %s. It allocates the map where %s is nil.` $n.Entries $f $f $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.Entries}}(entries {{spell .Type}}) *{{$b.Name}}{{$ta}} {
	if b.v.{{$f}} == nil {
		b.v.{{$f}} = make({{spell .Type}}, len(entries))
	}
	maps.Copy(b.v.{{$f}}, entries)
	return b
}
{{- else if eq .Form "optional"}}

{{docs (wrapdocs (printf `%s points %s at a copy of v. [%s.Mutate] can set %s to nil or to
another address.` $n.With $f $b.Name $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v {{spell .Elem}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = &v
	return b
}
{{- else}}

{{docs (wrapdocs (printf `%s replaces %s with v.` $n.With $f))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) {{$n.With}}(v {{spell .Type}}) *{{$b.Name}}{{$ta}} {
	b.v.{{$f}} = v
	return b
}
{{- end}}
{{- end}}

// Mutate applies fn to the value under construction. It changes what no
// setter changes, such as several members in one step.
func (b *{{$b.Name}}{{$ta}}) Mutate(fn func(*{{$v}})) *{{$b.Name}}{{$ta}} {
	fn(&b.v)
	return b
}

// Clone returns a builder of a copy of the value under construction. The copy
// has its own lists, maps, sets and bytes, so a change of one builder leaves
// the other unchanged. The two builders share the elements of those members
// and the value of each optional member.
func (b *{{$b.Name}}{{$ta}}) Clone() *{{$b.Name}}{{$ta}} {
	out := &{{$b.Name}}{{$ta}}{v: b.v}
{{- range $m.Members}}
{{- if .Copied}}
{{- if or (eq .Form "map") (eq .Form "set")}}{{use "maps"}}
	out.v.{{.Field}} = maps.Clone(b.v.{{.Field}})
{{- else}}{{use "slices"}}
	out.v.{{.Field}} = slices.Clone(b.v.{{.Field}})
{{- end}}
{{- end}}
{{- end}}
	return out
}

{{docs (wrapdocs (printf `Build returns the value under construction. The builder remains usable,
and a later call returns the value with the changes since. The value shares
its lists, maps, sets and bytes with the builder, and [%s.Clone] returns a
builder that shares none of them.` $b.Name))}}
{{- ""}}func (b *{{$b.Name}}{{$ta}}) Build() {{$v}} {
	return b.v
}
{{- end}}
{{- end}}
