{{- use "testing"}}
{{- range .Records}}
{{- $r := .}}
{{- $c := .Data}}
{{- $refs := .Decl.Fields.Items}}
{{- $test := suitePascal $c.Test}}
{{- if $c.Subject}}
{{- $options := or $c.Ceilings $c.Excusals}}
{{- if or $options $c.Cases}}{{use "go.dokimi.dev/conform"}}{{end}}
{{- $checks := spell (index $refs 2).Type}}
{{- $factory := spell (index $refs 1).Type}}
{{- if not $c.FromHandle}}
{{- $factory = printf "func(*%s) %s { return %s() }" (spell (index $refs 4).Type) (spell (index $refs 5).Type) $factory}}
{{- end}}
{{- $option := spell (index $refs 8).Type}}
{{- $opts := ""}}
{{- with $c.Options}}{{$opts = printf "%s()..." (spell .)}}{{end}}

{{docs (wrapdocs (printf `%s applies the checks of the suite of %s to %s.` $test $c.Declaration $c.Subject))}}
{{- ""}}func {{$test}}(t *testing.T) {
	t.Parallel()
{{- if and $c.Options (or $c.Excusals $c.Cases)}}

	opts := append([]{{$option}}{
{{- template "suite.cases" $r}}
{{- template "suite.excusals" $r}}
	}, {{$opts}})
	{{spell (index $refs 0).Type}}(t, {{spell (index $refs 1).Type}}, opts...)
{{- else if $c.Options}}

	{{spell (index $refs 0).Type}}(t, {{spell (index $refs 1).Type}}, {{$opts}})
{{- else if or $c.Excusals $c.Cases}}

	{{spell (index $refs 0).Type}}(
		t,
		{{spell (index $refs 1).Type}},
{{- template "suite.cases" $r}}
{{- template "suite.excusals" $r}}
	)
{{- else}}

	{{spell (index $refs 0).Type}}(t, {{spell (index $refs 1).Type}})
{{- end}}
}
{{- with $c.Allocs}}
{{- $allocs := suitePascal .}}

{{docs (wrapdocs (printf `%s applies the allocation ceilings and the checks that count allocations of the suite of %s to %s.` $allocs $c.Declaration $c.Subject))}}
{{- ""}}func {{$allocs}}(t *testing.T) {
{{- if and $c.Options (or $options $c.Cases)}}
	opts := append([]{{$option}}{
{{- template "suite.cases" $r}}
{{- template "suite.ceilings" $r}}
{{- template "suite.excusals" $r}}
	}, {{$opts}})
	{{spell (index $refs 6).Type}}(t, {{$factory}}, opts...)
{{- else if $c.Options}}
	{{spell (index $refs 6).Type}}(t, {{$factory}}, {{$opts}})
{{- else if or $options $c.Cases}}
	{{spell (index $refs 6).Type}}(
		t,
		{{$factory}},
{{- template "suite.cases" $r}}
{{- template "suite.ceilings" $r}}
{{- template "suite.excusals" $r}}
	)
{{- else}}
	{{spell (index $refs 6).Type}}(t, {{$factory}})
{{- end}}
}
{{- end}}
{{- if $c.Levels}}
{{- $benchmark := suitePascal $c.Benchmark}}

{{docs (wrapdocs (printf `%s measures each callable of the suite of %s on %s.` $benchmark $c.Declaration $c.Subject))}}
{{- ""}}func {{$benchmark}}(b *testing.B) {
{{- template "suite.options" $r}}
{{- range $c.Levels}}
	b.Run("{{.Field}}", func(b *testing.B) {
		{{spell (index $refs 7).Type}}(b, {{$checks}}.{{.Field}}.Callable, {{$factory}}{{if or $options $c.Options}}, opts...{{end}})
	})
{{- end}}
}
{{- end}}
{{- with $c.Parallel}}
{{- $parallel := suitePascal .}}

{{docs (wrapdocs (printf `%s measures each callable of the suite of %s that admits concurrent calls on %s, on GOMAXPROCS goroutines at once.` $parallel $c.Declaration $c.Subject))}}
{{- ""}}func {{$parallel}}(b *testing.B) {
{{- template "suite.options" $r}}
{{- range $c.Levels}}
{{- if .Concurrent}}
	b.Run("{{.Field}}", func(b *testing.B) {
		{{spell (index $refs 10).Type}}(b, {{$checks}}.{{.Field}}.Callable, {{$factory}}{{if or $options $c.Options}}, opts...{{end}})
	})
{{- end}}
{{- end}}
}
{{- end}}
{{- range $c.Targets}}
{{- $target := suitePascal .Name}}

{{docs (wrapdocs (printf `%s fuzzes the property checks of %s.%s on %s.` $target $c.Declaration .Field $c.Subject))}}
{{- ""}}func {{$target}}(f *testing.F) {
{{- if and $c.Options $c.Excusals}}
	opts := append([]{{$option}}{
{{- template "suite.excusals" $r}}
	}, {{$opts}})
	{{spell (index $refs 3).Type}}(f, {{$checks}}.{{.Field}}.Callable, {{$factory}}, opts...)
{{- else if $c.Options}}
	{{spell (index $refs 3).Type}}(f, {{$checks}}.{{.Field}}.Callable, {{$factory}}, {{$opts}})
{{- else if $c.Excusals}}
	{{spell (index $refs 3).Type}}(
		f,
		{{$checks}}.{{.Field}}.Callable,
		{{$factory}},
{{- template "suite.excusals" $r}}
	)
{{- else}}
	{{spell (index $refs 3).Type}}(f, {{$checks}}.{{.Field}}.Callable, {{$factory}})
{{- end}}
}
{{- end}}
{{- else}}{{use "go.dokimi.dev/conform"}}{{use "go.dokimi.dev/assert"}}
{{- $suite := index $refs 0}}
{{- $run := index $refs 1}}
{{- $fromHandle := index $refs 2}}
{{- $handle := spell (index $refs 3).Type}}
{{- $check := spell (index $refs 4).Type}}
{{- $subject := spell (index $refs 5).Type}}
{{- $value := printf "%sSubject" (suiteCamel $c.Declaration)}}
{{- if not $c.Function}}
{{- $embedded := printf "%sEmbedded" $value}}

{{docs (wrapdocs (printf `%s is %s under the name of the field that %s embeds.` $embedded $subject $value))}}
{{- ""}}type {{$embedded}} = {{$subject}}

{{docs (wrapdocs (printf `%s is a value of %s that only %s builds.` $value $c.Declaration $test))}}
{{- ""}}type {{$value}} struct{ {{$embedded}} }
{{- end}}

{{docs (wrapdocs (printf `%s checks the suite of %s and the two forms of its application.` $test $c.Declaration))}}
{{- ""}}func {{$test}}(t *testing.T) {
	t.Parallel()

	t.Run("{{suitePascal $suite.Type.Spelling}}", func(t *testing.T) {
		t.Parallel()
		conform.Falsify(t, {{spell $suite.Type}}())
	})
{{- if $c.Function}}

	t.Run("{{$c.Declaration}}", func(t *testing.T) {
		t.Parallel()
		{{spell $run.Type}}(t, {{spell (index $refs 7).Type}})
	})
{{- end}}

	t.Run("{{suitePascal $run.Type.Spelling}}", func(t *testing.T) {
		t.Parallel()
{{- if $c.Function}}
{{- $fn := spell (index $refs 7).Type}}
		{{spell $run.Type}}(
			t,
			{{$fn}},
			conform.With({{$check}}{
				ID:        "{{$c.Declaration}}/{{$c.Receives}}",
				Statement: "the subject of a check is the function of the application",
				Apply: func(h *{{$handle}}) {
					assert.Equal(h, h.Subject(), {{$subject}}({{$fn}}), h.Statement())
				},
				Defect: func(*{{$handle}}) {{$subject}} { return nil },
			}),
{{- template "suite.alone" .}}
		)
{{- else}}
		var built *{{$value}}
		{{spell $run.Type}}(
			t,
			func() *{{$value}} {
				built = &{{$value}}{}
				return built
			},
{{- template "suite.built" .}}
		)
{{- end}}
	})

	t.Run("{{suitePascal $fromHandle.Type.Spelling}}", func(t *testing.T) {
		t.Parallel()
{{- if $c.Function}}
{{- $fn := spell (index $refs 7).Type}}
		{{spell $fromHandle.Type}}(
			t,
			func(*{{$handle}}) {{$subject}} {
				return {{$fn}}
			},
			conform.With({{$check}}{
				ID:        "{{$c.Declaration}}/{{$c.Builds}}",
				Statement: "the subject of a check is the function that the factory returns",
				Apply: func(h *{{$handle}}) {
					assert.Equal(h, h.Subject(), {{$subject}}({{$fn}}), h.Statement())
				},
				Defect: func(*{{$handle}}) {{$subject}} { return nil },
			}),
{{- template "suite.alone" .}}
		)
{{- else}}
		var built *{{$value}}
		{{spell $fromHandle.Type}}(
			t,
			func(*{{$handle}}) *{{$value}} {
				built = &{{$value}}{}
				return built
			},
{{- template "suite.built" .}}
		)
{{- end}}
	})
{{- with $c.Identities}}
{{- $checks := index $refs 6}}

	t.Run("{{suitePascal $checks.Type.Spelling}}", func(t *testing.T) {
		t.Parallel()
{{- range .}}
		assert.Equal(
			t,
			string({{spell $checks.Type}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}()),
			{{printf "%q" .ID}},
			"the identity of the check joins the callable and the segment of the check",
		)
{{- end}}
	})
{{- end}}
}
{{- with $c.SuiteAllocs}}
{{- $allocs := suitePascal .}}

{{docs (wrapdocs (printf `%s falsifies the allocation ceilings and the checks that count allocations of the suite of %s.` $allocs $c.Declaration))}}
{{- ""}}func {{$allocs}}(t *testing.T) {
	t.Run("{{suitePascal $suite.Type.Spelling}}", func(t *testing.T) {
		conform.FalsifyAllocs(t, {{spell $suite.Type}}())
	})
}
{{- end}}
{{- if and (not $c.Function) $c.Levels}}
{{- template "suite.idle" $r}}
{{- end}}
{{- if $c.Function}}
{{- $fn := spell (index $refs 7).Type}}
{{- with $c.Allocs}}
{{- $allocs := suitePascal .}}

{{docs (wrapdocs (printf `%s applies the allocation ceiling and the checks that count allocations of %s to %s.` $allocs $c.Declaration $c.Declaration))}}
{{- ""}}func {{$allocs}}(t *testing.T) {
	{{spell (index $refs 9).Type}}(t, {{$fn}})
}
{{- end}}
{{- with $c.Benchmark}}
{{- $benchmark := suitePascal .}}

{{docs (wrapdocs (printf `%s measures %s.` $benchmark $c.Declaration))}}
{{- ""}}func {{$benchmark}}(b *testing.B) {
	{{spell (index $refs 10).Type}}(b, {{$fn}})
}
{{- end}}
{{- with $c.Parallel}}
{{- $parallel := suitePascal .}}

{{docs (wrapdocs (printf `%s measures %s on GOMAXPROCS goroutines at once.` $parallel $c.Declaration))}}
{{- ""}}func {{$parallel}}(b *testing.B) {
	{{spell (index $refs 11).Type}}(b, {{$fn}})
}
{{- end}}
{{- range $c.Targets}}
{{- $target := suitePascal .Name}}

{{docs (wrapdocs (printf `%s fuzzes the property checks of %s.` $target $c.Declaration))}}
{{- ""}}func {{$target}}(f *testing.F) {
	{{spell (index $refs 8).Type}}(f, {{spell (index $refs 7).Type}})
}
{{- end}}
{{- end}}
{{- end}}
{{- end}}

{{- /*
suite.cases writes the number of valid cases of each property run that a
subject states as an option of a call, and nothing for a subject that states
none.
*/}}
{{- define "suite.cases"}}
{{- with .Data.Cases}}
		conform.Cases[{{spell (index $.Decl.Fields.Items 9).Type}}]({{.}}),
{{- end}}
{{- end}}

{{- /*
suite.options declares the options of the benchmarks of a subject as opts:
each budget and each excusal of the subject, then the list of the function of
its options, which every level of the benchmark passes to its call. It
declares nothing for a subject without budgets, excusals and options.
*/}}
{{- define "suite.options"}}
{{- $option := spell (index .Decl.Fields.Items 8).Type}}
{{- if and .Data.Options (or .Data.Ceilings .Data.Excusals)}}
	opts := append([]{{$option}}{
{{- template "suite.ceilings" .}}
{{- template "suite.excusals" .}}
	}, {{spell .Data.Options}}()...)
{{- else if .Data.Options}}
	opts := {{spell .Data.Options}}()
{{- else if or .Data.Ceilings .Data.Excusals}}
	opts := []{{$option}}{
{{- template "suite.ceilings" .}}
{{- template "suite.excusals" .}}
	}
{{- end}}
{{- end}}

{{- /*
suite.excusals writes each excusal of the conformance test of a subject as an
option of a call, with the names of the callables that the record of the test
refers to.
*/}}
{{- define "suite.excusals"}}
{{- $checks := spell (index .Decl.Fields.Items 2).Type}}
{{- range .Data.Excusals}}
		conform.Excuse(
			{{$checks}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}(),
			{{printf "%q" .Reason}},
		),
{{- end}}
{{- end}}

{{- /*
suite.ceilings writes each budget of the conformance test of a subject as an
option of a call, with the names of the callables that the record of the test
refers to.
*/}}
{{- define "suite.ceilings"}}
{{- $checks := spell (index .Decl.Fields.Items 2).Type}}
{{- range .Data.Ceilings}}
		conform.Ceilings(
			{{$checks}}.{{.Field}}.Callable,
			{{template "suite.budget" .Budget}},
		),
{{- end}}
{{- end}}

{{- /*
suite.budget writes a budget as a literal of conform.Budget, with a field on
a line of its own for each ceiling and for the warm-up that the budget
states.
*/}}
{{- define "suite.budget"}}conform.Budget{
{{- with .Allocs}}
	Allocs: new(uint64({{.}})),
{{- end}}
{{- with .Bytes}}
	Bytes: new(uint64({{.}})),
{{- end}}
{{- with .Latency}}{{use "time"}}
	Latency: {{suiteDuration .}},
{{- end}}
{{- with .Mean}}{{use "time"}}
	Mean: {{suiteDuration .}},
{{- end}}
{{- with .Warmup}}
	Warmup: new({{.}}),
{{- end}}
}
{{- end}}

{{- /*
suite.built writes the check that the test of the suite of an interface or a
struct adds to a form of the application, and the excusals of the test. The
check compares the subject of a check with the value that the factory of the
test built last, by identity.
*/}}
{{- define "suite.built"}}
{{- $c := .Data}}
{{- $refs := .Decl.Fields.Items}}
{{- $handle := spell (index $refs 3).Type}}
{{- $subject := spell (index $refs 5).Type}}
{{- $value := printf "%sSubject" (suiteCamel $c.Declaration)}}
			conform.With({{spell (index $refs 4).Type}}{
				ID:        "{{$c.Declaration}}/{{$c.Builds}}",
				Statement: "the subject of a check is the value that the factory builds",
				Apply: func(h *{{$handle}}) {
					got := h.Subject()
					assert.Equal(h, got, {{$subject}}(built), h.Statement(), assert.ByIdentity())
				},
				Defect: func(*{{$handle}}) {{$subject}} { return &{{$value}}{} },
			}),
{{- template "suite.alone" .}}
{{- end}}

{{- /*
suite.idle writes the tests of the suite of an interface or a struct that run
its applications on its planted defect with a spend of nothing, a subject that
answers each call at once: the test of the allocation ceilings, a fuzz target
of each callable and the benchmarks. The test of the allocation ceilings adds
a ceiling of 0 to each level that Ceiled marks, which the planted defect
falsifies first. It excuses every check of the suite, because a check that
counts allocations runs with the ceilings.
*/}}
{{- define "suite.idle"}}
{{- $c := .Data}}
{{- $refs := .Decl.Fields.Items}}
{{- $suite := spell (index $refs 0).Type}}
{{- $handle := spell (index $refs 3).Type}}
{{- $subject := spell (index $refs 5).Type}}
{{- $checks := spell (index $refs 6).Type}}
{{- $idle := printf "%sIdle" (suiteCamel $c.Declaration)}}
{{- $zero := "the planted defect of a ceiling answers each call with its zero results"}}

{{docs (wrapdocs (printf `%s returns the planted defect of a ceiling of %s with a spend of nothing, a subject that answers each call at once.` $idle $c.Declaration))}}
{{- ""}}func {{$idle}}(h *{{$handle}}) {{$subject}} {
	return {{$suite}}().Calls[0].Over(h, func() {})
}
{{- $budgets := suitePascal $c.Budgets}}

{{docs (wrapdocs (printf `%s applies the allocation ceilings of the suite of %s to %s with every check of the suite excused, and a ceiling of 0 to each callable without a budget whose calls build no input of their own.` $budgets $c.Declaration $idle))}}
{{- ""}}func {{$budgets}}(t *testing.T) {
	{{spell (index $refs 8).Type}}(
		t,
		{{$idle}},
{{- range $c.Levels}}
{{- if .Ceiled}}
		conform.Ceilings({{$checks}}.{{.Field}}.Callable, conform.Budget{Allocs: new(uint64(0))}),
{{- end}}
{{- end}}
{{- range $c.Excusals}}
		conform.Excuse(
			{{$checks}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}(),
			{{printf "%q" $zero}},
		),
{{- end}}
	)
}
{{- range $c.Targets}}
{{- $target := suitePascal .Name}}

{{docs (wrapdocs (printf `%s registers the fuzz target of %s.%s on %s, with every check of the suite excused.` $target $c.Declaration .Field $idle))}}
{{- ""}}func {{$target}}(f *testing.F) {
	{{spell (index $refs 7).Type}}(
		f,
		{{$checks}}.{{.Field}}.Callable,
		{{$idle}},
{{- range $c.Excusals}}
		conform.Excuse(
			{{$checks}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}(),
			{{printf "%q" $zero}},
		),
{{- end}}
	)
}
{{- end}}
{{- $benchmark := suitePascal $c.Benchmark}}

{{docs (wrapdocs (printf `%s measures each callable of the suite of %s on %s.` $benchmark $c.Declaration $idle))}}
{{- ""}}func {{$benchmark}}(b *testing.B) {
{{- range $c.Levels}}
	b.Run("{{.Field}}", func(b *testing.B) {
		{{spell (index $refs 9).Type}}(b, {{$checks}}.{{.Field}}.Callable, {{$idle}})
	})
{{- end}}
}
{{- with $c.Parallel}}
{{- $parallel := suitePascal .}}

{{docs (wrapdocs (printf `%s measures each callable of the suite of %s that admits concurrent calls on %s, on GOMAXPROCS goroutines at once.` $parallel $c.Declaration $idle))}}
{{- ""}}func {{$parallel}}(b *testing.B) {
{{- range $c.Levels}}
{{- if .Concurrent}}
	b.Run("{{.Field}}", func(b *testing.B) {
		{{spell (index $refs 10).Type}}(b, {{$checks}}.{{.Field}}.Callable, {{$idle}})
	})
{{- end}}
{{- end}}
}
{{- end}}
{{- end}}

{{- /*
suite.alone writes the excusal of each check of the suite, because the test of
the suite applies its own check alone.
*/}}
{{- define "suite.alone"}}
{{- $checks := spell (index .Decl.Fields.Items 6).Type}}
{{- range .Data.Excusals}}
			conform.Excuse(
				{{$checks}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}(),
				{{printf "%q" .Reason}},
			),
{{- end}}
{{- end}}
