{{docs (wrapdocs (printf `%s opens the planted defect of %s. The defect wraps a subject that the application opens over the medium m.` (suiteCamel $d.Door) $d.Doc))}}
{{- ""}}func {{suiteCamel $d.Door}}(h *{{.Handle}}, m {{import "go.dokimi.dev/medium"}}.FS) {{.Subject}} {
	return &{{$type}}{ {{- .Embedded}}: h.FreshOpen(m)}
}
{{- else}}

{{docs (wrapdocs (printf `%s returns the planted defect of %s over a fresh subject.` $new $d.Doc))}}
{{- ""}}func {{$new}}(h *{{.Handle}}) {{.Subject}} {
	return &{{$type}}{ {{- .Embedded}}: h.Fresh(){{if $d.Keeps}}, h: h{{end}}{{if $d.Acquire}}, leak: h.Injector().Dependency(){{end}}{{if eq $d.Body "slow"}}, clock: h.Clock(){{end}}{{if $d.Txn}}{{if eq $d.Body "keep-open"}}, open: map[any][2]any{}{{else}}, staged: map[any][][2]any{}{{end}}{{end -}} }
}
{{- end}}
{{- else}}

{{docs (wrapdocs (printf `%s returns the planted defect of %s over the fresh function.` $new $d.Doc))}}
{{- ""}}func {{$new}}(h *{{.Handle}}) {{.Subject}} {
{{- if $d.Delegates}}
	fresh := h.Fresh()
{{- end}}
{{- if $d.Counts}}
	calls := 0
{{- end}}
{{- if $d.Acquire}}
	leak := h.Injector().Dependency()
{{- end}}
{{- if eq $d.Body "slow"}}
	clock := h.Clock()
{{- end}}
{{- if or (eq $d.Body "keep-first") (eq $d.Body "first-after")}}
	var first *{{spell (index $d.Method.Returns.Items 0).Type}}
{{- end}}
{{- if eq $d.Body "shared-result"}}
	var last {{import "sync/atomic"}}.Value
{{- end}}
{{- if eq $d.Body "check-then-grant"}}
	var marked {{import "sync/atomic"}}.Int32
{{- end}}
	return func({{params $d.Method.Params}}){{results $d.Method.Returns}} {
{{- template "suite.defect.body" (suiteBody $d "fresh" "" "fresh")}}
	}
}
{{- end}}
{{- end}}

{{- /*
suite.defect.opened writes the function of a planted defect of a durable
claim, which opens the defect through its door Open over a new medium in
memory.
*/}}
{{- define "suite.defect.opened"}}

{{docs (wrapdocs (printf `%s returns the planted defect of %s. The door of its check opens the defect over a new medium in memory.` (suiteCamel .Defect.Name) .Defect.Doc))}}
{{- ""}}func {{suiteCamel .Defect.Name}}(h *{{.Handle}}) {{.Subject}} {
	return h.Open({{import "go.dokimi.dev/medium"}}.NewMemory())
}
{{- end}}

{{- /*
suite.defect.unhosted writes the function of a planted defect of a claim of a
world, which returns the subject of the application outside a world. The door
Host of its check opens the defect in a world.
*/}}
{{- define "suite.defect.unhosted"}}

{{docs (wrapdocs (printf `%s returns the subject of the application in place of the planted defect of %s. The door Host of its check opens the defect in a world.` (suiteCamel .Defect.Name) .Defect.Doc))}}
{{- ""}}func {{suiteCamel .Defect.Name}}(h *{{.Handle}}) {{.Subject}} {
	return h.Fresh()
}
{{- end}}

{{- /*
suite.defect.body writes the body of the override of a planted defect. Call
is the call of the callable of the fresh subject, and State the prefix of the
counter, the clock, the handle, the dependency and the first result of the
defect. A body that keeps the handle reads the injector of the handle, or
builds a fresh subject of the handle for each call.
*/}}
{{- define "suite.defect.body"}}
{{- $d := .Defect}}
{{- $call := printf "%s(%s)" .Call (suiteJoin $d.Args)}}
{{- $all := suiteNames $d.Results}}
{{- if $d.Guards}}
	if err := {{$d.Context}}.Err(); err != nil {
{{- range $d.Results}}{{if eq .Role "error"}}
		{{.Name}} = err
{{- end}}{{end}}
		return
	}
{{- end}}
{{- if eq $d.Body "panic"}}
	panic({{printf "%q" (printf "the planted defect of %s" $d.Doc)}})
{{- else if eq $d.Body "panic-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		panic({{printf "%q" (printf "the planted defect of %s" $d.Doc)}})
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "zero"}}
	return
{{- else if eq $d.Body "zero-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "fail"}}
{{- template "suite.defect.fail" $d}}
	return
{{- else if eq $d.Body "fail-success"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{$err}} == nil {
{{- range $d.Method.Returns.Items}}{{if ne .Name $err}}
		{{.Name}} = *new({{spell .Type}})
{{- end}}{{end}}
{{- template "suite.defect.fail" $d}}
	}
	return
{{- else if eq $d.Body "fail-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
{{- template "suite.defect.fail" $d}}
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "beside-error"}}
	{{$all}} = {{$call}}
	if {{range $d.Results}}{{if eq .Role "error"}}{{.Name}}{{end}}{{end}} != nil {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "sample-success"}}
{{- $ok := "true"}}
{{- range $d.Results}}{{if eq .Role "flag"}}{{$ok = .Name}}{{end}}{{end}}
{{- range $d.Results}}{{if eq .Role "error"}}{{$ok = printf "%s == nil" .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{$ok}} {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "uncancelled"}}
	if {{$d.Context}}.Err() != nil {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "beside-false"}}
	{{$all}} = {{$call}}
	if !{{range $d.Results}}{{if eq .Role "flag"}}{{.Name}}{{end}}{{end}} {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "sample"}}
{{- template "suite.defect.samples" $d}}
	return
{{- else if eq $d.Body "drift"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "descend"}}
	{{.State}}calls++
	if {{.State}}calls == 1 {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "version-descend"}}
	{{.State}}calls++
{{- template "suite.defect.samples" $d}}
	if {{.State}}calls == 1 {
		r0.{{$d.Version}} = 1
	} else {
		r0.{{$d.Version}} = 0
	}
	return
{{- else if eq $d.Body "version-zero"}}
	{{$all}} = {{$call}}
	r0.{{$d.Version}} = 0
	return
{{- else if eq $d.Body "echo"}}
	r0 = p{{$d.Input}}
	return
{{- else if eq $d.Body "drain-twice"}}
	{{$all}} = {{$call}}
	if len(r0) > 0 {
		r0 = append(r0[:1:1], r0...)
	}
	return
{{- else if eq $d.Body "reorder"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		{{import "slices"}}.Reverse(r0)
	}
	return
{{- else if eq $d.Body "reverse"}}
	{{$all}} = {{$call}}
	{{import "slices"}}.Reverse(r0)
	return
{{- else if eq $d.Body "slow"}}
	{{.State}}clock.Sleep({{suiteDuration $d.Budget (import "time")}})
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "lead"}}
	r0 = true
	return
{{- else if eq $d.Body "first-page"}}
	p{{$d.Input}} = *new({{spell (index $d.Method.Params.Items $d.Input).Type}})
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "live-handle"}}
	{{$all}} = {{$call}}
	r0 = {{suiteCamel $d.Handle.Type}}{r0}
	return
{{- else if eq $d.Body "zero-before-failure"}}
	if {{.State}}h.Injector().Failures() == 0 {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "swallow"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	before := {{.State}}h.Injector().Failures()
	{{$all}} = {{$call}}
	if {{$err}} != nil && {{.State}}h.Injector().Failures() > before {
{{- range $d.Method.Returns.Items}}{{if ne .Name $err}}
		{{.Name}} = *new({{spell .Type}})
{{- end}}{{end}}
		{{$err}} = nil
	}
	return
{{- else if eq $d.Body "fail-after-failure"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{.State}}h.Injector().Failures() > 0 {
{{- range $d.Method.Returns.Items}}{{if ne .Name $err}}
		{{.Name}} = *new({{spell .Type}})
{{- end}}{{end}}
{{- template "suite.defect.fail" $d}}
	}
	return
{{- else if or (eq $d.Body "sample-after-failure") (eq $d.Body "half-applied-after")}}
	failed := {{.State}}h.Injector().Failures() > 0
	{{$all}} = {{$call}}
{{- if $d.Counts}}
	{{.State}}calls++
{{- end}}
	if failed{{if $d.Counts}} && {{.State}}calls > {{$d.After}}{{end}} {
{{- template "suite.defect.samples" $d}}
{{- range $d.Results}}
{{- if eq .Role "error"}}
		{{.Name}} = nil
{{- else if eq .Role "flag"}}
		{{.Name}} = true
{{- end}}
{{- end}}
	}
	return
{{- else if eq $d.Body "fresh-each-call"}}
	{{if $d.Results}}return {{end}}{{.State}}h.Fresh(){{if $d.Type}}.{{$d.Method.Name}}{{end}}({{suiteJoin $d.Args}})
{{- else if eq $d.Body "open-on-failure"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{$err}} != nil {
		_ = {{.State}}leak.Call({{printf "%q" $d.Acquire}})
	}
	return
{{- else if eq $d.Body "zero-second"}}
	{{if $d.Results}}return {{end}}{{.Call}}({{range $i, $a := $d.Args}}{{if $i}}, {{end}}{{if eq $i $d.Second}}*new({{spell (index $d.Method.Params.Items $i).Type}}){{else}}{{$a}}{{end}}{{end}})
{{- else if eq $d.Body "keep-first"}}
	if {{.State}}first != nil && {{import "reflect"}}.DeepEqual(p{{$d.Input}}, *{{.State}}first) {
		r0 = p{{$d.Input}}
		return
	}
	{{$all}} = {{$call}}
	if {{.State}}first == nil {
		{{.State}}first = &r0
	}
	return
{{- else if eq $d.Body "drop-last"}}
	{{$all}} = {{$call}}
	if len(r0) > 0 {
		r0 = r0[:len(r0)-1]
	}
	return
{{- else if eq $d.Body "first-after"}}
	{{.State}}calls++
	{{$all}} = {{$call}}
	if {{.State}}first == nil {
		{{.State}}first = &r0
	}
	if {{.State}}calls > {{$d.After}} {
		r0 = *{{.State}}first
{{- range $d.Results}}{{if eq .Role "error"}}
		{{.Name}} = nil
{{- end}}{{end}}
	}
	return
{{- else if eq $d.Body "reverse-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
		{{import "slices"}}.Reverse(r0)
	}
	return
{{- else if eq $d.Body "version-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
		r0.{{$d.Version}} = 0
	}
	return
{{- else if eq $d.Body "zero-after"}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "repeat-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} && len(r0) > 0 {
		r0 = append(r0[:1:1], r0...)
	}
	return
{{- else if eq $d.Body "drop-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} && len(r0) > 0 {
		r0 = r0[:len(r0)-1]
	}
	return
{{- else if eq $d.Body "diverge-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "twice-after"}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
		{{if $d.Results}}{{$all}} = {{end}}{{$call}}
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "grow-after"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > {{$d.After}} {
{{- if eq $d.Grow "int"}}
		r0 = {{$d.Limit}} + 1
{{- else if eq $d.Grow "text"}}
		r0 = {{spell (index $d.Method.Returns.Items 0).Type}}({{import "strings"}}.Repeat("x", {{$d.Limit}}+1))
{{- else}}
		r0 = make({{spell (index $d.Method.Returns.Items 0).Type}}, {{$d.Limit}}+1)
{{- end}}
	}
	return
{{- else if eq $d.Body "leak"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	r0 += {{spell (index $d.Method.Returns.Items 0).Type}}({{.State}}calls)
	return
{{- else if eq $d.Body "mark"}}
	{{.State}}marked.Add(1)
	defer {{.State}}marked.Add(-1)
	{{.State}}h.Yield()
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "check-then-grant"}}
	{{.State}}marked.Add(1)
	defer {{.State}}marked.Add(-1)
	{{.State}}h.Yield()
	if {{.State}}marked.Load() > 1 {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "zero-first"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	if !{{.State}}wrote {
		{{.State}}wrote = true
		{{$all}} = {{.Call}}({{range $i, $a := $d.Args}}{{if $i}}, {{end}}{{if eq $i $d.Input}}*new({{spell (index $d.Method.Params.Items $i).Type}}){{else}}{{$a}}{{end}}{{end}})
		if {{$err}} != nil {
			return
		}
	}
	return {{$call}}
{{- else if eq $d.Body "zero-beside-error"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{$err}} != nil {
{{- range $d.Method.Returns.Items}}{{if ne .Name $err}}
		{{.Name}} = *new({{spell .Type}})
{{- end}}{{end}}
	}
	return
{{- else if eq $d.Body "keep-open"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}{{$t := $d.Txn}}
	{{if $d.Results}}{{$all}} = {{end}}{{$call}}
	{{with $err}}if {{.}} == nil {{end}}{
		{{$.State}}mu.Lock()
		{{$.State}}open[{{$t.Key}}] = [2]any{ {{- $t.Handle}}, {{$t.Value -}} }
		{{$.State}}mu.Unlock()
	}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "read-open"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}{{$t := $d.Txn}}
	{{$all}} = {{$call}}
	{{.State}}mu.Lock()
	kept, found := {{.State}}open[{{$t.Key}}]
	{{.State}}mu.Unlock()
	if found && kept[0] != any({{$t.Handle}}){{with $err}} && {{.}} == nil{{end}} {
		v, _ := kept[1].({{spell $t.Txn.Value}})
{{- if $t.Txn.Appends}}
		r0 = append(r0[:len(r0):len(r0)], v)
{{- else}}
		r0 = v
{{- end}}
	}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "drop-open"}}{{$t := $d.Txn}}
	{{if $d.Results}}{{$all}} = {{end}}{{$call}}
	{{.State}}mu.Lock()
	for key, kept := range {{.State}}open {
		if kept[0] == any({{$t.Handle}}) {
			delete({{.State}}open, key)
		}
	}
	{{.State}}mu.Unlock()
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "stage"}}{{$t := $d.Txn}}
	{{.State}}mu.Lock()
	{{.State}}staged[{{$t.Handle}}] = append({{.State}}staged[{{$t.Handle}}], [2]any{ {{- $t.Key}}, {{$t.Value -}} })
	{{.State}}mu.Unlock()
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "read-staged"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}{{$t := $d.Txn}}
	{{$all}} = {{$call}}
	{{with $err}}if {{.}} == nil {{end}}{
		{{$.State}}mu.Lock()
		for _, w := range {{$.State}}staged[{{$t.Handle}}] {
			if w[0] == any({{$t.Key}}) {
				v, _ := w[1].({{spell $t.Txn.Value}})
{{- if $t.Txn.Appends}}
				r0 = append(r0[:len(r0):len(r0)], v)
{{- else}}
				r0 = v
{{- end}}
			}
		}
		{{$.State}}mu.Unlock()
	}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "apply-late"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}{{$t := $d.Txn}}{{$x := $t.Txn}}
	{{.State}}mu.Lock()
	staged := {{.State}}staged[{{$t.Handle}}]
	delete({{.State}}staged, {{$t.Handle}})
	{{.State}}mu.Unlock()
	{{if $d.Results}}{{$all}} = {{end}}{{$call}}
	if {{with $err}}{{.}} != nil || {{end}}len(staged) == 0 {
		{{.State}}h.Yield()
		return
	}
	ctx := {{with $t.Context}}{{.}}{{else}}{{import "context"}}.Background(){{end}}
	begun, err := {{template "suite.txn.call" (suiteTxnCall $x.Begin .Subject)}}
	if err != nil {
{{- with $err}}
		{{.}} = err
{{- end}}
		return
	}
{{- if or $x.Write.Handled $x.Commit.Handled $x.Rollback.Handled}}
	tx, _ := begun[0].({{spell $x.Handle}})
{{- else}}
	tx := begun[0]
{{- end}}
	for _, w := range staged {
		key, v := w[0], w[1]
		if _, err := {{template "suite.txn.call" (suiteTxnCall $x.Write .Subject)}}; err != nil {
			_, _ = {{template "suite.txn.call" (suiteTxnCall $x.Rollback .Subject)}}
{{- with $err}}
			{{.}} = err
{{- end}}
			return
		}
	}
	_, {{with $err}}{{.}}{{else}}_{{end}} = {{template "suite.txn.call" (suiteTxnCall $x.Commit .Subject)}}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "drop-staged"}}{{$t := $d.Txn}}
	{{.State}}mu.Lock()
	delete({{.State}}staged, {{$t.Handle}})
	{{.State}}mu.Unlock()
	{{if $d.Results}}{{$all}} = {{end}}{{$call}}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "wrap-handle"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}{{$t := $d.Txn}}
	{{$all}} = {{$call}}
	{{with $err}}if {{.}} == nil {{end}}{
		r0 = &{{suiteCamel $t.Wrapper.Name}}{ {{- $t.Wrapper.EmbeddedField}}: r0, d: d}
	}
	{{.State}}h.Yield()
	return
{{- else if eq $d.Body "zero-on-sentinel"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
	if {{import "errors"}}.Is({{$err}}, {{template "suite.expr" $d.Sentinel}}) {
{{- range $d.Method.Returns.Items}}{{if ne .Name $err}}
		{{.Name}} = *new({{spell .Type}})
{{- end}}{{end}}
		{{$err}} = nil
	}
	return
{{- else if eq $d.Body "shared-result"}}
	{{$all}} = {{$call}}
	{{.State}}last.Store([]any{ {{- $all -}} })
	{{.State}}h.Yield()
	kept, _ := {{.State}}last.Load().([]any)
{{- range $i, $r := $d.Results}}
	{{$r.Name}}, _ = kept[{{$i}}].({{spell (index $d.Method.Returns.Items $i).Type}})
{{- end}}
	return
{{- else if eq $d.Body "park-after-recovery"}}
	if {{.State}}lifetime != nil {
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
		{{if $err}}{{$err}} = {{else}}_ = {{end}}{{import "go.dokimi.dev/host"}}.Park({{or $d.Context (printf "%slifetime" .State)}})
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "marked-sample"}}
	if {{.State}}marked.Load() > 0 {
{{- template "suite.defect.samples" $d}}
{{- range $d.Results}}{{if eq .Role "flag"}}
		{{.Name}} = true
{{- end}}{{end}}
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "copy"}}
{{- $err := ""}}{{range $d.Results}}{{if eq .Role "error"}}{{$err = .Name}}{{end}}{{end}}
	{{$all}} = {{$call}}
{{- with $err}}
	if {{.}} != nil {
		return
	}
{{- end}}
{{- if eq (len $d.Elems) 1}}
	{{$d.Stream}} = {{import "slices"}}.Values({{import "slices"}}.Collect({{$d.Stream}}))
{{- else}}
	var firsts []{{spell (index $d.Elems 0)}}
	var seconds []{{spell (index $d.Elems 1)}}
	for first, second := range {{$d.Stream}} {
		firsts, seconds = append(firsts, first), append(seconds, second)
	}
	{{$d.Stream}} = func(yield func({{spell (index $d.Elems 0)}}, {{spell (index $d.Elems 1)}}) bool) {
		for i := range firsts {
			if !yield(firsts[i], seconds[i]) {
				return
			}
		}
	}
{{- end}}
	return
{{- end}}
{{- end}}

{{- /*
suite.defect.fail sets the error of the results of a planted defect to the
error that the runtime generates, which no directive declares.
*/}}
{{- define "suite.defect.fail"}}
{{- range .Results}}{{if eq .Role "error"}}
	{{.Name}} = {{import "go.dokimi.dev/conform"}}.ErrGenerated
{{- end}}{{end}}
{{- end}}

{{- /*
suite.defect.samples sets each value of the results of a planted defect to
its second sample.
*/}}
{{- define "suite.defect.samples"}}
{{- range .Results}}{{if eq .Role "value"}}
	{{.Name}} = {{template "suite.expr" .Sample}}
{{- end}}{{end}}
{{- end}}

{{- /*
suite.arg writes one argument of the probe of a derived check.
*/}}
{{- define "suite.arg"}}
{{- if .Closure}}{{template "suite.closure" .Closure}}
{{- else if .Expr}}{{template "suite.expr" .Expr}}
{{- else if .Projection}}func(v {{spell .Projection.Type}}) {{spell .Projection.Result}} { return v{{with .Projection.Field}}.{{.}}{{end}} }
{{- else if .Ref}}{{suiteCamel .Ref}}
{{- else if .Apply}}{{template "suite.apply" .Apply}}
{{- else if .Written}}func(args []any) {{spell .Written.Type}} {
	v, _ := args[{{.Written.Index}}].({{spell .Written.Type}})
	return v
}
{{- else if .Countable}}{{template "suite.countable" .Countable}}
{{- else if .Method}}({{spell .Method.Type}}).{{.Method.Name}}
{{- else if .Key}}func(args []any) any {
	return []any{ {{- range $i, $a := .Key.Args}}{{if $i}}, {{end}}args[{{$a}}]{{end -}} }
}
{{- else if .Budget}}{{import "go.dokimi.dev/assert/history"}}.Budget({{.Budget}})
{{- else}}{{suiteDuration .Duration (import "time")}}
{{- end}}
{{- end}}

{{- /*
suite.expr writes one expression of a derived check.
*/}}
{{- define "suite.expr"}}
{{- if .Value}}{{value .Value}}
{{- else if .Drawn}}{{if .Drawn.Address}}&{{end}}{{.Drawn.Draw.Name}}{{if or .Drawn.Draw.Funcs .Drawn.Draw.Input}}(){{else if .Drawn.Draw.Pair}}[{{if .Drawn.Second}}1{{else}}0{{end}}]{{end}}
{{- else if .Built}}{{with .Built.Name}}{{.}}{{else}}func() {{spell .Built.Type}} {
	{{.Built.Values}} := {{spell .Built.Builder.Func}}({{if .Built.Builder.Subject}}h.Subject(){{end}})
	return v
}(){{end}}
{{- else if .Of}}({{template "suite.expr" .Of}}).{{.Select}}
{{- else if .Hook}}func({{range $i, $p := slice .Hook.Elems 0 .Hook.Split}}{{if $i}}, {{end}}_ {{spell $p}}{{end}}) { {{- .Name}}() }
{{- else if .Compute}}func({{params .Compute.Params}}){{results .Compute.Returns}} {
	_ = h.Injector().Dependency().Call({{printf "%q" .Name}})
{{- if .Compute.Returns.Len}}
	return
{{- end}}
}
{{- else if .Convert}}{{spell .Convert}}({{.Name}})
{{- else if .Stream}}func(func({{range $i, $e := .Stream}}{{if $i}}, {{end}}{{spell $e}}{{end}}) bool) {}
{{- else if .Pair}}{{import "go.dokimi.dev/conform/probe"}}.Pair[{{spell (index .Pair.Types 0)}}, {{spell (index .Pair.Types 1)}}]{First: {{template "suite.expr" (index .Pair.Values 0)}}, Second: {{template "suite.expr" (index .Pair.Values 1)}}}
{{- else if .Name}}{{.Name}}
{{- else}}{{.Word}}
{{- end}}
{{- end}}

{{- /*
suite.closure writes a closure that a derived check passes to its probe. A
closure with assignments on its later calls counts its calls in a variable of
the function that returns it. A closure that drains a stream returns the error
of the call first, and the drain of a stream with an error ends on the first
error of the stream. A closure that pulls a stream returns the error of the
call first too, and its iteration of a stream with an error ends on the first
error of the stream.
*/}}
{{- define "suite.closure"}}
{{- if .Later}}func() {{template "suite.closure.signature" .}} {
	calls := 0
	return {{end}}{{template "suite.closure.signature" .}} {
{{- template "suite.closure.body" .}}
}{{if .Later}}
}(){{end}}
{{- end}}

{{- /*
suite.closure.body writes the statements of a closure, from its count of calls
to its return. A read with a presence flag returns fs.ErrNotExist beside its
value where the flag reports no value.
*/}}
{{- define "suite.closure.body"}}
{{- if .Later}}
	calls++
{{- end}}
{{- range .Builds}}
	{{suiteJoin .Names}} := {{spell .Builder.Func}}({{if .Builder.Subject}}{{with $.Receiver}}{{template "suite.expr" .}}{{else}}h.Subject(){{end}}{{end}})
{{- end}}
{{- range .Lets}}
	{{.Name}}{{if .Select}}.{{.Select}} ={{else}} :={{end}} {{template "suite.expr" .Value}}
{{- end}}
{{- with .Later}}
	if calls > 1 {
{{- range .}}
		{{.Name}}{{with .Select}}.{{.}}{{end}} = {{template "suite.expr" .Value}}
{{- end}}
	}
{{- end}}
{{- if .Stamps}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
	stamps := make([]{{spell (index .Returns 0)}}, 0, len(r0))
	for _, e := range r0 {
		stamps = append(stamps, e.{{.Stamps}})
	}
	return {{template "suite.exprs" .Results}}
{{- else if .Pull}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
{{- with (index .Results 1).Name}}
	if {{.}} != nil {
		return nil, nil, {{.}}
	}
{{- end}}
{{- $stream := (index .Results 0).Name}}
{{- if eq .Drain "elements"}}
	next, stop := {{import "iter"}}.Pull({{$stream}})
	return next, stop, nil
{{- else}}
	next, stop := {{import "iter"}}.Pull2({{$stream}})
	return func() ({{spell (index .Returns 0)}}, bool) {
		v, {{if eq .Drain "until-error"}}err{{else}}_{{end}}, ok := next()
		return v, ok{{if eq .Drain "until-error"}} && err == nil{{end}}
	}, stop, nil
{{- end}}
{{- else if .Drain}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
{{- with (index .Results 1).Name}}
	if {{.}} != nil {
		return nil, {{.}}
	}
{{- end}}
{{- $stream := (index .Results 0).Name}}
{{- if eq .Drain "elements"}}
	return {{import "slices"}}.Collect({{$stream}}), nil
{{- else}}
	var drained []{{template "suite.closure.value" .}}
{{- if eq .Drain "pairs"}}
	for k, v := range {{$stream}} {
		drained = append(drained, {{template "suite.closure.value" .}}{First: k, Second: v})
	}
{{- else}}
	for e, err := range {{$stream}} {
		if err != nil {
			return drained, err
		}
		drained = append(drained, e)
	}
{{- end}}
	return drained, nil
{{- end}}
{{- else if .Assign}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
{{- if .Absent}}
	if !ok {
		return {{template "suite.expr" (index .Results 0)}}, {{import "io/fs"}}.ErrNotExist
	}
{{- end}}
	return {{template "suite.exprs" .Results}}
{{- else if .Discard}}
	{{template "suite.invoke" .}}
	return {{template "suite.exprs" .Results}}
{{- else}}
	return {{template "suite.invoke" .}}
{{- end}}
{{- end}}

{{- /*
suite.durable writes the probe.Durable of a callable that writes and its
paired read. Each function takes the sample i, 0 or 1, and calls the subject s
with the values of that sample.
*/}}
{{- define "suite.durable"}}
{{- $d := .Durable}}{{$ctx := import "context"}}{{$value := spell $d.Value}}
{{- import "go.dokimi.dev/conform/probe"}}.Durable[{{.Subject}}, {{$value}}]{
	Write: func(ctx {{$ctx}}.Context, s {{.Subject}}, i int) error {
		if i == 0 {
{{- template "suite.closure.body" (index $d.Writes 0)}}
		}
{{- template "suite.closure.body" (index $d.Writes 1)}}
	},
	Read: func(ctx {{$ctx}}.Context, s {{.Subject}}, i int) ({{$value}}, error) {
		if i == 0 {
{{- template "suite.closure.body" (index $d.Reads 0)}}
		}
{{- template "suite.closure.body" (index $d.Reads 1)}}
	},
	Want: func(i int) {{$value}} {
		if i == 0 {
			return {{template "suite.expr" (index $d.Wants 0)}}
		}
		return {{template "suite.expr" (index $d.Wants 1)}}
	},
	Key: func(i int) any {
		if i == 0 {
			return []any{ {{- template "suite.exprs" (index $d.Keys 0) -}} }
		}
		return []any{ {{- template "suite.exprs" (index $d.Keys 1) -}} }
	},
}
{{- end}}

{{- /*
suite.closure.signature writes the signature of a closure: the context, its
parameter and its results.
*/}}
{{- define "suite.closure.signature"}}func(ctx {{import "context"}}.Context{{with .Param}}, {{.Name}}{{with .Other}}, {{.}}{{end}} {{if .Hook}}func(){{else if .Body}}{{import "go.dokimi.dev/conform/probe"}}.Act{{else}}{{spell .Type}}{{end}}{{end}}) {{template "suite.closure.returns" .}}
{{- end}}

{{- /*
suite.closure.returns writes the results of a closure. A closure that returns
the stamps of a replay or the drain of a stream returns a list of its value. A
closure that pulls a stream returns the functions next and stop of the
iteration, and a closure of a channel returns a channel that it receives from.
*/}}
{{- define "suite.closure.returns"}}
{{- if .Pull}}(func() ({{spell (index .Returns 0)}}, bool), func(), error)
{{- else if and (not .Returns) .Error}}error
{{- else}}({{if or .Stamps .Drain}}[]{{end}}{{if .Channel}}<-chan {{end}}{{template "suite.closure.value" .}}{{if .Error}}, error{{end}}{{if .Flag}}, bool{{end}})
{{- end}}
{{- end}}

{{- /*
suite.closure.value writes the type of the value of a closure: the probe.Pair
of its two types, or its one type.
*/}}
{{- define "suite.closure.value"}}
{{- if .Pair}}{{import "go.dokimi.dev/conform/probe"}}.Pair[{{spell (index .Returns 0)}}, {{spell (index .Returns 1)}}]
{{- else}}{{range $i, $r := .Returns}}{{if $i}}, {{end}}{{spell $r}}{{end}}
{{- end}}
{{- end}}

{{- /*
suite.invoke writes the call of a closure: the callable on the subject of the
handle, or on the receiver of the closure, with its arguments.
*/}}
{{- define "suite.invoke"}}
{{- with .Receiver}}{{template "suite.expr" .}}{{else}}h.Subject(){{end}}{{with .Method}}.{{.}}{{end}}({{template "suite.exprs" .Args}})
{{- end}}

{{- /*
suite.exprs writes a list of expressions, separated by commas.
*/}}
{{- define "suite.exprs"}}
{{- range $i, $e := .}}{{if $i}}, {{end}}{{template "suite.expr" $e}}{{end}}
{{- end}}

{{- /*
suite.budget writes a budget as a literal of conform.Budget, with a field on
a line of its own for each ceiling and for the warm-up that the budget
states.
*/}}
{{- define "suite.budget"}}{{import "go.dokimi.dev/conform"}}.Budget{
{{- with .Allocs}}
	Allocs: new(uint64({{.}})),
{{- end}}
{{- with .Bytes}}
	Bytes: new(uint64({{.}})),
{{- end}}
{{- with .Latency}}
	Latency: {{suiteDuration . (import "time")}},
{{- end}}
{{- with .Mean}}
	Mean: {{suiteDuration . (import "time")}},
{{- end}}
{{- with .Warmup}}
	Warmup: new({{.}}),
{{- end}}
}
{{- end}}

{{- /*
suite.call writes the call of a callable on the subject of a call generator:
the method of an interface or a struct, or the function itself, with the
context of the call and the value that the generator draws for each other
parameter.
*/}}
{{- define "suite.call"}}subject{{with .Field}}.{{.}}{{end}}({{range $i, $p := .Params}}{{if not .Omitted}}{{if $i}}, {{end}}{{if .Context}}ctx{{else if .Address}}&{{.Name}}{{else if .Receive}}{{template "suite.channel" .}}{{else}}{{.Name}}{{if .Variadic}}...{{end}}{{end}}{{end}}{{end}}){{end}}

{{- /*
suite.generated.param writes the value of a parameter of a function type or
of an interface that a call generator draws: the lists of the results of
each generated function, and the function, or the address of the
implementation with a function of each method.
*/}}
{{- define "suite.generated.param"}}
{{- range .Funcs}}{{template "suite.results" .}}{{end}}
{{- if .Input}}
	{{.Name}} := &{{suiteCamel .Input}}{
{{- range .Funcs}}
		{{suiteCamel .Field}}: {{template "suite.func" .}},
{{- end}}
	}
{{- else}}
	{{.Name}} := {{template "suite.func" (index .Funcs 0)}}
{{- end}}
{{- end}}

{{- /*
suite.draw writes one draw of a generated check: the lists of the results of
a generated function or implementation with a function that builds it anew
for each call, two distinct values of a type, or one value of a type.
*/}}
{{- define "suite.draw"}}
{{- if or .Funcs .Input}}
{{- range .Funcs}}{{template "suite.lists" .}}{{end}}
	{{.Name}} := func() {{spell .Type}} {
{{- range .Funcs}}{{template "suite.counter" .}}{{end}}
{{- if .Input}}
		return &{{suiteCamel .Input}}{
{{- range .Funcs}}
			{{suiteCamel .Field}}: {{template "suite.func" .}},
{{- end}}
		}
{{- else}}
		return {{template "suite.func" (index .Funcs 0)}}
{{- end}}
	}
{{- else if .Pair}}{{$prop := import "go.dokimi.dev/assert/prop"}}
	{{.Name}} := c.Draw({{$prop}}.List({{$prop}}.Of[{{spell .Type}}](), {{$prop}}.Unique(), {{$prop}}.MinSize(2), {{$prop}}.MaxSize(2)), {{printf "%q" .Label}})
{{- else}}
	{{.Name}} := c.Draw({{import "go.dokimi.dev/assert/prop"}}.Of[{{spell .Type}}](), {{printf "%q" .Label}})
{{- end}}
{{- end}}

{{- /*
suite.channel writes a new channel of the drawn list of a parameter that the
callable receives from, with each value of the list in its buffer, closed.
Each call takes a channel of its own, because a call drains its channel.
*/}}
{{- define "suite.channel"}}func() <-chan {{spell .Type}} {
	ch := make(chan {{spell .Type}}, len({{.Name}}))
	for _, v := range {{.Name}} {
		ch <- v
	}
	close(ch)
	return ch
}(){{end}}

{{- /*
suite.generated writes the generator of the values of a function type or of
an interface at some depth of the inputs: the generated function of a value of
the function type, or the address of the implementation of the interface with
a generated function of each method. A struct of function fields is not
comparable, and its address is.
*/}}
{{- define "suite.generated"}}
{{- $drawn := false}}
{{- $prop := import "go.dokimi.dev/assert/prop"}}
{{- range .Funcs}}{{if .Results}}{{$drawn = true}}{{end}}{{end}}{{$prop}}.Composite(func({{if $drawn}}c {{end}}*{{$prop}}.Case) {{spell .Type}} {
{{- range .Funcs}}{{template "suite.results" .}}{{end}}
{{- if .Input}}
	return &{{suiteCamel .Input}}{
{{- range .Funcs}}
		{{suiteCamel .Field}}: {{template "suite.func" .}},
{{- end}}
	}
{{- else}}
	return {{template "suite.func" (index .Funcs 0)}}
{{- end}}
}){{end}}

{{- /*
suite.basis writes the generator of the base value of a recursive function
type or interface. A base whose functions return a channel takes the end
value of each channel result when the case draws it, and any other base is
one value.
*/}}
{{- define "suite.basis"}}
{{- $ends := false}}
{{- $sinks := false}}
{{- range .Funcs}}{{range .Results}}{{if .End}}{{$ends = true}}{{end}}{{if .Sink}}{{$sinks = true}}{{end}}{{end}}{{end}}
{{- $prop := import "go.dokimi.dev/assert/prop"}}
{{- if $ends}}{{$prop}}.Composite(func({{if $sinks}}c {{end}}*{{$prop}}.Case) {{spell .Type}} {
{{- range .Funcs}}{{template "suite.ends" .}}{{end}}
	return {{template "suite.base" .}}
}){{else}}{{$prop}}.Just[{{spell .Type}}]({{template "suite.base" .}}){{end}}
{{- end}}

{{- /*
suite.base writes the base value of a recursive function type or interface:
the function, or the address of the implementation with a function of each
method, that returns its end values at once.
*/}}
{{- define "suite.base"}}
{{- if .Input}}&{{suiteCamel .Input}}{
{{- range .Funcs}}
	{{suiteCamel .Field}}: {{template "suite.end" .}},
{{- end}}
}{{else}}{{template "suite.end" (index .Funcs 0)}}{{end}}{{end}}

{{- /*
suite.end writes a function that returns its end values at once: the end
error of each error result, which is the first declared error of its method
or conform.ErrGenerated, the end value of each channel result, and the zero
value of any other result.
*/}}
{{- define "suite.end"}}func({{params .Signature.Params}}){{results .Signature.Returns}} {
{{- range .Results}}
{{- if .Error}}
	{{.Return}} = {{with .Errors}}{{value (index . 0)}}{{else}}{{import "go.dokimi.dev/conform"}}.ErrGenerated{{end}}
{{- else if .End}}
	{{.Return}} = {{.End}}
{{- end}}
{{- end}}
{{- if .Signature.Returns.Len}}
	return
{{- end}}
}{{end}}

{{- /*
suite.results writes the draw of the list of each result of a generated
function, the end value of each channel result, and the counter of its
calls. Each list after the first has the length of the first, so the lists
hold the results of the same calls.
*/}}
{{- define "suite.results"}}
{{- template "suite.lists" .}}
{{- template "suite.counter" .}}
{{- end}}

{{- /*
suite.lists writes the draw of the list of each result of a generated
function and the end value of each channel result.
*/}}
{{- define "suite.lists"}}
{{- $first := ""}}
{{- range $i, $r := .Results}}
{{- $prop := import "go.dokimi.dev/assert/prop"}}
{{- if $i}}
	{{.Name}} := c.Draw({{$prop}}.List({{template "suite.value" .}}, {{$prop}}.MinSize(len({{$first}})), {{$prop}}.MaxSize(len({{$first}}))), {{printf "%q" .Label}})
{{- else}}
{{- $first = .Name}}
	{{.Name}} := c.Draw({{$prop}}.List({{template "suite.value" .}}), {{printf "%q" .Label}})
{{- end}}
{{- end}}
{{- template "suite.ends" .}}
{{- end}}

{{- /*
suite.counter writes the counter of the calls of a generated function with
results.
*/}}
{{- define "suite.counter"}}
{{- with .Index}}
	var {{.}} {{import "sync/atomic"}}.Int64
{{- end}}
{{- end}}

{{- /*
suite.ends writes the end value of each channel result of a generated
function: a closed channel without elements for a receive channel and a
channel of both directions, and the drawn sink of the test for a send
channel.
*/}}
{{- define "suite.ends"}}
{{- range .Results}}
{{- if .End}}
	{{.End}} := {{if .Sink}}c.Draw({{import "go.dokimi.dev/assert/prop"}}.Of[{{spell .Type}}](), {{printf "%q" (printf "%s-end" .Label)}}){{else}}{{import "go.dokimi.dev/conform"}}.Closed[{{spell .Type}}](){{end}}
{{- end}}
{{- end}}
{{- end}}

{{- /*
suite.value writes the generator of one value of a result of a generated
function. An error result takes nil and the declared errors of its method,
or conform.ErrGenerated without them.
*/}}
{{- define "suite.value"}}
{{- $prop := import "go.dokimi.dev/assert/prop"}}
{{- if .Error}}{{$prop}}.SampledFrom[error](nil{{range .Errors}}, {{value .}}{{else}}, {{import "go.dokimi.dev/conform"}}.ErrGenerated{{end}})
{{- else}}{{$prop}}.Of[{{spell .Type}}](){{end}}
{{- end}}

{{- /*
suite.func writes a generated function, which returns the drawn results of
its calls in turn. After the last of them it returns its end values: the end
error of each error result, which is the first declared error of its method
or conform.ErrGenerated, the end value of each channel result, and the zero
value of any other result.
*/}}
{{- define "suite.func"}}func({{params .Signature.Params}}){{results .Signature.Returns}} {
{{- with .Index}}
		i := int({{.}}.Add(1) - 1)
		if i >= len({{(index $.Results 0).Name}}) {
{{- range $.Results}}
{{- if .Error}}
			{{.Return}} = {{with .Errors}}{{value (index . 0)}}{{else}}{{import "go.dokimi.dev/conform"}}.ErrGenerated{{end}}
{{- else if .End}}
			{{.Return}} = {{.End}}
{{- end}}
{{- end}}
			return
		}
		return {{range $i, $r := $.Results}}{{if $i}},
			{{end}}{{$r.Name}}[i]{{end}}
	}
{{- else}}}
{{- end}}
{{- end}}
