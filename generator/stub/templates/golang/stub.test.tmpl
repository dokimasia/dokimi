{{- /* The arguments that every check calls with. A sample replaces the zero
       wherever one can be written: the body of a method of the record of the
       tests assigns it. The data is the site of the method. The partial
       writes whole lines, so a caller trims the space after it. */ -}}
{{- define "stub.testargs"}}{{"\n"}}
{{- range $i, $p := .Method.Params}}var a{{$i}} {{if $p.Variadic}}[]{{end}}{{spell $p.Type}}{{"\n"}}{{end}}
{{- if ge .Method.Args 0}}{{memberbody (index .Test.Methods.Items .Method.Args)}}{{end}}
{{- end}}

{{- /* The values of the check of Returns: the zero of each result, and a
       sample wherever one can be written. The data is the site of the
       method. The partial writes whole lines, as stub.testargs does. */ -}}
{{- define "stub.pins"}}{{"\n"}}
{{- range $i, $r := .Method.Returns}}var want{{$i}} {{spell $r.Type}}{{"\n"}}{{end}}
{{- if ge .Method.Pins 0}}{{memberbody (index .Test.Methods.Items .Method.Pins)}}{{end}}
{{- end}}

{{- define "stub.pinned"}}
{{- range $i, $r := .Returns}}{{if $i}}, {{end}}{{if $r.Pinned}}got{{$i}}{{else}}_{{end}}{{end}}
{{- end}}

{{- define "stub.testdefaults"}}
{{- $sep := ""}}
{{- range $r := .Returns}}{{with $r.Default}}{{$sep}}{{$r.Field}}: {{if .Optional}}&{{end}}{{$r.Local}}{{$sep = ", "}}{{end}}{{end}}
{{- end}}

{{- define "stub.zeros"}}
{{- if .Returns}}
{{- range $i, $r := .Returns}}
				var z{{$i}} {{spell $r.Type}}
{{- end}}
				return {{range $i, $r := .Returns}}{{if $i}}, {{end}}z{{$i}}{{end}}
{{- end}}
{{- end}}

{{- define "stub.blanks"}}
{{- if .Returns}}{{range $i, $r := .Returns}}{{if $i}}, {{end}}_{{end}} = {{end}}
{{- end}}

{{- define "stub.fails"}}
{{- $m := .}}{{range $i, $r := .Returns}}{{if $i}}, {{end}}{{if eq $i $m.Err}}{{$r.Local}}{{else}}_{{end}}{{end}}
{{- end}}

{{- define "stub.testcall"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}a{{$i}}{{if $p.Variadic}}...{{end}}{{end}}
{{- end}}

{{- define "stub.testfuncparams"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}_ {{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.testresults"}}
{{- if eq (len .Returns) 1}} {{spell (index .Returns 0).Type}}
{{- else if .Returns}} ({{range $i, $r := .Returns}}{{if $i}}, {{end}}{{spell $r.Type}}{{end}})
{{- end}}
{{- end}}
