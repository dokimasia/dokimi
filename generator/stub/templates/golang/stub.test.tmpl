{{docs (wrapdocs (printf `%sDouble describes how to build a %s under each
option whose effect is the same whatever a method's signature.

%s stands in for the double as a whole: these checks assert only
that an option reached it.` (stubCamel $stub) $stub $m.Name))}}
{{- ""}}func {{stubCamel $stub}}Double{{$tp}}() stub.Double[{{$call}}{{$ta}}] {
	instance := func(s *{{$double}}{{$ta}}) stub.Instance[{{$call}}{{$ta}}] {
		return stub.Instance[{{$call}}{{$ta}}]{
			Stub: s.{{$m.Field}}.MethodStub,
			Call: func() {
{{- template "stub.testargs" $site -}}
				{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
			},
			Reset: s.ResetCalls,
		}
	}
	return stub.Double[{{$call}}{{$ta}}]{
		New: func(tb assert.TB) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{$new}}{{$ta}}(tb))
		},
		WithClock: func(tb assert.TB, clk assert.Clock) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sWithClock" $stub))}}{{$ta}}(clk)))
		},
		WithLatency: func(tb assert.TB, d time.Duration, clk assert.Clock) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{spell (stubRef $t (printf "New%sDelayed" $stub))}}{{$ta}}(tb, d, clk))
		},
		WithRandSource: func(tb assert.TB, src rand.Source) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sWithRandSource" $stub))}}{{$ta}}(src)))
		},
		BenchMode: func(tb assert.TB) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sBenchMode" $stub))}}{{$ta}}()))
		},
		Strict: func(tb assert.TB) stub.Instance[{{$call}}{{$ta}}] {
			return instance({{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sStrict" $stub))}}{{$ta}}()))
		},
	}
}

