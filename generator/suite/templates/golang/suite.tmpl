{{- range $q.Steps}}{{if .Action}}
		{
			Name: {{printf "%q" .Name}},
			Input: func(c *{{$prop}}.Case) any {
{{- if not .Builder}}{{range .Params}}{{if ge .Arg 0}}
{{- if .Pool}}
