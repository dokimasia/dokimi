{{- use "vitest" "describe"}}{{use "vitest" "expect"}}{{use "vitest" "it"}}
{{- range .Records}}
{{- $r := .Decl}}
{{- $c := .Data}}
{{- range $c.Kinds}}
{{- $m := index $r.Methods.Items .Method}}
{{- $texts := false}}{{$several := false}}
{{- range .Members}}{{if .Text}}{{if $texts}}{{$several = true}}{{end}}{{$texts = true}}{{end}}{{end}}
{{- $message := or (not .Remote) $texts}}
{{- if $message}}

function {{sentinelCases .Name "message"}}(): void {
{{- if not .Remote}}
  it("is not empty", () => {
{{memberbody $m}}    expect(got.message).isNotEqualTo("", "the error has a message");
  });
{{- if $c.Prefix}}

  it("opens with the prefix of its module", () => {
{{memberbody $m}}    expect(got.message).hasPrefix({{printf "%q" $c.Prefix}}, "the message opens with the prefix of the module");
  });
{{- end}}
{{- end}}
{{- if $texts}}
{{- $check := "expect"}}{{if $several}}{{$check = "expect.soft"}}{{end}}
{{- if not .Remote}}
{{end}}
  it("contains each text member", () => {
{{memberbody $m}}
{{- range .Members}}{{if .Text}}    {{$check}}(got.message).doesContain(got.{{.Name}}, "the message contains {{.Name}}");
{{end}}{{end}}  });
{{- end}}
}
{{- end}}
{{- if ge .CauseMethod 0}}

function {{sentinelCases .Name "cause"}}(): void {
  it("is the cause of the construction", () => {
    const cause = new Error("cause");
{{memberbody (index $r.Methods.Items .CauseMethod)}}    expect(got.cause).isEqualTo(cause, "the error keeps its cause");
  });
}
{{- end}}

describe("{{.Name}}", () => {
{{- if ge .PeersMethod 0}}
  it("matches no other error class of its module", () => {
{{memberbody $m}}{{memberbody (index $r.Methods.Items .PeersMethod)}}    for (const other of others) {
      expect.soft(got).errorIsNot(other, "the error does not match another error class of the module");
    }
  });

{{- end}}
{{- if and (ge .PeersMethod 0) $message}}
{{end}}
{{- if $message}}
  describe("message", {{sentinelCases .Name "message"}});
{{- end}}
{{- if ge .CauseMethod 0}}
  describe("cause", {{sentinelCases .Name "cause"}});
{{- end}}
});
{{- end}}
{{- end}}
