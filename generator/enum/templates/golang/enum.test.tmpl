{{- use "testing"}}{{use "go.dokimi.dev/assert"}}
{{- define "enum.variants"}}[]{{spell .Type}}{
{{- range .Variants}}
		{{value .Value}},
{{- end}}
	}
{{- end}}
{{- range .Records}}
{{- $d := .Decl}}
{{- $c := .Data}}
{{- $t := spell $c.Type}}
{{- $n := $c.Names}}

{{docs (wrapdocs (printf `Test%s checks the functions and the methods of the enumeration %s.` $c.Subject $c.Subject))}}
{{- ""}}func Test{{$c.Subject}}(t *testing.T) {
	t.Parallel()

	t.Run("gives each variant a value of its own", func(t *testing.T) {
		t.Parallel()
		seen := map[{{$t}}]bool{}
		for _, v := range {{template "enum.variants" $c}} {
			assert.False(t, seen[v], "each variant has a value of its own")
			seen[v] = true
		}
	})
{{- if $c.Calls.Values}}
{{- $values := spell (fieldType $d "values")}}

	t.Run("{{$n.Values}}", func(t *testing.T) {
		t.Parallel()

		t.Run("returns the declared variants in the order of their declaration", func(t *testing.T) {
			t.Parallel()
			want := {{template "enum.variants" $c}}
			assert.Equal(t, {{$values}}(), want, "{{$n.Values}} returns the declared variants")
		})

		t.Run("returns a new slice for each call", func(t *testing.T) {
			t.Parallel()
			first, second := {{$values}}(), {{$values}}()
			assert.NotEqual(t, &first[0], &second[0], "the two calls return two slices", assert.ByIdentity())
		})
	})
{{- end}}
{{- if $c.Calls.Render}}

	t.Run("{{$n.Render}}", func(t *testing.T) {
		t.Parallel()
{{- if $c.Stated}}

		tests := []struct {
			name string
			give {{$t}}
			want string
		}{
{{- range $c.Variants}}
{{- if .Stated}}
			{name: "returns the declared text of {{.Name}}", give: {{value .Value}}, want: {{.Text}}},
{{- end}}
{{- end}}
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				assert.Equal(t, tt.give.{{$n.Render}}(), tt.want, "{{$n.Render}} returns the declared text of the variant")
			})
		}
{{- end}}

		t.Run("returns a text of its own for each variant", func(t *testing.T) {
			t.Parallel()
			seen := map[string]bool{}
			for _, v := range {{template "enum.variants" $c}} {
				assert.False(t, seen[v.{{$n.Render}}()], "each variant has a text of its own")
				seen[v.{{$n.Render}}()] = true
			}
		})
{{- if and $c.OutOfRange $c.Generate.Render}}

		t.Run("renders a value outside the declared set with a text of its own", func(t *testing.T) {
			t.Parallel()
			out := {{$t}}({{$c.OutOfRange}})
			for _, v := range {{template "enum.variants" $c}} {
				assert.NotEqual(t, out.{{$n.Render}}(), v.{{$n.Render}}(), "an undeclared value has a text of its own")
			}
		})
{{- end}}
	})
{{- end}}
{{- if $c.Calls.Valid}}

	t.Run("{{$n.Valid}}", func(t *testing.T) {
		t.Parallel()

		tests := []struct {
			name string
			give {{$t}}
		}{
{{- range $c.Variants}}
			{name: "accepts {{.Name}}", give: {{value .Value}}},
{{- end}}
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				assert.True(t, tt.give.{{$n.Valid}}(), "{{$n.Valid}} accepts each declared variant")
			})
		}
{{- if $c.OutOfRange}}

		t.Run("refuses a value outside the declared set", func(t *testing.T) {
			t.Parallel()
			assert.False(t, {{$t}}({{$c.OutOfRange}}).{{$n.Valid}}(), "{{$n.Valid}} refuses an undeclared value")
		})
{{- end}}
{{- if $c.Zero}}

		t.Run("accepts the zero value {{$c.Zero.Name}}", func(t *testing.T) {
			t.Parallel()
			var zero {{$t}}
			assert.Equal(t, zero, {{value $c.Zero.Value}}, "the zero value is {{$c.Zero.Name}}")
			assert.True(t, zero.{{$n.Valid}}(), "{{$n.Valid}} accepts the zero value")
		})
{{- else}}

		t.Run("refuses the zero value", func(t *testing.T) {
			t.Parallel()
			var zero {{$t}}
			assert.False(t, zero.{{$n.Valid}}(), "{{$n.Valid}} refuses the zero value")
		})
{{- end}}
	})
{{- end}}
{{- if $c.Calls.Parse}}
{{- $parse := spell (fieldType $d "parse")}}

	t.Run("{{$n.Parse}}", func(t *testing.T) {
		t.Parallel()

		tests := []struct {
			name string
			give {{$t}}
		}{
{{- range $c.Variants}}
			{name: "returns {{.Name}} for its text", give: {{value .Value}}},
{{- end}}
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				got, err := {{$parse}}(tt.give.{{$n.Render}}())
				assert.NoError(t, err, "{{$n.Parse}} accepts the text of the variant")
				assert.Equal(t, got, tt.give, "{{$n.Parse}} returns the variant of the text")
			})
		}

		t.Run("refuses a text that no variant has", func(t *testing.T) {
			t.Parallel()
			_, err := {{$parse}}({{$c.Unknown}})
{{- if $c.Calls.Error}}
			assert.ErrorIs(t, err, {{spell (fieldType $d "error")}}, "{{$n.Parse}} refuses the text with {{$n.Sentinel}}")
{{- else}}
			assert.HasError(t, err, "{{$n.Parse}} refuses the text")
{{- end}}
{{- if $c.Generate.Parse}}
			assert.Contains(t, err.Error(), {{$c.Unknown}}, "the error contains the refused text")
{{- end}}
		})
	})
{{- end}}
{{- if and $c.Calls.Encode $c.Calls.Render}}

	t.Run("{{$n.Encode}}", func(t *testing.T) {
		t.Parallel()

		tests := []struct {
			name string
			give {{$t}}
		}{
{{- range $c.Variants}}
			{name: "encodes {{.Name}} as its text", give: {{value .Value}}},
{{- end}}
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				text, err := tt.give.{{$n.Encode}}()
				assert.NoError(t, err, "{{$n.Encode}} encodes the variant")
				assert.Equal(t, string(text), tt.give.{{$n.Render}}(), "the encoding of the variant is its text")
			})
		}
	})
{{- if $c.Calls.Decode}}

	t.Run("{{$n.Decode}}", func(t *testing.T) {
		t.Parallel()

		tests := []struct {
			name string
			give {{$t}}
		}{
{{- range $c.Variants}}
			{name: "decodes {{.Name}} from its encoding", give: {{value .Value}}},
{{- end}}
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				text, err := tt.give.{{$n.Encode}}()
				assert.NoError(t, err, "{{$n.Encode}} encodes the variant")
				var got {{$t}}
				assert.NoError(t, got.{{$n.Decode}}(text), "{{$n.Decode}} decodes the encoding")
				assert.Equal(t, got, tt.give, "{{$n.Decode}} returns the encoded variant")
			})
		}

		t.Run("refuses a text that no variant has", func(t *testing.T) {
			t.Parallel()
			var got {{$t}}
			assert.HasError(t, got.{{$n.Decode}}([]byte({{$c.Unknown}})), "{{$n.Decode}} refuses the text")
		})
	})
{{- end}}
{{- end}}
}
{{- end}}
