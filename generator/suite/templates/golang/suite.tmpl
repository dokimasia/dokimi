{{- else if .Sample}}
				{{.Name}} := {{if .Variadic}}[]{{spell .Type}}{ {{- value .Sample -}} }{{else}}{{value .Sample}}{{end}}
{{- else if or .Funcs .Input}}{{template "suite.generated.param" .Param}}
{{- else}}
				{{.Name}} := c.Draw({{if or .Variadic .Receive}}{{$prop}}.List({{$prop}}.Of[{{spell .Type}}]()){{else}}{{$prop}}.Of[{{spell .Type}}](){{end}}, {{printf "%q" .Label}})
{{- end}}
{{- $p := .}}{{range .Fields}}
				{{$p.Name}}.{{.Name}} = {{.Pool}}.Pick(c, {{printf "%q" .Label}})
{{- end}}
{{- end}}{{end}}{{end}}
				return []any{ {{- if not .Builder}}{{$first := true}}{{range .Params}}{{if ge .Arg 0}}{{if not $first}}, {{end}}{{$first = false}}{{if .Address}}&{{end}}{{.Name}}{{end}}{{end}}{{end -}} }
			},
			Args: func(input any) []any {
				args, _ := input.([]any)
				return args
			},
			Keys: func(input any) []any {
{{- if .Keys}}
				args, _ := input.([]any)
{{- range $i, $k := .Keys}}{{if .Field}}
				key{{$i}}, _ := args[{{.Arg}}].({{spell .Type}})
{{- end}}{{end}}
				return []any{ {{- range $i, $k := .Keys}}{{if $i}}, {{end}}{{if .Field}}key{{$i}}.{{.Field}}{{else}}args[{{.Arg}}]{{end}}{{end -}} }
{{- else}}
				return nil
{{- end}}
			},
			Call: func(ctx {{$context}}.Context, s {{$s}}, input any) ({{$conform}}.Output, error) {
