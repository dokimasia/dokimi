{{- /*
The test imports each double from the module of its file without the suffix
.test.ts, so a config that routes the two families apart breaks the import.
*/ -}}
{{- $module := stubModule $.Name}}
{{- use "vitest" "describe"}}{{use "vitest" "expect"}}{{use "vitest" "it"}}
{{- range .Records}}
{{- $t := .Decl}}
{{- $c := .Data}}
{{- $stub := $c.Double}}
{{- $tp := typeparams $t.TypeParams}}
{{- $ta := typeargs $t.TypeParams}}
{{- $wa := typeargs $c.Witnesses}}
{{- $double := printf "%s%s" $stub $wa}}
{{- use $module $stub}}
{{- if $c.Methods}}{{use "@dokimi/assert" "byIdentity"}}{{use "@dokimi/assert" "Standard"}}
{{- use "@dokimi/runtime/stub/behaviour" "behaviour"}}{{use "@dokimi/runtime/stub/behaviour" "resetBehaviour"}}
{{- use "@dokimi/runtime/stub/behaviour" "settle"}}
{{- $seat := spell (stubType "Seat" "@dokimi/assert")}}
{{- $subject := spell (stubType "Subject" "@dokimi/runtime/stub/behaviour")}}
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- $call := printf "%s%s" (spell (stubType $m.Call $module)) (typeargs $m.TypeParams)}}
{{- $result := "undefined"}}{{with $m.Returns}}{{$result = spell (stubOptional (index . 0).Type)}}{{end}}
{{- if $m.Params}}

/** Returns the samples of the arguments of {{$m.Name}}. An argument without a sample is undefined. */
function {{$helper}}Args{{typeparams $m.ArgTypeParams}}(): [{{range $j, $p := $m.Params}}{{if $j}}, {{end}}{{if $p.Variadic}}{{spell (stubList $p.Type)}}{{else if $p.Optional}}{{spell (stubOptional $p.Type)}}{{else}}{{spell $p.Type}}{{end}}{{end}}] {
{{- range $j, $p := $m.Params}}
{{- if $p.Variadic}}
  const a{{$j}}: {{spell (stubList $p.Type)}} = [];
{{- else}}
  let a{{$j}} = undefined as unknown as {{spell $p.Type}};
{{- end}}
{{- end}}
{{if ge $m.Args 0}}{{body (index $t.Methods.Items $m.Args)}}{{end}}  return [{{range $j, $p := $m.Params}}{{if $j}}, {{end}}a{{$j}}{{end}}];
}
{{- end}}

/** Calls {{$m.Name}} of double with the samples of its arguments. */
function {{$helper}}{{$tp}}(double: {{$stub}}{{$ta}}){{template "stub.ts.returns" $m}} {
{{- if $m.Params}}
  const args = {{$helper}}Args{{typeargs $m.ArgTypeParams}}();
{{- end}}
  return double.{{$m.Name}}({{template "stub.ts.callargs" $m}});
}
{{- if $m.Pinnable}}

/** Returns the sample of the result of {{$m.Name}}. */
function {{$helper}}Pin(): {{spell (index $m.Returns 0).Type}} {
  let want0: {{spell (index $m.Returns 0).Type}};
{{body (index $t.Methods.Items $m.Pins)}}  return want0;
}
{{- end}}

/** Returns the subject of behaviour and resetBehaviour for {{$m.Name}}, on a new double that reports to seat. */
function {{$helper}}Subject{{$tp}}(seat: {{$seat}}): {{$subject}}<{{$call}}, {{$result}}> {
  const double = new {{$stub}}{{$ta}}(seat);
  return {
    stub: double.{{$m.Field}},
    call: () => {{$helper}}(double),
    reset: () => double.resetCalls(),
{{- if $m.Params}}{{use "@dokimi/assert" "check"}}
    arguments: (s, c) => {
      const args = {{$helper}}Args{{typeargs $m.ArgTypeParams}}();
{{- range $j, $p := $m.Params}}
      check.isEqualTo(s, c.{{$p.Field}}, args[{{$j}}], "the call records {{$p.Field}}");
{{- end}}
    },
{{- end}}
{{- if $m.Returns}}
    result: async () => {{if $m.Async}}await {{end}}{{$helper}}(double),
{{- with (index $m.Returns 0).Default}}
    default: () => {{spellvalue (stubRef $t .Ref)}}.{{.Seed}}{{typeargs .Args}}().build(),
{{- end}}
{{- if $m.Pinnable}}
    returns: () => {
      const want = {{$helper}}Pin();
      double.{{$m.Field}}.returns(want);
      return want;
    },
{{- end}}
{{- end}}
    override: (seen) => {
      double.{{$m.Field}}.func({{if $m.Params}}(...received: unknown[]){{else}}(){{end}} => {
        seen({ {{- range $j, $p := $m.Params}}{{if $j}},{{end}} {{$p.Field}}: {{if $p.Variadic}}received.slice({{$j}}){{else}}received[{{$j}}]{{end}}{{end}}{{if $m.Params}} {{end}}} as {{$call}});
        return undefined as never;
      });
    },
{{- if $m.Fails}}
    fails: async () => {
      const outcome = await settle(() => {{$helper}}(double));
      if (outcome.threw) {
        return outcome.error;
      }
      return undefined;
    },
{{- end}}
  };
}
{{- end}}
{{- $pick := 0}}{{$found := false}}
{{- range $i, $m := $c.Methods}}{{if and $m.Async (not $found)}}{{$pick = $i}}{{$found = true}}{{end}}{{end}}
{{- $p := index $c.Methods $pick}}
{{- $instance := printf "%sInstance" (stubCamel $stub)}}

/**
 * Returns the instance of double that the checks of the options drive. The
 * options apply to the whole double, so the checks call {{$p.Name}} alone.
 */
function {{$instance}}(double: {{$double}}) {
  return {
    stub: double.{{$p.Field}},
    call: () => {{stubCamel $stub}}{{stubPascal $p.Name}}(double),
  };
}

describe("{{$stub}}", () => {
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- if $i}}
{{end}}
  describe("{{$m.Name}}", () => {
    for (const c of behaviour("{{$m.Qualified}}", {{$helper}}Subject{{$wa}})) {
      it(c.name, () => c.run(new Standard()));
    }
  });
{{- end}}

  describe("resetCalls", () => {
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- if $i}}
{{end}}
    describe("{{$m.Name}}", () => {
      for (const c of resetBehaviour("{{$m.Qualified}}", {{$helper}}Subject{{$wa}})) {
        it(c.name, () => c.run(new Standard()));
      }
    });
{{- end}}
  });
{{- use "@dokimi/runtime/stub/double-behaviour" "strictBehaviour"}}

  describe("strict", () => {
    const checks = strictBehaviour((seat) => {{$instance}}(new {{$double}}(seat, {{$stub}}.strict{{$wa}}())));
    for (const c of checks) {
      it(c.name, () => c.run(new Standard()));
    }
{{- range $i, $m := $c.Methods}}
{{- with $m.After}}{{use "@dokimi/assert" "Recorder"}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}

    it("refuses {{$m.Name}} before {{.}}", async () => {
      const failures = new Recorder();
      const option = {{$stub}}.with{{$c.Subject}}{{stubPascal $m.Name}}{{$wa}}(() => undefined as never);
      const double = new {{$double}}(failures, {{$stub}}.strict{{$wa}}(), option);
      await settle(() => {{$helper}}(double));
      expect(failures.failed).isTrue("a strict double refuses {{$m.Name}} before {{.}}");
    });
{{- end}}
{{- end}}
  });

  describe("delegateTo", () => {
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- if $i}}
{{end}}
    it("passes {{$m.Name}} to the implementation", async () => {
      const inner = new {{$double}}(undefined);
      await settle(() => {{$helper}}(new {{$double}}(undefined, {{$stub}}.delegateTo{{$wa}}(inner))));
      expect(inner.{{$m.Field}}.callCount).isEqualTo(1, "{{$m.Name}} calls the implementation");
    });

    it("fails {{$m.Name}} with the error of the implementation", async () => {
      const want = new Error("{{$m.Name}}-delegate");
      const inner = new {{$double}}(undefined);
      inner.{{$m.Field}}.faults(want, 1);
      const double = new {{$double}}(undefined, {{$stub}}.delegateTo{{$wa}}(inner));
      const outcome = await settle(() => {{$helper}}(double));
      const message = "{{$m.Name}} fails with the error of the implementation";
      expect(outcome.threw && outcome.error).isEqualTo(want, message, byIdentity());
    });
{{- end}}
  });
{{- use "@dokimi/runtime/stub/double-behaviour" "clockBehaviour"}}

  describe("withClock", () => {
    const checks = clockBehaviour(
      (seat, clock) => {{$instance}}(new {{$double}}(seat, {{$stub}}.withClock{{$wa}}(clock))),
      {{$p.Async}},
    );
    for (const c of checks) {
      it(c.name, () => c.run(new Standard()));
    }
  });
{{- use "@dokimi/runtime/stub/double-behaviour" "randSourceBehaviour"}}

  describe("withRandSource", () => {
    const checks = randSourceBehaviour((seat, random) =>
      {{$instance}}(new {{$double}}(seat, {{$stub}}.withRandSource{{$wa}}(random))),
    );
    for (const c of checks) {
      it(c.name, () => c.run(new Standard()));
    }
  });
{{- use "@dokimi/runtime/stub/double-behaviour" "benchModeBehaviour"}}

  describe("benchMode", () => {
    const checks = benchModeBehaviour((seat) => {{$instance}}(new {{$double}}(seat, {{$stub}}.benchMode{{$wa}}())));
    for (const c of checks) {
      it(c.name, () => c.run(new Standard()));
    }
  });
{{- use "@dokimi/runtime/stub/double-behaviour" "latencyBehaviour"}}

  describe("withLatency", () => {
    const checks = latencyBehaviour(
      (seat, duration, clock) =>
        {{$instance}}(new {{$double}}(seat, {{$stub}}.withClock{{$wa}}(clock), {{$stub}}.withLatency{{$wa}}(duration))),
      {{$p.Async}},
    );
    for (const c of checks) {
      it(c.name, () => c.run(new Standard()));
    }
  });
{{- if $c.Fallible}}

  describe("failing", () => {
{{- range $i, $m := $c.Methods}}
{{- if $m.Fails}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- if $i}}
{{end}}
    it("fails {{$m.Name}} with its error", async () => {
      const want = new Error("{{$m.Name}}-failing");
      const double = new {{$double}}(undefined, {{$stub}}.failing{{$wa}}(want));
      const outcome = await settle(() => {{$helper}}(double));
      const message = "{{$m.Name}} fails with the error of {{$stub}}.failing";
      expect(outcome.threw && outcome.error).isEqualTo(want, message, byIdentity());
    });
{{- end}}
{{- end}}
  });
{{- end}}
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- $await := ""}}{{if $m.Async}}{{$await = "await "}}{{end}}
{{- $with := printf "with%s%s" $c.Subject (stubPascal $m.Name)}}

  describe("{{$with}}", () => {
    it("sets the function of {{$m.Name}}", async () => {
      let called = false;
      const option = {{$stub}}.{{$with}}{{$wa}}(() => {
        called = true;
        return undefined as never;
      });
      {{$await}}{{$helper}}(new {{$double}}(undefined, option));
      expect(called).isTrue("{{$with}} sets the function of {{$m.Name}}");
    });
  });
{{- end}}
});
{{- range $i, $m := $c.Methods}}
{{- if or $m.Sequence $m.Errors $m.Retry (ge $m.Partition 0)}}
{{- $helper := printf "%s%s" (stubCamel $stub) (stubPascal $m.Name)}}
{{- $sections := 0}}

describe("{{$m.Stub}}", () => {
{{- if $m.Sequence}}{{$sections = 1}}
  describe("yields", () => {
    it("yields each item", async () => {
      const double = new {{$double}}(undefined);
      double.{{$m.Field}}.yields(undefined as never, undefined as never);
      let seen = 0;
      for await (const _ of {{$helper}}(double)) {
        seen += 1;
      }
      expect(seen).isEqualTo(2, "{{$m.Name}} yields each item");
    });

    it("stops yielding when the caller breaks", async () => {
      const double = new {{$double}}(undefined);
      double.{{$m.Field}}.yields(undefined as never, undefined as never, undefined as never);
      let seen = 0;
      for await (const _ of {{$helper}}(double)) {
        seen += 1;
        break;
      }
      expect(seen).isEqualTo(1, "{{$m.Name}} stops when the caller breaks");
    });
  });
{{- end}}
{{- range $m.Errors}}
{{- if $sections}}
{{end}}{{$sections = 1}}
  describe("{{.Helper}}", () => {
    it("fails the next call of {{$m.Name}} with {{.Name}}", async () => {
      const double = new {{$double}}(undefined);
      double.{{$m.Field}}.{{.Helper}}();
      const outcome = await settle(() => {{$helper}}(double));
      const message = "the next call of {{$m.Name}} fails with {{.Name}}";
      expect(outcome.threw && outcome.error).isEqualTo({{value .Value}}, message, byIdentity());
    });

    it("spares the call after the failed call", async () => {
      const double = new {{$double}}(undefined);
      double.{{$m.Field}}.{{.Helper}}();
      await settle(() => {{$helper}}(double));
      const outcome = await settle(() => {{$helper}}(double));
      expect(outcome.threw).isFalse("the call of {{$m.Name}} after the failed call succeeds");
    });
  });
{{- end}}
{{- if $m.Retry}}
{{- if $sections}}
{{end}}{{$sections = 1}}
  describe("retrySchedule", () => {
    it("fails each call of {{$m.Name}} before call {{$m.Retry}}", async () => {
      const double = new {{$double}}(undefined);
      const want = new Error("{{$m.Name}}-retry");
      double.{{$m.Field}}.retrySchedule(want);
      for (let attempt = 1; attempt < {{$m.Retry}}; attempt += 1) {
        const outcome = await settle(() => {{$helper}}(double));
        const message = "a call of {{$m.Name}} before call {{$m.Retry}} fails";
        expect(outcome.threw && outcome.error).isEqualTo(want, message, byIdentity());
      }
    });

    it("spares call {{$m.Retry}} of {{$m.Name}}", async () => {
      const double = new {{$double}}(undefined);
      double.{{$m.Field}}.retrySchedule(new Error("{{$m.Name}}-retry"));
      for (let attempt = 1; attempt < {{$m.Retry}}; attempt += 1) {
        await settle(() => {{$helper}}(double));
      }
      const outcome = await settle(() => {{$helper}}(double));
      expect(outcome.threw).isFalse("call {{$m.Retry}} of {{$m.Name}} succeeds");
    });
  });
{{- end}}
{{- if ge $m.Partition 0}}
{{- if $sections}}
{{end}}
  describe("faultForPartition", () => {
    it("fails a call of {{$m.Name}} in the partition of the key", async () => {
      const double = new {{$double}}(undefined);
      const args = {{$helper}}Args{{typeargs $m.ArgWitnesses}}();
      const want = new Error("{{$m.Name}}-partition");
      double.{{$m.Field}}.faultForPartition(args[{{$m.Partition}}], want, 1);
      const outcome = await settle(() => {{$helper}}(double));
      const message = "a call in the partition of the key fails";
      expect(outcome.threw && outcome.error).isEqualTo(want, message, byIdentity());
    });
  });

  describe("faultForOtherPartitions", () => {
    it("spares a call of {{$m.Name}} in the partition of the key", async () => {
      const double = new {{$double}}(undefined);
      const args = {{$helper}}Args{{typeargs $m.ArgWitnesses}}();
      double.{{$m.Field}}.faultForOtherPartitions(args[{{$m.Partition}}], new Error("{{$m.Name}}-partition"), 1);
      const outcome = await settle(() => {{$helper}}(double));
      expect(outcome.threw).isFalse("a call in the partition of the key succeeds");
    });
  });
{{- end}}
});
{{- end}}
{{- end}}
{{- else}}{{use "@dokimi/assert" "Controlled"}}
{{- $props := printf "%sProps" (stubCamel $stub)}}
{{- $check := "expect"}}{{if gt (len $c.Properties) 1}}{{$check = "expect.soft"}}{{end}}
{{- if ge $c.Props 0}}

/** Assigns the sample of each property of {{$stub}} to double. */
function {{$props}}(double: {{$double}}): void {
{{body (index $t.Methods.Items $c.Props)}}}
{{- end}}

describe("{{$stub}}", () => {
  describe("resetCalls", () => {
    const tests: { name: string; giveDouble: () => {{$double}} }[] = [
      {
        name: "keeps each property of a new double",
        giveDouble: () => new {{$double}}(undefined),
      },
      {
        name: "keeps each property of a strict double",
        giveDouble: () => new {{$double}}(undefined, {{$stub}}.strict{{$wa}}()),
      },
      {
        name: "keeps each property of a double with a clock",
        giveDouble: () => new {{$double}}(undefined, {{$stub}}.withClock{{$wa}}(new Controlled())),
      },
      {
        name: "keeps each property of a double with a random source",
        giveDouble: () => new {{$double}}(undefined, {{$stub}}.withRandSource{{$wa}}(() => 0)),
      },
      {
        name: "keeps each property of a double in bench mode",
        giveDouble: () => new {{$double}}(undefined, {{$stub}}.benchMode{{$wa}}()),
      },
      {
        name: "keeps each property of a double with a latency",
        giveDouble: () => new {{$double}}(undefined, {{$stub}}.withLatency{{$wa}}(1)),
      },
    ];
    for (const tt of tests) {
      it(tt.name, () => {
        const double = tt.giveDouble();
{{- if ge $c.Props 0}}
        {{$props}}(double);
{{- end}}
        double.resetCalls();
        const want = new {{$double}}(undefined);
{{- if ge $c.Props 0}}
        {{$props}}(want);
{{- end}}
{{- range $c.Properties}}
        {{$check}}(double.{{.Field}}).isEqualTo(want.{{.Field}}, "resetCalls keeps the property {{.Field}}");
{{- end}}
      });
    }
  });
});
{{- end}}
{{- end}}

{{- define "stub.ts.returns"}}
{{- $value := "void"}}{{with .Returns}}{{$value = spell (index . 0).Type}}{{end}}
{{- if .Async}}: Promise<{{$value}}>{{else}}: {{$value}}{{end}}
{{- end}}

{{- define "stub.ts.callargs"}}
{{- range $j, $p := .Params}}{{if $j}}, {{end}}{{if $p.Variadic}}...{{end}}args[{{$j}}]{{end}}
{{- end}}
