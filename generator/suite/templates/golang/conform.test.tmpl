{{- use "testing"}}
{{- range .Records}}
{{- $c := .Data}}
{{- $refs := .Decl.Fields.Items}}

{{docs (wrapdocs (printf `%s applies the checks of the suite of %s to %s.` $c.Test $c.Declaration $c.Subject))}}
{{- ""}}func {{$c.Test}}(t *testing.T) {
	t.Parallel()

	{{spell (index $refs 0).Type}}(t, {{spell (index $refs 1).Type}})
}
{{- end}}
