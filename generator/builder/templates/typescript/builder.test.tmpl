{{- range .Records}}
{{- $t := .Decl}}
{{- $c := .Data}}
{{- if not $c.Instantiable}}

// {{$c.Subject}} is generic, and its type parameters have no witnesses, so the
// file has no tests of {{$t.Name}}. A test in the module of a consumer
// instantiates it.
{{- else}}
{{- use "vitest" "describe"}}{{use "vitest" "expect"}}{{use "vitest" "it"}}{{use "@dokimi/assert" "byIdentity"}}
{{- use (printf "./%s" (trimSuffix $.Name ".test.ts")) $t.Name}}
{{- $seed := index $t.Types.Items 0}}
{{- $ta := typeargs $c.Args}}
{{- $create := printf "%s.%s%s" $t.Name $c.New $ta}}
{{- if $c.Defaults}}

function {{builderCases $t.Name $c.New}}(): void {
{{- range $i, $check := slice $t.Types.Items 1}}
{{- $field := index $c.Defaults $i}}
{{- if $i}}
{{end}}
  it("applies the declared default of {{$field}}", () => {
    let want: {{spell (index $check.Params.Items 0).Type}};
{{memberbody $check}}    const got = {{$create}}().build();
    expect(got.{{$field}}).isEqualTo(want, "{{$c.New}} applies the declared default of {{$field}}");
  });
{{- end}}
}
{{- end}}

function {{builderCases $t.Name $c.From}}(): void {
{{- if $c.Seeds}}
{{- $check := "expect"}}{{if gt (len $c.Seeds) 1}}{{$check = "expect.soft"}}{{end}}
  it("keeps each member of its value", () => {
    const seed = new {{spellvalue $c.Struct}}();
{{memberbody $seed}}    const got = {{$t.Name}}.{{$c.From}}{{$ta}}(seed).build();
{{- range $c.Seeds}}
    {{$check}}(got.{{.}}).isEqualTo(seed.{{.}}, "{{$c.From}} keeps {{.}}");
{{- end}}
  });

{{- end}}
{{- if $c.Seeds}}
{{end}}
  it("keeps the value of its argument", () => {
    const want = {{$create}}().build();
    expect({{$t.Name}}.{{$c.From}}{{$ta}}(want).build()).isEqualTo(want, "{{$c.From}} keeps the value of its argument");
  });
}
{{- range $s := $c.Setters}}
{{- $m := index $t.Methods.Items $s.Method}}
{{- $spread := ""}}{{if eq $s.Form "list"}}{{$spread = "..."}}{{end}}

function {{builderCases $t.Name $s.Setter}}(): void {
  it("writes its argument to {{$s.Field}}", () => {
    let want: {{spell $s.Type}};
{{memberbody $m}}    const got = {{$create}}().{{$s.Setter}}({{$spread}}want).build();
    expect(got.{{$s.Field}}).isEqualTo(want, "{{$s.Setter}} writes its argument to {{$s.Field}}");
  });
{{- if ge $s.Replace 0}}
{{- $r := index $t.Methods.Items $s.Replace}}

  it("replaces the value of {{$s.Field}}", () => {
    let first: {{spell $s.Type}};
    let want: {{spell $s.Type}};
{{memberbody $r}}    const got = {{$create}}().{{$s.Setter}}({{$spread}}first).{{$s.Setter}}({{$spread}}want).build();
    expect(got.{{$s.Field}}).isEqualTo(want, "the second call of {{$s.Setter}} replaces the first");
  });
{{- end}}
}
{{- end}}
{{- range $p := $c.Probes}}

function {{builderCases $t.Name .Method}}(): void {
{{- if lt .Sample 0}}
  it("returns its builder", () => {
    const builder = {{$create}}();
{{- if eq .Kind "append"}}
    const got = builder.{{.Method}}();
{{- else if and (eq .Kind "entries") (eq .Form "set")}}
    const got = builder.{{.Method}}();
{{- else if eq .Kind "entries"}}
    const got = builder.{{.Method}}(builder.build().{{.Field}});
{{- else if and (eq .Kind "entry") (eq .Form "set")}}
    const got = builder.{{.Method}}(undefined as never);
{{- else if eq .Kind "entry"}}
    const got = builder.{{.Method}}(undefined as never, undefined as never);
{{- else if eq .Form "list"}}
    const got = builder.{{.Method}}(...builder.build().{{.Field}});
{{- else if eq .Form "optional"}}
    const got = builder.{{.Method}}(undefined as never);
{{- else}}
    const got = builder.{{.Method}}(builder.build().{{.Field}});
{{- end}}
    expect(got).isEqualTo(builder, "{{.Method}} returns its builder for the next call", byIdentity());
  });
{{- else}}
{{- $m := index $t.Methods.Items .Sample}}
{{- if eq .Kind "append"}}
  it("appends to the elements of {{.Field}}", () => {
{{- if ge .Pair 0}}
{{- $r := index $t.Methods.Items .Pair}}
    let first: {{spell (index $r.Params.Items 0).Type}};
    let want: {{spell (index $r.Params.Items 0).Type}};
{{memberbody $r}}    const got = {{$create}}().{{.With}}(...first).{{.Method}}(...want).build();
    expect(got.{{.Field}}).isEqualTo([...first, ...want], "{{.Method}} appends its elements after those of {{.With}}");
{{- else}}
    let want: {{spell (index $m.Params.Items 0).Type}};
{{memberbody $m}}    const got = {{$create}}().{{.With}}(...want).{{.Method}}(...want).build();
    expect(got.{{.Field}}).isEqualTo([...want, ...want], "{{.Method}} appends its elements after those of {{.With}}");
{{- end}}
  });
{{- else if eq .Kind "entry"}}
  it("adds one key to {{.Field}}", () => {
    let want: {{spell (index $m.Params.Items 0).Type}};
{{memberbody $m}}    const builder = {{$create}}();
{{- if eq .Form "set"}}
    for (const key of want) {
      expect(builder.{{.Method}}(key).build().{{.Field}}.has(key)).isTrue("{{.Method}} adds the key");
    }
{{- else if mapclass .Type}}
    for (const [key, item] of want) {
      expect(builder.{{.Method}}(key, item).build().{{.Field}}.get(key)).isEqualTo(item, "{{.Method}} sets the key");
    }
{{- else}}
    for (const [key, item] of Object.entries(want)) {
      expect(builder.{{.Method}}(key, item).build().{{.Field}}[key]).isEqualTo(item, "{{.Method}} sets the key");
    }
{{- end}}
  });
{{- else}}
  it("adds each key to {{.Field}}", () => {
    let want: {{spell (index $m.Params.Items 0).Type}};
{{memberbody $m}}
{{- if eq .Form "set"}}    const got = {{$create}}().{{.Method}}(...want).build();
    for (const key of want) {
      expect(got.{{.Field}}.has(key)).isTrue("{{.Method}} adds each key");
    }
{{- else if mapclass .Type}}    const got = {{$create}}().{{.Method}}(want).build();
    for (const [key, item] of want) {
      expect(got.{{.Field}}.get(key)).isEqualTo(item, "{{.Method}} copies each entry");
    }
{{- else}}    const got = {{$create}}().{{.Method}}(want).build();
    for (const [key, item] of Object.entries(want)) {
      expect(got.{{.Field}}[key]).isEqualTo(item, "{{.Method}} copies each entry");
    }
{{- end}}
  });
{{- end}}
{{- end}}
}
{{- end}}

function {{builderCases $t.Name "mutate"}}(): void {
  it("passes the value under construction", () => {
    const seen: {{spell $c.Value}}[] = [];
    const record = (value: {{spell $c.Value}}): void => {
      seen.push(value);
    };
    {{$create}}().mutate(record).mutate(record);
    expect(seen).hasLength(2, "mutate calls each function once");
    expect(seen[0]).isEqualTo(seen[1], "the two functions get the same value", byIdentity());
  });
}

function {{builderCases $t.Name "clone"}}(): void {
  it("returns a builder of its own", () => {
    const original = {{$create}}();
    expect(original.clone()).isNotEqualTo(original, "clone returns a builder of its own", byIdentity());
  });

  it("builds the value of its original", () => {
    const original = {{$create}}();
    expect(original.clone().build()).isEqualTo(original.build(), "the clone builds the value of its original");
  });
{{- range $s := $c.Clones}}
{{- $m := index $t.Methods.Items $s.Method}}

  it("copies {{$s.Field}} into the clone", () => {
    let want: {{spell $s.Type}};
    let other: {{spell $s.Type}};
{{memberbody $m}}
{{- if eq $s.Form "list"}}    const original = {{$create}}().{{$s.Setter}}(...want);
{{- else}}    const original = {{$create}}().{{$s.Setter}}(want);
{{- end}}
    const clone = original.clone();
    const message = "a change of {{$s.Field}} in the clone leaves the original unchanged";
{{- if eq $s.Form "list"}}
    clone.mutate((value) => {
      value.{{$s.Field}}.splice(0, other.length, ...other);
    });
    expect(original.build().{{$s.Field}}).isNotEqualTo(other, message);
{{- else if eq $s.Form "bytes"}}
    clone.mutate((value) => {
      value.{{$s.Field}}.set(other);
    });
    expect(original.build().{{$s.Field}}).isNotEqualTo(other, message);
{{- else if eq $s.Form "set"}}
    clone.mutate((value) => {
      for (const key of other) {
        value.{{$s.Field}}.add(key);
      }
    });
    expect(original.build().{{$s.Field}}).hasLength(1, message);
{{- else if mapclass $s.Type}}
    clone.mutate((value) => {
      for (const [key, item] of other) {
        value.{{$s.Field}}.set(key, item);
      }
    });
    expect(original.build().{{$s.Field}}).hasLength(1, message);
{{- else}}
    clone.mutate((value) => {
      Object.assign(value.{{$s.Field}}, other);
    });
    expect(original.build().{{$s.Field}}).hasLength(1, message);
{{- end}}
  });
{{- end}}
{{- range $c.Fills}}
{{- if ge .Sample 0}}
{{- $m := index $t.Methods.Items .Sample}}

  it("builds the {{.Field}} of its original", () => {
    let want: {{spell (index $m.Params.Items 0).Type}};
{{memberbody $m}}    const original = {{$create}}().{{.With}}({{if eq .Form "list"}}...{{end}}want);
    expect(original.clone().build().{{.Field}}).isEqualTo(want, "the clone builds the {{.Field}} of its original");
  });
{{- end}}
{{- end}}
}

function {{builderCases $t.Name "build"}}(): void {
  it("returns a new object for each call", () => {
    const builder = {{$create}}();
    expect(builder.build()).isNotEqualTo(builder.build(), "build returns a new object", byIdentity());
  });
{{- if $c.Seeds}}

  it("returns the value under construction", () => {
    const seed = new {{spellvalue $c.Struct}}();
{{memberbody $seed}}    const builder = {{$create}}().mutate((value) => {
      Object.assign(value, seed);
    });
    expect(builder.build()).isEqualTo(seed, "build returns the value that mutate sets");
  });
{{- end}}
}

describe("{{$t.Name}}", () => {
{{- if $c.Defaults}}
  describe("{{$c.New}}", {{builderCases $t.Name $c.New}});
{{- end}}
  describe("{{$c.From}}", {{builderCases $t.Name $c.From}});
{{- range $c.Setters}}
  describe("{{.Setter}}", {{builderCases $t.Name .Setter}});
{{- end}}
{{- range $c.Probes}}
  describe("{{.Method}}", {{builderCases $t.Name .Method}});
{{- end}}
  describe("mutate", {{builderCases $t.Name "mutate"}});
  describe("clone", {{builderCases $t.Name "clone"}});
  describe("build", {{builderCases $t.Name "build"}});
});
{{- end}}
{{- end}}
