{{- /*
suite.txn writes the action of a transaction, which no probe but a probe of
an isolation level runs. Its input draws the micro-operations of the
transaction and whether it commits. Its run begins a transaction, calls the
write or the read of each micro-operation with the handle, commits or rolls
back, and records the transaction as one call of txn.
*/}}
{{- define "suite.txn"}}
{{- $prop := import "go.dokimi.dev/assert/prop"}}{{$t := .}}
		{
			Name:    {{printf "%q" "txn"}},
			Enabled: func(struct{}) bool { return false },
			Input: func(c *{{$prop}}.Case, _ struct{}) any {
				ops := make([]any, c.Draw({{$prop}}.Integer(1, 4), "txn.ops"))
				for i := range ops {
					key := c.Draw({{$prop}}.SampledFrom({{.Pool}}...), "txn.key")
					if c.Draw({{$prop}}.Boolean(), "txn.read") {
						ops[i] = []any{"read", key, nil}
						continue
					}
					ops[i] = []any{ {{- printf "%q" .Function}}, key, {{spell .Value}}({{if .Text}}{{import "strconv"}}.FormatInt(counter.Add(1), 10){{else}}counter.Add(1){{end}})}
				}
				return []any{ops, c.Draw({{$prop}}.Integer(0, 9), "txn.commit") > 0}
			},
			Run: func(c *{{$prop}}.Case, client int, input any) {
				in, _ := input.([]any)
				ops, _ := in[0].([]any)
				commit, _ := in[1].(bool)
				call := c.History().Invoke(client, "txn", ops)
				ctx, s := c.Context(), subject()
				end := func(err error) {
					if ctx.Err() != nil && {{import "errors"}}.Is(err, ctx.Err()) {
						call.Unknown(err)
						return
					}
					call.Fail(err)
				}
				begun, err := {{template "suite.txn.call" (suiteTxnCall .Begin "s")}}
				if err != nil {
					end(err)
					return
				}
{{- if or .Write.Handled .Read.Handled .Commit.Handled .Rollback.Handled}}
				tx, _ := begun[0].({{spell .Handle}})
{{- else}}
				tx := begun[0]
{{- end}}
				rollback := func() { _, _ = {{template "suite.txn.call" (suiteTxnCall .Rollback "s")}} }
				out := make([]any, len(ops))
				for i, op := range ops {
					m, _ := op.([]any)
					key, v := m[1], m[2]
					if m[0] == "read" {
						read, err := {{template "suite.txn.call" (suiteTxnCall .Read "s")}}
						if err != nil {
							rollback()
							end(err)
							return
						}
{{- if .Appends}}
						out[i] = []any{"read", key, read[0]}
{{- else}}
						var value any
						if r := read[0]; r != any(*new({{spell .Value}})) {
							value = r
						}
						out[i] = []any{"read", key, value}
{{- end}}
						continue
					}
					if _, err := {{template "suite.txn.call" (suiteTxnCall .Write "s")}}; err != nil {
						rollback()
						end(err)
						return
					}
					out[i] = m
				}
				if !commit {
					rollback()
					call.Fail({{import "go.dokimi.dev/conform"}}.ErrGenerated)
					return
				}
				if _, err := {{template "suite.txn.call" (suiteTxnCall .Commit "s")}}; err != nil {
					end(err)
					return
				}
				call.OK(out)
			},
		},
{{- end}}

{{- /*
suite.txn.call writes the call of the function of the step of one call of a
transaction, on the subject or on the handle tx, with the context ctx and the
arguments of the call.
*/}}
