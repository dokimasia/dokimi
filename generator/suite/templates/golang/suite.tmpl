{{- use "testing"}}{{use "go.dokimi.dev/conform"}}
{{- range .Records}}
{{- $d := .Decl}}
{{- $c := .Data}}
{{- $n := $c.Names}}
{{- $checks := suitePascal $n.Checks}}
{{- if eq $d.Name $checks}}
{{- $s := spell $c.Subject}}
{{- with $c.Methods}}{{$s = suitePascal $n.Methods}}{{end}}
{{- with $c.Func}}{{$s = suitePascal $n.Func}}{{end}}
{{- $suite := suitePascal $n.Suite}}
{{- $run := suitePascal $n.Run}}
{{- $fromHandle := suitePascal $n.RunFromHandle}}
{{- $fuzz := suitePascal $n.Fuzz}}
{{- $budgets := suitePascal $n.Budgets}}
{{- $bench := suitePascal $n.Bench}}
{{- $benchParallel := suitePascal $n.BenchParallel}}
{{- $handle := suitePascal $n.Handle}}
{{- $check := suitePascal $n.Check}}
{{- $option := suitePascal $n.Option}}
{{- $over := suiteCamel $n.Over}}
{{- $newOver := suiteCamel $n.NewOver}}
{{- $subjects := suiteCamel $n.Subjects}}
{{- if $c.Calls}}{{use "context"}}{{use "go.dokimi.dev/assert/prop"}}{{end}}

// The suite refers to the compatibility witness of its runtime.
var _ = conform.CompatV1

{{docs (wrapdocs (printf `The names that a test of %s writes.` $c.Declaration))}}
{{- ""}}type (
	{{$handle}} = conform.Handle[{{$s}}]
	{{$check}} = conform.Check[{{$s}}]
	{{$option}} = conform.Option[{{$s}}]
)
{{- with $c.Methods}}

{{docs (wrapdocs (printf `%s is the interface of the exported methods of %s. Each subject of the suite of %s implements it.` $s $c.Declaration $c.Declaration))}}
{{- ""}}type {{$s}} interface {
{{- range .Methods.Items}}
	{{.Name}}({{params .Params}}){{results .Returns}}
{{- end}}
}
{{- end}}
{{- with $c.Func}}

{{docs (wrapdocs (printf `%s is the type of the function %s. Each subject of the suite of %s has it.` $s $c.Declaration $c.Declaration))}}
{{- ""}}type {{$s}} func({{params .Params}}){{results .Returns}}
{{- end}}

{{docs (wrapdocs (printf `%s contains the name of each callable of %s, with the identities of its checks.` $checks $c.Declaration))}}
{{- if $c.Func}}
{{- $only := index $c.Callables 0}}
{{- ""}}var {{$checks}} = {{suiteCamel $only.Type}}{ {{- printf "%q" $only.Name -}} }
{{- else if $c.Callables}}
{{- ""}}var {{$checks}} = struct {
{{- range $c.Callables}}
	{{.Field}} {{suiteCamel .Type}}
{{- end}}
}{
{{- range $c.Callables}}
	{{.Field}}: {{suiteCamel .Type}}{ {{- printf "%q" .Name -}} },
{{- end}}
}
{{- else}}
{{- ""}}var {{$checks}} = struct{}{}
{{- end}}
{{- range $callable := $c.Callables}}
{{- $type := suiteCamel .Type}}

{{docs (wrapdocs (printf `%s is the name of %s, with the identities of its checks.` $type .Name))}}
{{- ""}}type {{$type}} struct {
	conform.Callable[{{$s}}]
}
{{- range $c.Checks}}
{{- if eq .Type $callable.Type}}
{{- $method := suitePascal .Method}}

{{docs (wrapdocs (printf `%s returns the identity of the check that %s.` $method .Statement))}}
{{- ""}}func (c {{$type}}) {{$method}}() conform.ID[{{$s}}] {
	return c.Check({{printf "%q" .Segment}})
}
{{- end}}
{{- end}}
{{- range $c.Derived}}
{{- if eq .Type $callable.Type}}

{{docs (wrapdocs (printf `%s returns the identity of the check that %s.` .Method .Statement))}}
{{- ""}}func (c {{$type}}) {{.Method}}() conform.ID[{{$s}}] {
	return c.Check({{printf "%q" .Segment}})
}
{{- end}}
{{- end}}
{{- range $c.Calls}}
{{- if eq .Type $callable.Type}}
{{- range suiteCeilings .Budget}}
{{- $method := suitePascal .}}

{{docs (wrapdocs (printf `%s returns the identity of the check %s/%s.` $method $callable.Name .))}}
{{- ""}}func (c {{$type}}) {{$method}}() conform.ID[{{$s}}] {
	return c.Check({{printf "%q" .}})
}
{{- end}}
{{- end}}
{{- end}}
{{- end}}

{{docs (wrapdocs (printf `%s returns the checks of %s, and the calls and the budgets of its callables.` $suite $c.Declaration))}}
{{- ""}}func {{$suite}}() conform.Suite[{{$s}}] {
	return conform.Suite[{{$s}}]{
		Declaration: {{printf "%q" $c.Declaration}},
{{- if or $c.Checks $c.Derived}}
		Checks: []conform.Check[{{$s}}]{
{{- range $c.Derived}}{{use "go.dokimi.dev/spec"}}{{use "go.dokimi.dev/conform/probe"}}
			{
				ID:          {{$checks}}{{with .Field}}.{{.}}{{end}}.{{.Method}}(),
				Statement:   {{printf "%q" .Statement}},
				Claim:       spec.{{.Claim}},
				Probe:       spec.{{.Probe}},
				Reason:      spec.{{.Reason}},
				Law:         spec.{{.Law}},
				Machineries: []spec.MachineryID{ {{- range $i, $m := .Machineries}}{{if $i}}, {{end}}spec.{{$m}}{{end -}} },
{{- if .Shallow}}
				Shallow:     true,
{{- end}}
{{- with .Entails}}
				Entails:     []conform.ID[{{$s}}]{ {{- range $i, $e := .}}{{if $i}}, {{end}}{{$checks}}{{with $e.Field}}.{{.}}{{end}}.{{$e.Method}}(){{end -}} },
{{- end}}
				Apply: func(h *{{$handle}}) {
					probe.{{.Probe}}(h{{range .Args}}, {{template "suite.arg" .}}{{end}})
				},
				Defect: {{suiteCamel .Defect}},
{{- if .Clock}}{{use "testing/synctest"}}
				Around: synctest.Test,
{{- end}}
			},
{{- end}}
{{- range $c.Checks}}
			{
				ID:        {{$checks}}{{with .Field}}.{{.}}{{end}}.{{suitePascal .Method}}(),
				Statement: {{printf "%q" .Statement}},
{{- if .Property}}
				Property:  {{spell .Apply}},
{{- else}}
				Apply:     {{spell .Apply}},
{{- end}}
				Defect:    {{spell .Defect}},
{{- with .Doors}}
				Doors:     conform.Doors[{{$s}}]{{"{"}}{{range $i, $d := .}}{{if $i}}, {{end}}{{$d.Field}}: {{spell $d.Func}}{{end}}{{"}"}},
{{- end}}
{{- with .Options}}
				Options:   {{spell .}},
{{- end}}
{{- with .Around}}
				Around:    {{spell .}},
{{- end}}
{{- if .Counted}}
				Counted:   true,
{{- end}}
			},
{{- end}}
		},
{{- end}}
{{- with $c.Calls}}
		Calls: []conform.Call[{{$s}}]{
{{- range .}}
			{
				Calls:    {{suiteCamel .Var}},
				Over:     {{$newOver}},
				Callable: {{$checks}}{{with .Field}}.{{.}}{{end}}.Callable,
{{- if or (suiteCeilings .Budget) .Budget.Warmup}}
				Budget:   {{template "suite.budget" .Budget}},
{{- end}}
{{- if .Concurrent}}
				Concurrent: true,
{{- end}}
{{- if .Waits}}
				Waits: true,
{{- end}}
			},
{{- end}}
		},
{{- end}}
{{- if or $c.Using $c.Starts $c.Generated $c.Variants $c.Streams $c.Readers $c.Constants $c.Dynamic $c.Errors}}
		Using: []prop.Option{
{{- range $c.Using}}
			prop.Using(prop.SampledFrom({{range $i, $m := .Members}}{{if $i}}, {{end}}{{value $m}}{{end}})),
{{- end}}
{{- range $c.Starts}}
			prop.Using({{suiteCamel .Name}}),
{{- end}}
{{- range $c.Generated}}
{{- if .Leaves}}
			prop.Using(prop.Recursive({{template "suite.basis" .}},
				func(prop.Generator[{{spell .Type}}]) prop.Generator[{{spell .Type}}] {
					return {{template "suite.generated" .}}
				}, prop.MaxLeaves({{.Leaves}}))),
{{- else}}
			prop.Using({{template "suite.generated" .}}),
{{- end}}
{{- end}}
{{- range $c.Variants}}
{{- $interface := spell .Type}}
			prop.Using(prop.OneOf(
{{- range .Members}}
				prop.Composite(func(c *prop.Case) {{$interface}} {
{{- if .Address}}
					v := c.Draw(prop.Of[{{spell .Type}}](), {{printf "%q" .Label}})
					return &v
{{- else}}
					return c.Draw(prop.Of[{{spell .Type}}](), {{printf "%q" .Label}})
{{- end}}
				}),
{{- end}}
			)),
{{- end}}
{{- range $c.Streams}}
			prop.Using(conform.Stream[{{spell .Type}}](prop.Of[{{spell .Elem}}]())),
{{- end}}
{{- range $c.Readers}}
			prop.Using(prop.Composite(func(c *prop.Case) {{spell .Type}} {
				return {{if .Wrap.Kind}}{{value .Wrap}}({{end}}conform.NewBytes(c.Draw(prop.Of[[]byte](), {{printf "%q" .Label}})){{if .Wrap.Kind}}){{end}}
			})),
{{- end}}
{{- range $c.Constants}}
			prop.Using(prop.Composite(func(*prop.Case) {{spell .Type}} { return {{value .Value}} })),
{{- end}}
{{- if $c.Dynamic}}
			prop.Using(prop.Composite(func(c *prop.Case) any {
				switch c.Draw(prop.Integer(0, 2), "any") {
				case 0:
					return c.Draw(prop.String(), "any.string")
				case 1:
					return c.Draw(prop.Of[int](), "any.int")
				}
				return c.Draw(prop.Boolean(), "any.bool")
			})),
{{- end}}
{{- if $c.Errors}}
			prop.Using(prop.SampledFrom[error](nil, conform.ErrGenerated)),
{{- end}}
		},
{{- end}}
{{- with $c.Sinks}}
		Sinks: []conform.Sink{
{{- range .}}
			conform.SinkOf[{{spell .}}](),
{{- end}}
		},
{{- end}}
	}
}
{{- if $c.Func}}

{{docs (wrapdocs (printf `%s applies the checks of %s, and the checks that opts add, to subject.` $run $c.Declaration))}}
{{- ""}}func {{$run}}(t *testing.T, subject {{$s}}, opts ...{{$option}}) {
	t.Helper()
	{{$fromHandle}}(t, {{$subjects}}(subject), opts...)
}

{{docs (wrapdocs (printf `%s applies the same checks to a subject that newSubject builds from the handle of each check.` $fromHandle))}}
{{- ""}}func {{$fromHandle}}(t *testing.T, newSubject func(h *{{$handle}}) {{$s}}, opts ...{{$option}}) {
	t.Helper()
	conform.Run(t, {{$suite}}(), newSubject, opts...)
}

{{docs (wrapdocs (printf `%s registers on f the fuzz target of the property checks of %s on subject.` $fuzz $c.Declaration))}}
{{- ""}}func {{$fuzz}}(f *testing.F, subject {{$s}}, opts ...{{$option}}) {
	f.Helper()
	conform.Fuzz(f, {{$suite}}(), {{$checks}}.Callable, {{$subjects}}(subject), opts...)
}

{{docs (wrapdocs (printf `%s applies the allocation ceiling of %s and its checks that count allocations, and the ceilings and the checks that opts add, to subject.` $budgets $c.Declaration))}}
{{- ""}}func {{$budgets}}(t *testing.T, subject {{$s}}, opts ...{{$option}}) {
	t.Helper()
	conform.RunBudgets(t, {{$suite}}(), {{$subjects}}(subject), opts...)
}

{{docs (wrapdocs (printf `%s measures subject under the ceilings of the budget of %s.` $bench $c.Declaration))}}
{{- ""}}func {{$bench}}(b conform.B, subject {{$s}}, opts ...{{$option}}) {
	b.Helper()
	conform.Bench(b, {{$suite}}(), {{$checks}}.Callable, {{$subjects}}(subject), opts...)
}

{{- if $n.BenchParallel}}

{{docs (wrapdocs (printf `%s measures subject on GOMAXPROCS goroutines at once, under the ceilings of the budget of %s.` $benchParallel $c.Declaration))}}
{{- ""}}func {{$benchParallel}}(b *testing.B, subject {{$s}}, opts ...{{$option}}) {
	b.Helper()
	conform.BenchParallel(b, {{$suite}}(), {{$checks}}.Callable, {{$subjects}}(subject), opts...)
}
{{- end}}

{{docs (wrapdocs (printf `%s returns the factory of the subjects of %s that returns subject for each handle.` $subjects $c.Declaration))}}
{{- ""}}func {{$subjects}}(subject {{$s}}) func(*{{$handle}}) {{$s}} {
	return func(*{{$handle}}) {{$s}} { return subject }
}
{{- else}}

{{docs (wrapdocs (printf `%s applies the checks of %s, and the checks that opts add, to a fresh subject of newSubject for each check.` $run $c.Declaration))}}
{{- ""}}func {{$run}}[T {{$s}}](t *testing.T, newSubject func() T, opts ...{{$option}}) {
	t.Helper()
	{{$fromHandle}}(t, func(*{{$handle}}) T { return newSubject() }, opts...)
}

{{docs (wrapdocs (printf `%s applies the same checks to a subject that newSubject builds from the handle of each check.` $fromHandle))}}
{{- ""}}func {{$fromHandle}}[T {{$s}}](t *testing.T, newSubject func(h *{{$handle}}) T, opts ...{{$option}}) {
	t.Helper()
	conform.Run(t, {{$suite}}(), {{$subjects}}(newSubject), opts...)
}

{{docs (wrapdocs (printf `%s registers on f the fuzz target of the property checks of callable, on a subject that newSubject builds from the handle of each case.` $fuzz))}}
{{- ""}}func {{$fuzz}}[T {{$s}}](f *testing.F, callable conform.Callable[{{$s}}], newSubject func(h *{{$handle}}) T, opts ...{{$option}}) {
	f.Helper()
	conform.Fuzz(f, {{$suite}}(), callable, {{$subjects}}(newSubject), opts...)
}

{{docs (wrapdocs (printf `%s applies the allocation ceilings of %s and its checks that count allocations, and the ceilings and the checks that opts add, to a fresh subject of newSubject for each case.` $budgets $c.Declaration))}}
{{- ""}}func {{$budgets}}[T {{$s}}](t *testing.T, newSubject func(h *{{$handle}}) T, opts ...{{$option}}) {
	t.Helper()
	conform.RunBudgets(t, {{$suite}}(), {{$subjects}}(newSubject), opts...)
}

{{docs (wrapdocs (printf `%s measures callable on a subject of newSubject, under the ceilings of its budget.` $bench))}}
{{- ""}}func {{$bench}}[T {{$s}}](b conform.B, callable conform.Callable[{{$s}}], newSubject func(h *{{$handle}}) T, opts ...{{$option}}) {
	b.Helper()
	conform.Bench(b, {{$suite}}(), callable, {{$subjects}}(newSubject), opts...)
}
{{- if $n.BenchParallel}}

{{docs (wrapdocs (printf `%s measures callable on a subject of newSubject on GOMAXPROCS goroutines at once, under the ceilings of its budget.` $benchParallel))}}
{{- ""}}func {{$benchParallel}}[T {{$s}}](b *testing.B, callable conform.Callable[{{$s}}], newSubject func(h *{{$handle}}) T, opts ...{{$option}}) {
	b.Helper()
	conform.BenchParallel(b, {{$suite}}(), callable, {{$subjects}}(newSubject), opts...)
}
{{- end}}

{{docs (wrapdocs (printf `%s returns the factory of the subjects of %s that calls newSubject with the handle of each check.` $subjects $c.Declaration))}}
{{- ""}}func {{$subjects}}[T {{$s}}](newSubject func(h *{{$handle}}) T) func(h *{{$handle}}) {{$s}} {
	return func(h *{{$handle}}) {{$s}} { return newSubject(h) }
}
{{- end}}
{{- range $c.Calls}}
{{- $name := $c.Declaration}}
{{- with .Field}}{{$name = printf "%s.%s" $c.Declaration .}}{{end}}
{{- $drawn := false}}
{{- $context := false}}
{{- range .Params}}
{{- if .Context}}{{$context = true}}
{{- else if .Sample}}
{{- else if or .Funcs .Input}}{{range .Funcs}}{{if .Results}}{{$drawn = true}}{{end}}{{end}}
{{- else if not .Omitted}}{{$drawn = true}}
{{- end}}
{{- end}}

{{docs (wrapdocs (printf `%s generates the calls of %s with the inputs that each case draws.` (suiteCamel .Var) $name))}}
{{- ""}}var {{suiteCamel .Var}} = prop.Composite(func({{if $drawn}}c {{end}}*prop.Case) func(context.Context, {{$s}}) error {
{{- range .Params}}
{{- if .Sample}}
	{{.Name}} := {{if .Variadic}}[]{{spell .Type}}{ {{- value .Sample -}} }{{else}}{{value .Sample}}{{end}}
{{- else if or .Funcs .Input}}
{{- range .Funcs}}{{template "suite.results" .}}{{end}}
{{- if .Input}}
	{{.Name}} := &{{suiteCamel .Input}}{
{{- range .Funcs}}
		{{suiteCamel .Field}}: {{template "suite.func" .}},
{{- end}}
	}
{{- else}}
	{{.Name}} := {{template "suite.func" (index .Funcs 0)}}
{{- end}}
{{- else if not (or .Context .Omitted)}}
	{{.Name}} := c.Draw({{if or .Variadic .Receive}}prop.List(prop.Of[{{spell .Type}}]()){{else}}prop.Of[{{spell .Type}}](){{end}}, {{printf "%q" .Label}})
{{- end}}
{{- end}}
	return func({{if $context}}ctx{{else}}_{{end}} context.Context, subject {{$s}}) error {
{{- if .Returns}}
		{{with .Assign}}{{.}} {{end}}{{template "suite.call" .}}
		return {{.Returns}}
{{- else}}
		return {{template "suite.call" .}}
{{- end}}
	}
})
{{- end}}
{{- range $c.Starts}}
{{- $start := suiteCamel .Name}}
{{- $doc := printf `%s generates the values of %s that keep or change each field of its starting value.` $start .Type.Spelling}}
{{- if .Whole}}{{$doc = printf `%s generates the values of %s that keep or change its starting value.` $start .Type.Spelling}}
{{- else if not .Fields}}{{$doc = printf `%s generates the starting value of %s, which has no field to change.` $start .Type.Spelling}}{{end}}

{{docs (wrapdocs $doc)}}
{{- ""}}var {{$start}} = prop.Composite(func({{if or .Whole .Fields}}c {{end}}*prop.Case) {{spell .Type}} {
{{- if .Whole}}
	changed := c.Draw(prop.Of[{{spell .Type}}](), {{printf "%q" .Label}})
	if c.Draw(prop.Boolean(), {{printf "%q" (printf "%s.changed" .Label)}}) {
		return changed
	}
	return {{value .Value}}
{{- else if not .Fields}}
	return {{if .Seed}}{{spell .Seed}}().Build(){{else}}{{value .Value}}{{end}}
{{- else}}
	changed := c.Draw(prop.Of[{{spell .Type}}](), {{printf "%q" .Label}})
{{- if .Seed}}
	value := {{spell .Seed}}().Build()
{{- else}}
	value := {{value .Value}}
{{- end}}
{{- range .Fields}}
	if c.Draw(prop.Boolean(), {{printf "%q" .Label}}) {
		value.{{.Name}} = changed.{{.Name}}
	}
{{- end}}
	return value
{{- end}}
})
{{- end}}
{{- range $c.Inputs}}
{{- $input := suiteCamel .Name}}
{{- $embedded := suiteCamel .Embedded}}

{{docs (wrapdocs (printf `%s is %s under the name of the field that %s embeds.` $embedded .Type.Spelling $input))}}
{{- ""}}type {{$embedded}} = {{spell .Type}}

{{docs (wrapdocs (printf `%s implements %s. Its methods return the results that the generators of the suite of %s draw for them, in turn.` $input .Type.Spelling $c.Declaration))}}
{{- ""}}type {{$input}} struct {
	{{$embedded}}
{{- range .Methods}}
	{{suiteCamel .Field}} func({{params .Method.Params}}){{results .Method.Returns}}
{{- end}}
}
{{- range .Methods}}
{{- $m := .Method}}

{{docs (wrapdocs (printf `%s calls the function of %s.` $m.Name $m.Name))}}
{{- ""}}func (in {{$input}}) {{$m.Name}}({{params $m.Params}}){{results $m.Returns}} {
	{{if $m.Returns.Len}}return {{end}}in.{{suiteCamel .Field}}({{range $i, $p := $m.Params.Items}}{{if $i}}, {{end}}{{$p.Name}}{{if $p.Variadic}}...{{end}}{{end}})
}
{{- end}}
{{- end}}
{{- with $n.Over}}
{{- $embedded := suiteCamel $n.Embedded}}

{{docs (wrapdocs (printf `%s is %s under the name of the field that %s embeds.` $embedded $s $over))}}
{{- ""}}type {{$embedded}} = {{$s}}

{{docs (wrapdocs (printf `%s is a subject of %s whose callables call spend and return their zero results. The planted defect of a ceiling passes a spend that exceeds the ceiling.` $over $c.Declaration))}}
{{- ""}}type {{$over}} struct {
	{{$embedded}}
	spend func()
}
{{- range $c.Calls}}
{{- with .Over}}

{{docs (wrapdocs (printf `%s calls spend and returns its zero results.` .Name))}}
{{- ""}}func (o {{$over}}) {{.Name}}({{params .Params}}){{results .Returns}} {
	o.spend()
{{- if .Returns.Len}}
	return
{{- end}}
}
{{- end}}
{{- end}}

{{docs (wrapdocs (printf `%s returns the planted defect of a ceiling of %s, whose callables call spend.` $newOver $c.Declaration))}}
{{- ""}}func {{$newOver}}(_ *{{$handle}}, spend func()) {{$s}} {
	return {{$over}}{spend: spend}
}
{{- else}}
{{- with $c.Func}}
{{- with (index $c.Calls 0).Over}}

{{docs (wrapdocs (printf `%s returns the planted defect of a ceiling of %s, which calls spend and returns its zero results.` $newOver $c.Declaration))}}
{{- ""}}func {{$newOver}}(_ *{{$handle}}, spend func()) {{$s}} {
	return func({{params .Params}}){{results .Returns}} {
		spend()
{{- if .Returns.Len}}
		return
{{- end}}
	}
}
{{- end}}
{{- end}}
{{- end}}
{{- range $c.Defects}}
{{- template "suite.defect" (suiteDefect . (suiteCamel $n.Embedded) $handle $s)}}
{{- end}}
{{- end}}
{{- end}}

{{- /*
suite.defect writes the planted defect of the derived checks with one break
of one callable: the type that embeds the subject type and overrides the
callable, with the function that wraps a fresh subject in it, or the function
of a function suite that wraps the fresh function.
*/}}
{{- define "suite.defect"}}
{{- $d := .Defect}}
{{- $new := suiteCamel $d.Name}}
{{- if $d.Type}}
{{- $type := suiteCamel $d.Type}}

{{docs (wrapdocs (printf `%s is the planted defect of %s.` $type $d.Doc))}}
{{- ""}}type {{$type}} struct {
	{{.Embedded}}
{{- if $d.Counts}}
	calls int
{{- end}}
{{- if eq $d.Body "slow"}}{{use "go.dokimi.dev/assert"}}
	clock assert.Clock
{{- end}}
}

{{docs (wrapdocs (printf `%s is the override of the planted defect.` $d.Method.Name))}}
{{- ""}}func ({{if or $d.Delegates $d.Counts}}d {{end}}*{{$type}}) {{$d.Method.Name}}({{params $d.Method.Params}}){{results $d.Method.Returns}} {
{{- template "suite.defect.body" (suiteBody $d (printf "d.%s.%s" .Embedded $d.Method.Name) "d.")}}
}
{{- with $d.Handle}}
{{- $handle := suiteCamel .Type}}

{{docs (wrapdocs (printf `%s is a handle whose %s returns its zero results and no error, also after its close.` $handle .Method.Name))}}
{{- ""}}type {{$handle}} struct {
	{{spell .Handled}}
}

{{docs (wrapdocs (printf `%s returns its zero results and no error.` .Method.Name))}}
{{- ""}}func ({{$handle}}) {{.Method.Name}}({{params .Method.Params}}){{results .Method.Returns}} {
	return
}
{{- end}}

{{docs (wrapdocs (printf `%s returns the planted defect of %s over a fresh subject.` $new $d.Doc))}}
{{- ""}}func {{$new}}(h *{{.Handle}}) {{.Subject}} {
	return &{{$type}}{ {{- .Embedded}}: h.Fresh(){{if eq $d.Body "slow"}}, clock: h.Clock(){{end -}} }
}
{{- else}}

{{docs (wrapdocs (printf `%s returns the planted defect of %s over the fresh function.` $new $d.Doc))}}
{{- ""}}func {{$new}}(h *{{.Handle}}) {{.Subject}} {
{{- if $d.Delegates}}
	fresh := h.Fresh()
{{- end}}
{{- if $d.Counts}}
	calls := 0
{{- end}}
{{- if eq $d.Body "slow"}}
	clock := h.Clock()
{{- end}}
	return func({{params $d.Method.Params}}){{results $d.Method.Returns}} {
{{- template "suite.defect.body" (suiteBody $d "fresh" "")}}
	}
}
{{- end}}
{{- end}}

{{- /*
suite.defect.body writes the body of the override of a planted defect. Call
is the call of the callable of the fresh subject, and State the prefix of the
counter and of the clock of the defect.
*/}}
{{- define "suite.defect.body"}}
{{- $d := .Defect}}
{{- $call := printf "%s(%s)" .Call (suiteJoin $d.Args)}}
{{- $all := suiteNames $d.Results}}
{{- if eq $d.Body "panic"}}
	panic({{printf "%q" (printf "the planted defect of %s" $d.Doc)}})
{{- else if eq $d.Body "panic-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		panic({{printf "%q" (printf "the planted defect of %s" $d.Doc)}})
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "zero"}}
	return
{{- else if eq $d.Body "zero-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "fail"}}
{{- template "suite.defect.fail" $d}}
	return
{{- else if eq $d.Body "fail-later"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
{{- template "suite.defect.fail" $d}}
		return
	}
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "fail-beside"}}
{{- template "suite.defect.samples" $d}}
{{- template "suite.defect.fail" $d}}
	return
{{- else if eq $d.Body "beside-false"}}
	{{$all}} = {{$call}}
	if !{{range $d.Results}}{{if eq .Role "flag"}}{{.Name}}{{end}}{{end}} {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "sample"}}
{{- template "suite.defect.samples" $d}}
	return
{{- else if eq $d.Body "drift"}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "descend"}}
	{{.State}}calls++
	if {{.State}}calls == 1 {
{{- template "suite.defect.samples" $d}}
	}
	return
{{- else if eq $d.Body "version-descend"}}
	{{.State}}calls++
{{- template "suite.defect.samples" $d}}
	if {{.State}}calls == 1 {
		r0.{{$d.Version}} = 1
	} else {
		r0.{{$d.Version}} = 0
	}
	return
{{- else if eq $d.Body "echo"}}
	r0 = p{{$d.Input}}
	return
{{- else if eq $d.Body "drain-twice"}}
	{{$all}} = {{$call}}
	if len(r0) > 0 {
		r0 = append(r0[:1:1], r0...)
	}
	return
{{- else if eq $d.Body "reorder"}}{{use "slices"}}
	{{$all}} = {{$call}}
	{{.State}}calls++
	if {{.State}}calls > 1 {
		slices.Reverse(r0)
	}
	return
{{- else if eq $d.Body "reverse"}}{{use "slices"}}
	{{$all}} = {{$call}}
	slices.Reverse(r0)
	return
{{- else if eq $d.Body "slow"}}{{use "time"}}
	{{.State}}clock.Sleep({{suiteDuration $d.Budget}})
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "lead"}}
	r0 = true
	return
{{- else if eq $d.Body "first-page"}}
	p{{$d.Input}} = *new({{spell (index $d.Method.Params.Items $d.Input).Type}})
	{{if $d.Results}}return {{end}}{{$call}}
{{- else if eq $d.Body "live-handle"}}
	{{$all}} = {{$call}}
	r0 = {{suiteCamel $d.Handle.Type}}{r0}
	return
{{- end}}
{{- end}}

{{- /*
suite.defect.fail sets the error of the results of a planted defect to the
error that the runtime generates, which no directive declares.
*/}}
{{- define "suite.defect.fail"}}
{{- range .Results}}{{if eq .Role "error"}}
	{{.Name}} = conform.ErrGenerated
{{- end}}{{end}}
{{- end}}

{{- /*
suite.defect.samples sets each value of the results of a planted defect to
its second sample.
*/}}
{{- define "suite.defect.samples"}}
{{- range .Results}}{{if eq .Role "value"}}
	{{.Name}} = {{template "suite.expr" .Sample}}
{{- end}}{{end}}
{{- end}}

{{- /*
suite.arg writes one argument of the probe of a derived check.
*/}}
{{- define "suite.arg"}}
{{- if .Closure}}{{template "suite.closure" .Closure}}
{{- else if .Expr}}{{template "suite.expr" .Expr}}
{{- else if .Projection}}func(v {{spell .Projection.Type}}) {{spell .Projection.Result}} { return v.{{.Projection.Field}} }
{{- else}}{{use "time"}}{{suiteDuration .Duration}}
{{- end}}
{{- end}}

{{- /*
suite.expr writes one expression of a derived check.
*/}}
{{- define "suite.expr"}}
{{- if .Value}}{{value .Value}}
{{- else if .Of}}({{template "suite.expr" .Of}}).{{.Select}}
{{- else if .Hook}}func({{range $i, $p := slice .Hook.Elems 0 .Hook.Split}}{{if $i}}, {{end}}_ {{spell $p}}{{end}}) { {{- .Name}}() }
{{- else if .Pair}}probe.Pair[{{spell (index .Pair.Types 0)}}, {{spell (index .Pair.Types 1)}}]{First: {{template "suite.expr" (index .Pair.Values 0)}}, Second: {{template "suite.expr" (index .Pair.Values 1)}}}
{{- else if .Name}}{{.Name}}
{{- else}}{{.Word}}
{{- end}}
{{- end}}

{{- /*
suite.closure writes a closure that a derived check passes to its probe. A
closure with assignments on its later calls counts its calls in a variable of
the function that returns it.
*/}}
{{- define "suite.closure"}}{{use "context"}}
{{- if .Later}}func() {{template "suite.closure.signature" .}} {
	calls := 0
	return {{end}}{{template "suite.closure.signature" .}} {
{{- if .Later}}
	calls++
{{- end}}
{{- range .Lets}}
	{{.Name}}{{if .Select}}.{{.Select}} ={{else}} :={{end}} {{template "suite.expr" .Value}}
{{- end}}
{{- with .Later}}
	if calls > 1 {
{{- range .}}
		{{.Name}}{{with .Select}}.{{.}}{{end}} = {{template "suite.expr" .Value}}
{{- end}}
	}
{{- end}}
{{- if .Stamps}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
	stamps := make([]{{spell (index .Returns 0)}}, 0, len(r0))
	for _, e := range r0 {
		stamps = append(stamps, e.{{.Stamps}})
	}
	return {{template "suite.exprs" .Results}}
{{- else if .Assign}}
	{{suiteJoin .Assign}} := {{template "suite.invoke" .}}
	return {{template "suite.exprs" .Results}}
{{- else if .Discard}}
	{{template "suite.invoke" .}}
	return {{template "suite.exprs" .Results}}
{{- else}}
	return {{template "suite.invoke" .}}
{{- end}}
}{{if .Later}}
}(){{end}}
{{- end}}

{{- /*
suite.closure.signature writes the signature of a closure: the context, its
parameter and its results.
*/}}
{{- define "suite.closure.signature"}}func(ctx context.Context{{with .Param}}, {{.Name}} {{if .Hook}}func(){{else if .Body}}probe.Act{{else}}{{spell .Type}}{{end}}{{end}}) {{template "suite.closure.returns" .}}
{{- end}}

{{- /*
suite.closure.returns writes the results of a closure.
*/}}
{{- define "suite.closure.returns"}}
{{- if and (not .Returns) .Error}}error
{{- else}}({{if .Pair}}probe.Pair[{{spell (index .Returns 0)}}, {{spell (index .Returns 1)}}]{{else}}{{range $i, $r := .Returns}}{{if $i}}, {{end}}{{if $.Stamps}}[]{{end}}{{spell $r}}{{end}}{{end}}{{if .Error}}, error{{end}}{{if .Flag}}, bool{{end}})
{{- end}}
{{- end}}

{{- /*
suite.invoke writes the call of a closure: the callable on the subject of the
handle, or on the receiver of the closure, with its arguments.
*/}}
{{- define "suite.invoke"}}
{{- with .Receiver}}{{template "suite.expr" .}}{{else}}h.Subject(){{end}}{{with .Method}}.{{.}}{{end}}({{template "suite.exprs" .Args}})
{{- end}}

{{- /*
suite.exprs writes a list of expressions, separated by commas.
*/}}
{{- define "suite.exprs"}}
{{- range $i, $e := .}}{{if $i}}, {{end}}{{template "suite.expr" $e}}{{end}}
{{- end}}

{{- /*
suite.budget writes a budget as a literal of conform.Budget, with a field on
a line of its own for each ceiling and for the warm-up that the budget
states.
*/}}
{{- define "suite.budget"}}conform.Budget{
{{- with .Allocs}}
	Allocs: new(uint64({{.}})),
{{- end}}
{{- with .Bytes}}
	Bytes: new(uint64({{.}})),
{{- end}}
{{- with .Latency}}{{use "time"}}
	Latency: {{suiteDuration .}},
{{- end}}
{{- with .Mean}}{{use "time"}}
	Mean: {{suiteDuration .}},
{{- end}}
{{- with .Warmup}}
	Warmup: new({{.}}),
{{- end}}
}
{{- end}}

{{- /*
suite.call writes the call of a callable on the subject of a call generator:
the method of an interface or a struct, or the function itself, with the
context of the call and the value that the generator draws for each other
parameter.
*/}}
{{- define "suite.call"}}subject{{with .Field}}.{{.}}{{end}}({{range $i, $p := .Params}}{{if not .Omitted}}{{if $i}}, {{end}}{{if .Context}}ctx{{else if .Address}}&{{.Name}}{{else if .Receive}}{{template "suite.channel" .}}{{else}}{{.Name}}{{if .Variadic}}...{{end}}{{end}}{{end}}{{end}}){{end}}

{{- /*
suite.channel writes a new channel of the drawn list of a parameter that the
callable receives from, with each value of the list in its buffer, closed.
Each call takes a channel of its own, because a call drains its channel.
*/}}
{{- define "suite.channel"}}func() <-chan {{spell .Type}} {
	ch := make(chan {{spell .Type}}, len({{.Name}}))
	for _, v := range {{.Name}} {
		ch <- v
	}
	close(ch)
	return ch
}(){{end}}

{{- /*
suite.generated writes the generator of the values of a function type or of
an interface at some depth of the inputs: the generated function of a value of
the function type, or the address of the implementation of the interface with
a generated function of each method. A struct of function fields is not
comparable, and its address is.
*/}}
{{- define "suite.generated"}}
{{- $drawn := false}}
{{- range .Funcs}}{{if .Results}}{{$drawn = true}}{{end}}{{end}}prop.Composite(func({{if $drawn}}c {{end}}*prop.Case) {{spell .Type}} {
{{- range .Funcs}}{{template "suite.results" .}}{{end}}
{{- if .Input}}
	return &{{suiteCamel .Input}}{
{{- range .Funcs}}
		{{suiteCamel .Field}}: {{template "suite.func" .}},
{{- end}}
	}
{{- else}}
	return {{template "suite.func" (index .Funcs 0)}}
{{- end}}
}){{end}}

{{- /*
suite.basis writes the generator of the base value of a recursive function
type or interface. A base whose functions return a channel takes the end
value of each channel result when the case draws it, and any other base is
one value.
*/}}
{{- define "suite.basis"}}
{{- $ends := false}}
{{- $sinks := false}}
{{- range .Funcs}}{{range .Results}}{{if .End}}{{$ends = true}}{{end}}{{if .Sink}}{{$sinks = true}}{{end}}{{end}}{{end}}
{{- if $ends}}prop.Composite(func({{if $sinks}}c {{end}}*prop.Case) {{spell .Type}} {
{{- range .Funcs}}{{template "suite.ends" .}}{{end}}
	return {{template "suite.base" .}}
}){{else}}prop.Just[{{spell .Type}}]({{template "suite.base" .}}){{end}}
{{- end}}

{{- /*
suite.base writes the base value of a recursive function type or interface:
the function, or the address of the implementation with a function of each
method, that returns its end values at once.
*/}}
{{- define "suite.base"}}
{{- if .Input}}&{{suiteCamel .Input}}{
{{- range .Funcs}}
	{{suiteCamel .Field}}: {{template "suite.end" .}},
{{- end}}
}{{else}}{{template "suite.end" (index .Funcs 0)}}{{end}}{{end}}

{{- /*
suite.end writes a function that returns its end values at once: the end
error of each error result, which is the first declared error of its method
or conform.ErrGenerated, the end value of each channel result, and the zero
value of any other result.
*/}}
{{- define "suite.end"}}func({{params .Signature.Params}}){{results .Signature.Returns}} {
{{- range .Results}}
{{- if .Error}}
	{{.Return}} = {{with .Errors}}{{value (index . 0)}}{{else}}conform.ErrGenerated{{end}}
{{- else if .End}}
	{{.Return}} = {{.End}}
{{- end}}
{{- end}}
{{- if .Signature.Returns.Len}}
	return
{{- end}}
}{{end}}

{{- /*
suite.results writes the draw of the list of each result of a generated
function, the end value of each channel result, and the counter of its
calls. Each list after the first has the length of the first, so the lists
hold the results of the same calls.
*/}}
{{- define "suite.results"}}
{{- $first := ""}}
{{- range $i, $r := .Results}}
{{- if $i}}
	{{.Name}} := c.Draw(prop.List({{template "suite.value" .}}, prop.MinSize(len({{$first}})), prop.MaxSize(len({{$first}}))), {{printf "%q" .Label}})
{{- else}}
{{- $first = .Name}}
	{{.Name}} := c.Draw(prop.List({{template "suite.value" .}}), {{printf "%q" .Label}})
{{- end}}
{{- end}}
{{- template "suite.ends" .}}
{{- with .Index}}{{use "sync/atomic"}}
	var {{.}} atomic.Int64
{{- end}}
{{- end}}

{{- /*
suite.ends writes the end value of each channel result of a generated
function: a closed channel without elements for a receive channel and a
channel of both directions, and the drawn sink of the test for a send
channel.
*/}}
{{- define "suite.ends"}}
{{- range .Results}}
{{- if .End}}
	{{.End}} := {{if .Sink}}c.Draw(prop.Of[{{spell .Type}}](), {{printf "%q" (printf "%s-end" .Label)}}){{else}}conform.Closed[{{spell .Type}}](){{end}}
{{- end}}
{{- end}}
{{- end}}

{{- /*
suite.value writes the generator of one value of a result of a generated
function. An error result takes nil and the declared errors of its method,
or conform.ErrGenerated without them.
*/}}
{{- define "suite.value"}}
{{- if .Error}}prop.SampledFrom[error](nil{{range .Errors}}, {{value .}}{{else}}, conform.ErrGenerated{{end}})
{{- else}}prop.Of[{{spell .Type}}](){{end}}
{{- end}}

{{- /*
suite.func writes a generated function, which returns the drawn results of
its calls in turn. After the last of them it returns its end values: the end
error of each error result, which is the first declared error of its method
or conform.ErrGenerated, the end value of each channel result, and the zero
value of any other result.
*/}}
{{- define "suite.func"}}func({{params .Signature.Params}}){{results .Signature.Returns}} {
{{- with .Index}}
		i := int({{.}}.Add(1) - 1)
		if i >= len({{(index $.Results 0).Name}}) {
{{- range $.Results}}
{{- if .Error}}
			{{.Return}} = {{with .Errors}}{{value (index . 0)}}{{else}}conform.ErrGenerated{{end}}
{{- else if .End}}
			{{.Return}} = {{.End}}
{{- end}}
{{- end}}
			return
		}
		return {{range $i, $r := $.Results}}{{if $i}},
			{{end}}{{$r.Name}}[i]{{end}}
	}
{{- else}}}
{{- end}}
{{- end}}
