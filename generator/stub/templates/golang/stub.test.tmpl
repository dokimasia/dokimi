{{- range .Records}}
{{- $t := .Decl}}
{{- $c := .Data}}
{{- $stub := $c.Double}}
{{- $iface := $c.Subject}}
{{- $tp := typeparams $t.TypeParams}}
{{- $ta := typeargs $t.TypeParams}}
{{- if and $c.Generic (not $c.Witnesses)}}

{{docs (wrapdocs (printf `%s is generic, and its type parameters have no witnesses, so the file has no
checks of it. A test in the package of a consumer instantiates it.` $stub))}}
{{- else if $c.Methods}}
{{- use "testing"}}{{use "time"}}{{use "math/rand/v2"}}{{use "go.dokimi.dev/assert"}}{{use "go.dokimi.dev/stub"}}
{{- $new := spell (stubRef $t (printf "New%s" $stub))}}
{{- $double := spell (stubRef $t $stub)}}
{{- $strict := spell (stubRef $t (printf "%sStrict" $stub))}}
{{- $clock := spell (stubRef $t (printf "%sWithClock" $stub))}}
{{- $alias := printf "%sInstance" (stubCamel $stub)}}
{{- $instance := printf "%sInstanceOf" (stubCamel $stub)}}
{{- $first := index $c.Methods 0}}
{{- $instanceOf := printf "stub.Instance[%s%s]" (spell (stubRef $t $first.Call)) $ta}}
{{- range $i, $m := $c.Methods}}
{{- $site := stubSite $t $c.Methods $i}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}
{{- if $m.Params}}

{{docs (wrapdocs (printf `%sArgs returns the samples of the arguments of %s.` $helper $m.Name))}}
{{- ""}}func {{$helper}}Args{{$tp}}(tb assert.TB){{template "stub.argresults" $m}} {
	tb.Helper()
{{- range $j, $p := $m.Params}}
{{- if $p.Context}}
	a{{$j}} := assert.Context(tb)
{{- else}}
	var a{{$j}} {{if $p.Variadic}}[]{{end}}{{spell $p.Type}}
{{- end}}
{{- end}}
{{if ge $m.Args 0}}{{memberbody (index $site.Test.Methods.Items $m.Args)}}{{end -}}
	return {{template "stub.argnames" $m}}
}
{{- end}}

{{docs (wrapdocs (printf `%s calls %s of s with the samples of its arguments.` $helper $m.Name))}}
{{- ""}}func {{$helper}}{{$tp}}(tb assert.TB, s *{{$double}}{{$ta}}){{template "stub.testresults" $m}} {
	tb.Helper()
{{- if $m.Params}}
	{{template "stub.argnames" $m}} := {{$helper}}Args{{$ta}}(tb)
{{- end}}
	{{if $m.Returns}}return {{end}}s.{{$m.Name}}({{template "stub.testcall" $m}})
}
{{- if or $m.Pinnable (ge $m.Err 0)}}
{{- if ge $m.Err 0}}{{use "errors"}}{{end}}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `%sPins returns the samples of the results of %s, with a new error as its
error result.` $helper $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `%sPins returns the samples of the results of %s.` $helper $m.Name))}}
{{- end}}
{{- ""}}func {{$helper}}Pins{{$tp}}(){{template "stub.testresults" $m}} {
{{- range $j, $r := $m.Returns}}
{{- if $r.Error}}
	want{{$j}} := errors.New("{{$m.Name}}-returns")
{{- else}}
	var want{{$j}} {{spell $r.Type}}
{{- end}}
{{- end}}
{{if ge $m.Pins 0}}{{memberbody (index $site.Test.Methods.Items $m.Pins)}}{{end -}}
	return {{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}}
}
{{- end}}
{{- end}}
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}
{{- $call := spell (stubRef $t $m.Call)}}
{{- $ret := "struct{}"}}{{if $m.Returns}}{{$ret = printf "%s%s" (spell (stubRef $t $m.Return)) $ta}}{{end}}

{{docs (wrapdocs (printf `%sSubject returns the subject of [stub.Behaviour] for %s. The subject
calls a new double that reports to tb.` $helper $m.Name))}}
{{- ""}}func {{$helper}}Subject{{$tp}}(tb assert.TB) stub.Subject[{{$call}}{{$ta}}, {{$ret}}] {
	tb.Helper()
	s := {{$new}}{{$ta}}(tb)
	return stub.Subject[{{$call}}{{$ta}}, {{$ret}}]{
		Stub: s.{{$m.Field}}.MethodStub,
		Call: func() {
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(tb, s)
		},
{{- if $m.Returns}}
		Result: func() {{$ret}} {
			{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}got{{$j}}{{end}} := {{$helper}}{{$ta}}(tb, s)
			return {{$ret}}{{"{"}}{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Field}}: got{{$j}}{{end}}{{"}"}}
		},
{{- end}}
{{- if $m.Defaulted}}
		Default: func() {{$ret}} {
{{- range $r := $m.Returns}}{{with $r.Default}}
			{{$r.Local}} := {{spell (stubRef $t .Ref)}}{{typeargs .Args}}().Build()
{{- end}}{{end}}
			return {{$ret}}{{"{"}}{{template "stub.testdefaults" $m}}{{"}"}}
		},
{{- end}}
		Override: func(mark func()) {
			s.{{$m.Field}}.Func(func({{template "stub.testfuncparams" $m}}){{template "stub.testresults" $m}} {
				mark()
{{- template "stub.zeros" $m}}
			})
		},
{{- if ge $m.Err 0}}
		Fails: func() error {
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(tb, s)
			return {{(index $m.Returns $m.Err).Local}}
		},
{{- end}}
	}
}
{{- end}}
{{- $helper0 := printf "%s%s" (stubCamel $stub) $first.Name}}

{{docs (wrapdocs (printf `%s is the instance of a %s that the checks of the constructors and the
options drive.` $alias $double))}}
{{- ""}}type {{$alias}}{{$tp}} = {{$instanceOf}}

{{docs (wrapdocs (printf `%s returns the instance of s. The options apply to the whole double, so the
checks call %s alone.` $instance $first.Name))}}
{{- ""}}func {{$instance}}{{$tp}}(tb assert.TB, s *{{$double}}{{$ta}}) {{$alias}}{{$ta}} {
	tb.Helper()
	return {{$alias}}{{$ta}}{
		Stub: s.{{$first.Field}}.MethodStub,
		Call: func() {
			{{template "stub.blanks" $first}}{{$helper0}}{{$ta}}(tb, s)
		},
		Reset: s.ResetCalls,
	}
}

{{if $c.Witnesses -}}
{{docs (wrapdocs (printf `check%s checks the methods, the constructors and the options of the double
%s at its type parameters.` $stub $stub))}}
{{- ""}}func check{{$stub}}{{$tp}}(t *testing.T) {
	t.Helper()
{{- else -}}
{{docs (wrapdocs (printf `Test%s checks the methods, the constructors and the options of the double
%s.` $stub $stub))}}
{{- ""}}func Test{{$stub}}(t *testing.T) {
	t.Parallel()
{{- end}}
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}
{{- $call := spell (stubRef $t $m.Call)}}
{{- $check := "assert"}}{{if gt (len $m.Params) 1}}{{$check = "expect"}}{{use "go.dokimi.dev/assert/expect"}}{{end}}

	t.Run("{{$m.Name}}", func(t *testing.T) {
		t.Parallel()
		stub.Behaviour(t, "{{$m.Name}}", {{$helper}}Subject{{$ta}})
{{- if $m.Params}}

		t.Run("records the arguments of the call", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			got := s.{{$m.Field}}.AssertCalledOnce(t, "{{$m.Name}} records the call")
			{{template "stub.argnames" $m}} := {{$helper}}Args{{$ta}}(t)
{{- range $j, $p := $m.Params}}
			{{$check}}.Equal(t, got.{{$p.Field}}, a{{$j}}, "the call records {{$p.Field}}"{{if $p.Context}}, {{$check}}.ByIdentity(){{end}})
{{- end}}
		})
{{- end}}

		t.Run("runs the OnRecord hook once for each call", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			var seen []{{$call}}{{$ta}}
			s.{{$m.Field}}.OnRecord(func(c {{$call}}{{$ta}}) { seen = append(seen, c) })
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			assert.Length(t, seen, 2, "OnRecord runs once for each call of {{$m.Name}}")
		})
	})
{{- end}}

	t.Run("ResetCalls", func(t *testing.T) {
		t.Parallel()
		stub.ResetBehaviour(t, func(tb assert.TB) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb))
		})
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

		t.Run("clears the recorded calls of {{$m.Name}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			s.ResetCalls()
			assert.Equal(t, s.{{$m.Field}}.CallCount(), 0, "ResetCalls clears the calls of {{$m.Name}}")
		})
{{- if or $m.Pinnable (ge $m.Err 0)}}
{{- $check := "assert"}}{{if gt $m.Checked 1}}{{$check = "expect"}}{{use "go.dokimi.dev/assert/expect"}}{{end}}

		t.Run("keeps the results of Returns of {{$m.Name}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}} := {{$helper}}Pins{{$ta}}()
			s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
			s.ResetCalls()
			{{template "stub.checked" $m}} := {{$helper}}{{$ta}}(t, s)
{{- range $j, $r := $m.Returns}}
{{- if $r.Pinned}}
			{{$check}}.Equal(t, got{{$j}}, want{{$j}}, "ResetCalls keeps the {{$r.Field}} of {{$m.Name}}")
{{- else if $r.Error}}
			{{$check}}.ErrorIs(t, got{{$j}}, want{{$j}}, "ResetCalls keeps the error of {{$m.Name}}")
{{- end}}
{{- end}}
		})
{{- end}}
{{- end}}
	})

	t.Run("New{{$stub}}Delayed", func(t *testing.T) {
		t.Parallel()
		stub.LatencyBehaviour(t, func(tb assert.TB, d time.Duration, clk assert.Clock) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{spell (stubRef $t (printf "New%sDelayed" $stub))}}{{$ta}}(tb, d, clk))
		})
	})
{{- if $c.Fallible}}{{use "errors"}}

	t.Run("New{{$stub}}Failing", func(t *testing.T) {
		t.Parallel()
{{- range $i, $m := $c.Methods}}
{{- if ge $m.Err 0}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

		t.Run("fails {{$m.Name}} with its error", func(t *testing.T) {
			t.Parallel()
			want := errors.New("{{$m.Name}}-failing")
			s := {{spell (stubRef $t (printf "New%sFailing" $stub))}}{{$ta}}(t, want)
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "{{$m.Name}} fails with the error of New{{$stub}}Failing")
		})
{{- end}}
{{- end}}
	})
{{- end}}

	t.Run("{{$stub}}Strict", func(t *testing.T) {
		t.Parallel()
		stub.StrictBehaviour(t, func(tb assert.TB) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb, {{$strict}}{{$ta}}()))
		})
{{- range $i, $m := $c.Methods}}
{{- with $m.After}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

		t.Run("refuses {{$m.Name}} before {{.}}", func(t *testing.T) {
			t.Parallel()
			r := assert.NewRecorder()
			fn := func({{template "stub.testfuncparams" $m}}){{template "stub.testresults" $m}} {
{{- template "stub.zeros" $m}}
			}
			s := {{$new}}{{$ta}}(r, {{$strict}}{{$ta}}(), {{spell (stubRef $t (printf "With%s%s" $iface $m.Name))}}{{$ta}}(fn))
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			assert.True(t, r.Failed(), "a strict double refuses {{$m.Name}} before {{.}}")
		})
{{- end}}
{{- end}}
	})
{{- $delegate := spell (stubRef $t (printf "%sDelegateTo" $stub))}}

	t.Run("{{$stub}}DelegateTo", func(t *testing.T) {
		t.Parallel()
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

		t.Run("passes {{$m.Name}} to the implementation", func(t *testing.T) {
			t.Parallel()
			inner := {{$new}}{{$ta}}(t)
			s := {{$new}}{{$ta}}(t, {{$delegate}}{{$ta}}(inner))
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			inner.{{$m.Field}}.AssertCalledOnce(t, "{{$m.Name}} calls the implementation")
		})
{{- if ge $m.Err 0}}{{use "errors"}}

		t.Run("fails {{$m.Name}} with the error of the implementation", func(t *testing.T) {
			t.Parallel()
			want := errors.New("{{$m.Name}}-delegate")
			inner := {{$new}}{{$ta}}(t)
			inner.{{$m.Field}}.Faults(want, 1)
			s := {{$new}}{{$ta}}(t, {{$delegate}}{{$ta}}(inner))
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "{{$m.Name}} fails with the error of the implementation")
		})
{{- end}}
{{- end}}
	})

	t.Run("{{$stub}}WithClock", func(t *testing.T) {
		t.Parallel()
		stub.ClockBehaviour(t, func(tb assert.TB, clk assert.Clock) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb, {{$clock}}{{$ta}}(clk)))
		})
	})

	t.Run("{{$stub}}WithRandSource", func(t *testing.T) {
		t.Parallel()
		stub.RandSourceBehaviour(t, func(tb assert.TB, src rand.Source) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sWithRandSource" $stub))}}{{$ta}}(src)))
		})
	})

	t.Run("{{$stub}}BenchMode", func(t *testing.T) {
		t.Parallel()
		stub.BenchModeBehaviour(t, func(tb assert.TB) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb, {{spell (stubRef $t (printf "%sBenchMode" $stub))}}{{$ta}}()))
		})
	})

	t.Run("{{$stub}}WithLatency", func(t *testing.T) {
		t.Parallel()
		stub.LatencyBehaviour(t, func(tb assert.TB, d time.Duration, clk assert.Clock) {{$alias}}{{$ta}} {
			return {{$instance}}{{$ta}}(tb, {{$new}}{{$ta}}(tb, {{$clock}}{{$ta}}(clk), {{spell (stubRef $t (printf "%sWithLatency" $stub))}}{{$ta}}(d)))
		})
	})
{{- if $c.Fallible}}

	t.Run("{{$stub}}Failing", func(t *testing.T) {
		t.Parallel()
{{- range $i, $m := $c.Methods}}
{{- if ge $m.Err 0}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

		t.Run("fails {{$m.Name}} with its error", func(t *testing.T) {
			t.Parallel()
			want := errors.New("{{$m.Name}}-failing")
			s := {{$new}}{{$ta}}(t, {{spell (stubRef $t (printf "%sFailing" $stub))}}{{$ta}}(want))
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "{{$m.Name}} fails with the error of {{$stub}}Failing")
		})
{{- end}}
{{- end}}
	})
{{- end}}
{{- range $i, $m := $c.Methods}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

	t.Run("With{{$iface}}{{$m.Name}}", func(t *testing.T) {
		t.Parallel()

		t.Run("sets the function of {{$m.Name}}", func(t *testing.T) {
			t.Parallel()
			called := false
			s := {{$new}}(t, {{spell (stubRef $t (printf "With%s%s" $iface $m.Name))}}{{$ta}}(func({{template "stub.testfuncparams" $m}}){{template "stub.testresults" $m}} {
				called = true
{{- template "stub.zeros" $m}}
			}))
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			assert.True(t, called, "With{{$iface}}{{$m.Name}} sets the function of {{$m.Name}}")
		})
	})
{{- end}}
}
{{- range $i, $m := $c.Methods}}
{{- if or $m.Returns $m.Params}}
{{- $helper := printf "%s%s" (stubCamel $stub) $m.Name}}

{{if $c.Witnesses -}}
{{docs (wrapdocs (printf `check%s checks the methods of %s, which configures %s, at the type
parameters of the double.` $m.Stub $m.Stub $m.Name))}}
{{- ""}}func check{{$m.Stub}}{{$tp}}(t *testing.T) {
	t.Helper()
{{- else -}}
{{docs (wrapdocs (printf `Test%s checks the methods of %s, which configures %s.` $m.Stub $m.Stub $m.Name))}}
{{- ""}}func Test{{$m.Stub}}(t *testing.T) {
	t.Parallel()
{{- end}}
{{- if $m.Returns}}

	t.Run("Returns", func(t *testing.T) {
		t.Parallel()
{{- if or $m.Pinnable (ge $m.Err 0)}}
{{- $check := "assert"}}{{if gt $m.Checked 1}}{{$check = "expect"}}{{use "go.dokimi.dev/assert/expect"}}{{end}}

		t.Run("sets the results of each call of {{$m.Name}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}} := {{$helper}}Pins{{$ta}}()
{{- range $j, $r := $m.Returns}}
{{- if and $r.Pinned $r.Default}}
			assert.NotEqual(t, want{{$j}}, {{$helper}}Subject{{$ta}}(t).Default().{{$r.Field}},
				"the sample of {{$r.Field}} differs from its default result")
{{- end}}
{{- end}}
			s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
			{{template "stub.checked" $m}} := {{$helper}}{{$ta}}(t, s)
{{- range $j, $r := $m.Returns}}
{{- if $r.Pinned}}
			{{$check}}.Equal(t, got{{$j}}, want{{$j}}, "{{$m.Name}} returns the {{$r.Field}} that Returns sets")
{{- else if $r.Error}}
			{{$check}}.ErrorIs(t, got{{$j}}, want{{$j}}, "{{$m.Name}} returns the error that Returns sets")
{{- end}}
{{- end}}
		})
{{- end}}

		t.Run("configures {{$m.Name}} for strict mode", func(t *testing.T) {
			t.Parallel()
			r := assert.NewRecorder()
			s := {{$new}}{{$ta}}(r)
			s.{{$m.Field}}.Strict()
{{- range $j, $r := $m.Returns}}
			var want{{$j}} {{spell $r.Type}}
{{- end}}
			s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			assert.False(t, r.Failed(), "strict mode accepts the call of {{$m.Name}}")
		})
	})
{{- end}}
{{- if $m.Params}}
{{- $check := "assert"}}{{if gt (len $m.Params) 1}}{{$check = "expect"}}{{use "go.dokimi.dev/assert/expect"}}{{end}}

	t.Run("Func", func(t *testing.T) {
		t.Parallel()

		t.Run("passes the arguments of each call of {{$m.Name}} to the function", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
{{- range $j, $p := $m.Params}}
			var got{{$j}} {{if $p.Variadic}}[]{{end}}{{spell $p.Type}}
{{- end}}
			s.{{$m.Field}}.Func(func({{template "stub.funcparams" $m}}){{template "stub.testresults" $m}} {
				{{range $j, $p := $m.Params}}{{if $j}}, {{end}}got{{$j}}{{end}} = {{range $j, $p := $m.Params}}{{if $j}}, {{end}}p{{$j}}{{end}}
{{- template "stub.zeros" $m}}
			})
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			{{template "stub.argnames" $m}} := {{$helper}}Args{{$ta}}(t)
{{- range $j, $p := $m.Params}}
			{{$check}}.Equal(t, got{{$j}}, a{{$j}}, "the function receives {{$p.Field}}"{{if $p.Context}}, {{$check}}.ByIdentity(){{end}})
{{- end}}
		})
	})
{{- end}}
{{- with $q := $m.Sequence}}

	t.Run("Yields", func(t *testing.T) {
		t.Parallel()

		t.Run("yields each item", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			var want {{spell $q.Elem}}
			s.{{$m.Field}}.Yields(want, want)
			got0 := {{$helper}}{{$ta}}(t, s)
			seen := 0
			for range got0 {
				seen++
			}
			assert.Equal(t, seen, 2, "{{$m.Name}} yields each item")
		})

		t.Run("stops yielding when the caller breaks", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			var want {{spell $q.Elem}}
			s.{{$m.Field}}.Yields(want, want, want)
			got0 := {{$helper}}{{$ta}}(t, s)
			seen := 0
			for range got0 {
				seen++
				break
			}
			assert.Equal(t, seen, 1, "{{$m.Name}} stops when the caller breaks")
		})
	})
{{- if $q.Errors}}{{use "errors"}}

	t.Run("YieldsError", func(t *testing.T) {
		t.Parallel()

		t.Run("yields the error after the items", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			var item {{spell $q.Elem}}
			want := errors.New("{{$m.Name}}-yields")
			s.{{$m.Field}}.YieldsError([]{{spell $q.Elem}}{item, item}, want)
			got0 := {{$helper}}{{$ta}}(t, s)
			seen := 0
			var last error
			for _, err := range got0 {
				if err != nil {
					last = err
					break
				}
				seen++
			}
			assert.Equal(t, seen, 2, "{{$m.Name}} yields each item before the error")
			assert.ErrorIs(t, last, want, "{{$m.Name}} ends with the error of YieldsError")
		})

		t.Run("stops the sequence when the caller breaks", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			var item {{spell $q.Elem}}
			s.{{$m.Field}}.YieldsError([]{{spell $q.Elem}}{item, item, item}, errors.New("{{$m.Name}}-yields"))
			got0 := {{$helper}}{{$ta}}(t, s)
			seen := 0
			for range got0 {
				seen++
				break
			}
			assert.Equal(t, seen, 1, "{{$m.Name}} stops when the caller breaks")
		})
	})
{{- end}}
{{- end}}
{{- if ge $m.Err 0}}
{{- $err := (index $m.Returns $m.Err).Local}}
{{- range $f := $m.Errors}}

	t.Run("{{$f.Helper}}", func(t *testing.T) {
		t.Parallel()

		t.Run("fails the next call of {{$m.Name}} with {{$f.Name}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			s.{{$m.Field}}.{{$f.Helper}}()
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.ErrorIs(t, {{$err}}, {{value $f.Value}}, "the next call of {{$m.Name}} fails with {{$f.Name}}")
		})

		t.Run("spares the call after the failed call", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			s.{{$m.Field}}.{{$f.Helper}}()
			{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.NoError(t, {{$err}}, "the call of {{$m.Name}} after the failed call succeeds")
		})
	})
{{- end}}
{{- if $m.Retry}}{{use "errors"}}

	t.Run("RetrySchedule", func(t *testing.T) {
		t.Parallel()

		t.Run("fails each call of {{$m.Name}} before call {{$m.Retry}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			want := errors.New("{{$m.Name}}-retry")
			s.{{$m.Field}}.RetrySchedule(want)
			for attempt := 1; attempt < {{$m.Retry}}; attempt++ {
				{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
				assert.ErrorIs(t, {{$err}}, want, "a call of {{$m.Name}} before call {{$m.Retry}} fails")
			}
		})

		t.Run("spares call {{$m.Retry}} of {{$m.Name}}", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			s.{{$m.Field}}.RetrySchedule(errors.New("{{$m.Name}}-retry"))
			for attempt := 1; attempt < {{$m.Retry}}; attempt++ {
				{{template "stub.blanks" $m}}{{$helper}}{{$ta}}(t, s)
			}
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.NoError(t, {{$err}}, "call {{$m.Retry}} of {{$m.Name}} succeeds")
		})
	})
{{- end}}
{{- if ge $m.Partition 0}}{{use "errors"}}

	t.Run("FaultForPartition", func(t *testing.T) {
		t.Parallel()

		t.Run("fails a call of {{$m.Name}} in the partition of the key", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{template "stub.argkey" $m}} := {{$helper}}Args{{$ta}}(t)
			want := errors.New("{{$m.Name}}-partition")
			s.{{$m.Field}}.FaultForPartition(key, want, 1)
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.ErrorIs(t, {{$err}}, want, "a call in the partition of the key fails")
		})
	})

	t.Run("FaultForOtherPartitions", func(t *testing.T) {
		t.Parallel()

		t.Run("spares a call of {{$m.Name}} in the partition of the key", func(t *testing.T) {
			t.Parallel()
			s := {{$new}}{{$ta}}(t)
			{{template "stub.argkey" $m}} := {{$helper}}Args{{$ta}}(t)
			s.{{$m.Field}}.FaultForOtherPartitions(key, errors.New("{{$m.Name}}-partition"), 1)
			{{template "stub.fails" $m}} := {{$helper}}{{$ta}}(t, s)
			assert.NoError(t, {{$err}}, "a call in the partition of the key succeeds")
		})
	})
{{- end}}
{{- end}}
}
{{- end}}
{{- end}}
