{{- $testing := import "testing"}}{{$sim := import "go.dokimi.dev/sim"}}
{{- range .Records}}
{{- $d := .Decl}}
{{- $c := .Data}}
{{- $simulation := spell (simField $d "simulation")}}
{{- $of := $c.Machine}}{{if $c.Components}}{{$of = printf "the system %s" $c.Machine}}{{end}}

{{docs (wrapdocs (printf `TestSimulation runs the simulation of %s over random runs and the crash points of each scenario.` $of))}}
{{- ""}}func TestSimulation(t *{{$testing}}.T) {
{{- if not $c.Serial}}
	t.Parallel()
{{end}}
	{{$sim}}.Test(t, {{$simulation}}())
}
{{- if $c.Components}}

{{docs (wrapdocs (printf `TestSimulationFalsify proves each invariant of the simulation of %s on its planted defect.` $of))}}
{{- else}}

{{docs (wrapdocs (printf `TestSimulationFalsify proves each rule of a runtime and each invariant of the simulation of %s on its planted defect.` $of))}}
{{- end}}
{{- ""}}func TestSimulationFalsify(t *{{$testing}}.T) {
{{- if not $c.Serial}}
	t.Parallel()
{{end}}
	{{$sim}}.Falsify(t, {{$simulation}}())
}

{{docs (wrapdocs (printf `FuzzSimulation takes the choices of a run of the simulation of %s from the input of the fuzz target.` $of))}}
{{- ""}}func FuzzSimulation(f *{{$testing}}.F) {
	{{$sim}}.Fuzz(f, {{$simulation}}())
}
{{- end}}
