{{- range .Records}}
{{- $m := .Data}}
{{- $t := spell $m.Type}}
{{- $e := spellvalue $m.Type}}
{{- $n := $m.Names}}
{{- if $m.Generate.Render}}

/**
 * {{$n.Render}} returns the text of value. A value outside the declared set
 * renders as its own value.
 */
export function {{$n.Render}}(value: {{$t}}): string {
  switch (value) {
{{- range $m.Variants}}
    case {{$e}}{{.Member}}:
      return {{.Text}};
{{- end}}
  }
{{- if $m.Textual}}
  return String(value);
{{- else}}
  return `{{$m.Subject}}(${String(value)})`;
{{- end}}
}
{{- end}}
{{- if $m.Generate.Error}}

/** {{$n.Sentinel}} is the error of a text that does not match a declared variant of {{$m.Subject}}. */
export class {{$n.Sentinel}} extends Error {
  /** text is the text that does not match a declared variant. */
  readonly text: string;

  /** Creates the error of a text that does not match a declared variant. */
  constructor(text: string) {
    super(`{{$m.Package}}: unknown {{$m.Subject}} value ${JSON.stringify(text)}`);
    this.name = "{{$n.Sentinel}}";
    this.text = text;
  }
}
{{- end}}
{{- if $m.Generate.Parse}}
{{- $error := $n.Sentinel}}
{{- if $m.ErrorRef}}{{$error = spellvalue $m.ErrorRef}}{{end}}

{{docs (wrapdocs (printf `%s returns the variant of %s whose text is text. It is the inverse of
%s on the declared variants.

@throws %s for a text that does not match a declared variant.` $n.Parse $m.Subject $n.Render $n.Sentinel))}}
{{- ""}}export function {{$n.Parse}}(text: string): {{$t}} {
  switch (text) {
{{- range $m.Variants}}
    case {{.Text}}:
      return {{$e}}{{.Member}};
{{- end}}
  }
  throw new {{$error}}(text);
}
{{- end}}
{{- if $m.Generate.Values}}

/**
 * {{$n.Values}} returns the declared variants in the order of their
 * declaration. Each call returns a new array.
 */
export function {{$n.Values}}(): {{$t}}[] {
  return [
{{- range $m.Variants}}
    {{$e}}{{.Member}},
{{- end}}
  ];
}
{{- end}}
{{- if $m.Generate.Valid}}

/**
 * {{$n.Valid}} reports whether value is a declared variant of {{$m.Subject}}.
 * A cast can make any other value.
 */
export function {{$n.Valid}}(value: unknown): value is {{$t}} {
  switch (value) {
{{- range $m.Variants}}
    case {{$e}}{{.Member}}:
{{- end}}
      return true;
  }
  return false;
}
{{- end}}
{{- end}}
