{{docs (wrapdocs (printf `%s returns the operations of the world of %s in the case c, over the pools of the keys that c chooses.` (suiteCamel $w.Operations) .Declaration))}}
{{- ""}}func {{suiteCamel $w.Operations}}(c *{{$prop}}.Case) []{{$probe}}.Operation[{{$s}}] {
{{- range $q.Pools}}
	{{.Name}} := {{$probe}}.NewPool(c, {{$prop}}.List({{$prop}}.Of[{{spell .Type}}](), {{$prop}}.Unique(), {{$prop}}.MinSize(1), {{$prop}}.MaxSize(3)), {{printf "%q" .Label}})
{{- end}}
