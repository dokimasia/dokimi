{{- range .Records}}
{{- $t := .Decl}}
{{- $c := .Data}}
{{- $stub := $c.Double}}
{{- $iface := $c.Subject}}
{{- $tp := typeparams $t.TypeParams}}
{{- $ta := typeargs $t.TypeParams}}
{{- if and $c.Generic (not $c.Witnesses)}}

{{docs (wrapdocs (printf `Skipped: %s is generic — instantiate it with concrete types and
write the checks in the consuming package.` $stub))}}
{{- else}}
{{- use "testing"}}{{use "go.dokimi.dev/assert"}}{{use "go.dokimi.dev/dokimi-go/stub"}}
{{- $new := spell (stubRef $t (printf "New%s" $stub))}}
{{- $double := spell (stubRef $t $stub)}}
{{- range $i, $m := $c.Methods}}
{{- $site := stubSite $t $c.Methods $i}}
{{- $call := spell (stubRef $t $m.Call)}}
{{- $ret := "struct{}"}}{{if $m.Returns}}{{$ret = printf "%s%s" (spell (stubRef $t $m.Return)) $ta}}{{end}}

{{docs (wrapdocs (printf `%s%sSubject binds %s into the shape
[stub.Behaviour] drives: how to call it, what it answers with, and how to
override it.

Each call builds a fresh double: several checks assert on failure and
need one bound to a failable TB rather than to the running test.` (stubCamel $stub) $m.Name $m.Name))}}
{{- ""}}func {{stubCamel $stub}}{{$m.Name}}Subject{{$tp}}(tb assert.TB) stub.Subject[{{$call}}{{$ta}}, {{$ret}}] {
	tb.Helper()
	s := {{$new}}{{$ta}}(tb)
	return stub.Subject[{{$call}}{{$ta}}, {{$ret}}]{
		Stub: s.{{$m.Field}}.MethodStub,
		Call: func() {
{{- template "stub.testargs" $site -}}
			{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		},
{{- if $m.Returns}}
		Result: func() {{$ret}} {
{{- template "stub.testargs" $site -}}
			{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}got{{$j}}{{end}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
			return {{$ret}}{{"{"}}{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Field}}: got{{$j}}{{end}}{{"}"}}
		},
{{- end}}
{{- if $m.Defaulted}}
		Default: func() {{$ret}} {
{{- range $r := $m.Returns}}{{with $r.Default}}
			{{$r.Local}} := {{spell (stubRef $t .Ref)}}{{typeargs .Args}}().Build()
{{- end}}{{end}}
			return {{$ret}}{{"{"}}{{template "stub.testdefaults" $m}}{{"}"}}
		},
{{- end}}
		Override: func(mark func()) {
			s.{{$m.Field}}.Func(func({{template "stub.testfuncparams" $m}}){{template "stub.testresults" $m}} {
				mark()
{{- template "stub.zeros" $m}}
			})
		},
{{- if ge $m.Err 0}}
		Fails: func() error {
{{- template "stub.testargs" $site -}}
			{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
			return {{(index $m.Returns $m.Err).Local}}
		},
{{- end}}
	}
}

{{docs (wrapdocs (printf `Test%s%s pins how %s answers.

Recording, resetting, call-count expectations, strict mode, fault injection
and zero-value dispatch are the same contract for every method, so they are
asserted once in [stub.Behaviour] rather than restated here. What remains
below needs a value this method's signature can tell apart from a zero one.` $stub $m.Name $m.Name))}}
{{- ""}}{{if $c.Witnesses -}}
func {{stubCamel $stub}}{{$m.Name}}Checks{{$tp}}(t *testing.T) {
{{- else -}}
func Test{{$stub}}{{$m.Name}}(t *testing.T) {
{{- end}}
	t.Parallel()

	stub.Behaviour(t, "{{$m.Name}}", {{stubCamel $stub}}{{$m.Name}}Subject{{$ta}})
{{- if $m.Pinnable}}

	t.Run("answers with the value pinned by Returns", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- template "stub.pins" $site -}}
{{- range $j, $r := $m.Returns}}
{{- if and $r.Pinned $r.Default -}}
		assert.NotEqual(t, want{{$j}}, {{stubCamel $stub}}{{$m.Name}}Subject{{$ta}}(t).Default().{{$r.Field}},
			"the sample of {{$r.Field}} must differ from its default result"){{"\n"}}
{{- end}}
{{- end -}}
		s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
{{- template "stub.testargs" $site -}}
		{{template "stub.pinned" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
{{- range $j, $r := $m.Returns}}
{{- if $r.Pinned}}
		assert.Equal(t, got{{$j}}, want{{$j}}, "{{$m.Name}} must answer with what Returns pinned")
{{- end}}
{{- end}}
	})
{{- end}}

	t.Run("records what it was called with", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		{{if $m.Params}}got := {{end}}s.{{$m.Field}}.AssertCalledOnce(t, "{{$m.Name}} must record the call")
{{- range $j, $p := $m.Params}}
		assert.Equal(t, got.{{$p.Field}}, a{{$j}}, "the recorded call carries {{$p.Field}}")
{{- end}}
	})

	t.Run("fires the OnRecord hook for every call", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		var seen []{{$call}}{{$ta}}
		s.{{$m.Field}}.OnRecord(func(c {{$call}}{{$ta}}) { seen = append(seen, c) })
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.Length(t, seen, 2, "OnRecord must fire once per {{$m.Name}} call")
	})

	t.Run("wires With{{$iface}}{{$m.Name}} at construction", func(t *testing.T) {
		t.Parallel()
		called := false
		s := {{$new}}(t, {{spell (stubRef $t (printf "With%s%s" $iface $m.Name))}}{{$ta}}(func({{template "stub.testfuncparams" $m}}){{template "stub.testresults" $m}} {
			called = true
{{- template "stub.zeros" $m}}
		}))
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.True(t, called, "With{{$iface}}{{$m.Name}} must install the override")
	})
{{- if ge $m.Err 0}}{{use "errors"}}

	t.Run("answers the error the Failing preset armed", func(t *testing.T) {
		t.Parallel()
		want := errors.New("{{$m.Name}}-failing")
		s := {{spell (stubRef $t (printf "New%sFailing" $stub))}}{{$ta}}(t, want)
{{- template "stub.testargs" $site -}}
		{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "{{$m.Name}} must answer the armed error")
	})
{{- range $f := $m.Errors}}

	t.Run("answers {{$f.Name}} once {{$f.Helper}} arms it", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		s.{{$m.Field}}.{{$f.Helper}}()
{{- template "stub.testargs" $site -}}
		{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, {{value $f.Value}}, "{{$f.Helper}} must answer with {{$f.Name}}")
		{{template "stub.fails" $m}} = s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.NoError(t, {{(index $m.Returns $m.Err).Local}}, "the fault is one-shot and must clear")
	})
{{- end}}
{{- if $m.Retry}}

	t.Run("fails until attempt {{$m.Retry}} then succeeds", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		want := errors.New("{{$m.Name}}-retry")
		s.{{$m.Field}}.RetrySchedule(want)
{{- template "stub.testargs" $site -}}
		for attempt := 1; attempt < {{$m.Retry}}; attempt++ {
			{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
			assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "a call before attempt {{$m.Retry}} must fail")
		}
		{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.NoError(t, {{(index $m.Returns $m.Err).Local}}, "attempt {{$m.Retry}} must succeed")
	})
{{- end}}
{{- if ge $m.Partition 0}}
{{- $p := index $m.Params $m.Partition}}

	t.Run("faults only the targeted partition", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- template "stub.testargs" $site -}}
		key := a{{$m.Partition}}
		want := errors.New("{{$m.Name}}-partition")
		s.{{$m.Field}}.FaultForPartition(key, want, 1)
		{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.ErrorIs(t, {{(index $m.Returns $m.Err).Local}}, want, "a call in the targeted partition must fail")
	})

	t.Run("spares the partition FaultForOtherPartitions names", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- template "stub.testargs" $site -}}
		key := a{{$m.Partition}}
		s.{{$m.Field}}.FaultForOtherPartitions(key, errors.New("{{$m.Name}}-partition"), 1)
		{{template "stub.fails" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.NoError(t, {{(index $m.Returns $m.Err).Local}}, "a call in the named partition must be spared")
	})
{{- end}}
{{- end}}
{{- if $m.Returns}}
{{- if $m.Pinnable}}

	t.Run("keeps the Returns configuration across a reset", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- template "stub.pins" $site -}}
		s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		s.ResetCalls()
		{{template "stub.pinned" $m}} := s.{{$m.Name}}({{template "stub.testcall" $m}})
{{- range $j, $r := $m.Returns}}
{{- if $r.Pinned}}
		assert.Equal(t, got{{$j}}, want{{$j}}, "a reset must keep what Returns pinned")
{{- end}}
{{- end}}
	})
{{- else}}

	t.Run("keeps recording across a reset", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
{{- range $j, $r := $m.Returns}}
		var want{{$j}} {{spell $r.Type}}
{{- end}}
		s.{{$m.Field}}.Returns({{range $j, $r := $m.Returns}}{{if $j}}, {{end}}want{{$j}}{{end}})
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		s.ResetCalls()
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		s.{{$m.Field}}.AssertCalledOnce(t, "{{$m.Name}} must record the call that followed the reset")
	})
{{- end}}
{{- end}}
{{- with $q := $m.Sequence}}

	t.Run("yields the items Yields configured", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		var want {{spell $q.Elem}}
		s.{{$m.Field}}.Yields(want, want)
{{- template "stub.testargs" $site -}}
		got0 := s.{{$m.Name}}({{template "stub.testcall" $m}})
		seen := 0
		for range got0 {
			seen++
		}
		assert.Equal(t, seen, 2, "{{$m.Name}} must yield every configured item")
	})

	t.Run("stops yielding when the caller breaks", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		var want {{spell $q.Elem}}
		s.{{$m.Field}}.Yields(want, want, want)
{{- template "stub.testargs" $site -}}
		got0 := s.{{$m.Name}}({{template "stub.testcall" $m}})
		seen := 0
		for range got0 {
			seen++
			break
		}
		assert.Equal(t, seen, 1, "{{$m.Name}} must stop when the caller breaks")
	})
{{- if $q.Errors}}{{use "errors"}}

	t.Run("yields the items YieldsError configured and then fails", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		var item {{spell $q.Elem}}
		want := errors.New("{{$m.Name}}-yields")
		s.{{$m.Field}}.YieldsError([]{{spell $q.Elem}}{item, item}, want)
{{- template "stub.testargs" $site -}}
		got0 := s.{{$m.Name}}({{template "stub.testcall" $m}})
		seen := 0
		var last error
		for _, err := range got0 {
			if err != nil {
				last = err
				break
			}
			seen++
		}
		assert.Equal(t, seen, 2, "{{$m.Name}} must yield every item before failing")
		assert.ErrorIs(t, last, want, "{{$m.Name}} must end with the configured error")
	})

	t.Run("stops a failing sequence when the caller breaks", func(t *testing.T) {
		t.Parallel()
		s := {{$new}}{{$ta}}(t)
		var item {{spell $q.Elem}}
		s.{{$m.Field}}.YieldsError([]{{spell $q.Elem}}{item, item, item}, errors.New("{{$m.Name}}-yields"))
{{- template "stub.testargs" $site -}}
		got0 := s.{{$m.Name}}({{template "stub.testcall" $m}})
		seen := 0
		for range got0 {
			seen++
			break
		}
		assert.Equal(t, seen, 1, "{{$m.Name}} must stop when the caller breaks")
	})
{{- end}}
{{- end}}
{{- with $m.After}}

	t.Run("refuses {{$m.Name}} before {{.}} in strict mode", func(t *testing.T) {
		t.Parallel()
		r := assert.NewRecorder()
		s := {{$new}}{{$ta}}(r, {{spell (stubRef $t (printf "%sStrict" $stub))}}{{$ta}}())
{{- template "stub.testargs" $site -}}
		{{template "stub.blanks" $m}}s.{{$m.Name}}({{template "stub.testcall" $m}})
		assert.True(t, r.Failed(), "{{$m.Name}} before {{.}} must be refused")
	})
{{- end}}
}
{{- end}}
