{{- $inputs := false}}{{if not .Builder}}{{range .Params}}{{if ge .Arg 0}}{{$inputs = true}}{{end}}{{end}}{{end}}
{{- if $inputs}}
			Input: func(c *{{$prop}}.Case, _ struct{}) any {
{{- range .Params}}{{if ge .Arg 0}}
{{- if .Pool}}
