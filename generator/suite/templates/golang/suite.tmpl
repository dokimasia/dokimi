		ch := make(chan {{spell .Type}}, len({{.Local}}))
		for _, v := range {{.Local}} {
			ch <- v
		}
		close(ch)
		return ch
	}(){{else}}{{.Local}}{{if .Variadic}}...{{end}}{{end}}{{end}}{{end}}){{end}}

{{- /*
suite.apply writes a function that a probe of generated sequences calls with
