{{- use "testing"}}
{{- range .Records}}
{{- $r := .Decl}}
{{- $c := .Data}}
{{- $many := gt (len $c.Sentinels) 1}}
{{- $near := false}}{{range $c.Neighbours}}{{if .Sentinels}}{{$near = true}}{{end}}{{end}}
{{- range $s := $c.Sentinels}}{{use "go.dokimi.dev/assert"}}
{{- $err := spell $s.Ref}}

{{docs (wrapdocs (printf `Test%s checks the sentinel error %s. A caller matches it with errors.Is
and reads its message, so it has a message and an identity of its own.` $s.Name $s.Name))}}
{{- ""}}func Test{{$s.Name}}(t *testing.T) {
	t.Parallel()
{{- if $many}}

	others := []struct {
		name string
		err  error
	}{
{{- range $c.Sentinels}}
{{- if ne .Name $s.Name}}
		{"{{.Name}}", {{spell .Ref}}},
{{- end}}
{{- end}}
	}
{{- end}}

	t.Run("Error", func(t *testing.T) {
		t.Parallel()

		t.Run("returns a message", func(t *testing.T) {
			t.Parallel()
			assert.NotNil(t, {{$err}}, "{{$s.Name}} is assigned")
			assert.NotEqual(t, {{$err}}.Error(), "", "{{$s.Name}} has a message")
		})
{{- if and $c.Prefix (not $s.Reexport)}}

		t.Run("opens the message with the package prefix", func(t *testing.T) {
			t.Parallel()
			assert.HasPrefix(t, {{$err}}.Error(), {{printf "%q" $c.Prefix}}, "the message of {{$s.Name}} opens with the package prefix")
		})
{{- end}}
{{- if $many}}{{use "strings"}}{{use "go.dokimi.dev/assert/expect"}}

		t.Run("returns a message of its own", func(t *testing.T) {
			t.Parallel()
			for _, other := range others {
				expect.NotEqual(t, {{$err}}.Error(), other.err.Error(), "{{$s.Name}} has the message of "+other.name)
			}
		})

		t.Run("opens with the message of no other sentinel", func(t *testing.T) {
			t.Parallel()
			for _, other := range others {
				expect.False(t, strings.HasPrefix({{$err}}.Error(), other.err.Error()),
					"the message of {{$s.Name}} opens with the message of "+other.name)
			}
		})
{{- end}}
	})
{{- if or $many $near}}{{use "go.dokimi.dev/assert/expect"}}

	t.Run("errors.Is", func(t *testing.T) {
		t.Parallel()
{{- if $many}}

		t.Run("matches no other sentinel of the package", func(t *testing.T) {
			t.Parallel()
			for _, other := range others {
				expect.ErrorIsNot(t, {{$err}}, other.err, "{{$s.Name}} does not match "+other.name)
			}
		})
{{- end}}
{{- range $c.Neighbours}}
{{- if .Sentinels}}

		t.Run("matches no sentinel of {{.Name}}", func(t *testing.T) {
			t.Parallel()
			for _, other := range []struct {
				name string
				err  error
			}{
{{- range .Sentinels}}
				{"{{.Name}}", {{spell .Ref}}},
{{- end}}
			} {
				expect.ErrorIsNot(t, {{$err}}, other.err, "{{$s.Name}} does not match "+other.name+" of {{.Name}}")
			}
		})
{{- end}}
{{- end}}
	})
{{- end}}
}
{{- end}}
{{- range $c.Kinds}}{{use "go.dokimi.dev/assert"}}
{{- $amp := ""}}{{if .Pointer}}{{$amp = "&"}}{{end}}
{{- $lit := printf "%s%s{}" $amp (spell .Ref)}}
{{- $self := .Name}}

{{docs (wrapdocs (printf `Test%s checks the error type %s.` .Name .Name))}}
{{- ""}}func Test{{.Name}}(t *testing.T) {
	t.Parallel()
{{- $texts := false}}{{$several := false}}
{{- range .Members}}{{if .Text}}{{if $texts}}{{$several = true}}{{end}}{{$texts = true}}{{end}}{{end}}
{{- $textual := and (ge .Method 0) $texts}}
{{- if or (not .Remote) $textual}}

	t.Run("Error", func(t *testing.T) {
		t.Parallel()
{{- if not .Remote}}

		t.Run("returns a message for the zero value", func(t *testing.T) {
			t.Parallel()
			assert.NotEqual(t, ({{$lit}}).Error(), "", "the zero value has a message")
		})
{{- if $c.Prefix}}

		t.Run("opens the message with the package prefix", func(t *testing.T) {
			t.Parallel()
			assert.HasPrefix(t, ({{$lit}}).Error(), {{printf "%q" $c.Prefix}}, "the message opens with the package prefix")
		})
{{- end}}
{{- end}}
{{- if $textual}}
{{- $m := index $r.Methods.Items .Method}}
{{- $check := "assert"}}{{if $several}}{{$check = "expect"}}{{use "go.dokimi.dev/assert/expect"}}{{end}}

		t.Run("contains each text member", func(t *testing.T) {
			t.Parallel()
{{body $m}}
{{- range .Members}}{{if .Text}}			{{$check}}.Contains(t, got.Error(), got.{{.Name}}, "the message contains {{.Name}}")
{{end}}{{end}}		})
{{- end}}
	})
{{- end}}
{{- if and .Compares (not .Unwraps) $c.Sentinels}}{{use "errors"}}

	t.Run("Is", func(t *testing.T) {
		t.Parallel()

		t.Run("agrees with errors.Is on each sentinel", func(t *testing.T) {
			t.Parallel()
			subject := {{$lit}}
			for _, e := range []error{
{{- range $c.Sentinels}}
				{{spell .Ref}},
{{- end}}
			} {
				assert.Equal(t, subject.Is(e), errors.Is(subject, e), "Is agrees with errors.Is")
			}
		})
	})
{{- end}}
{{- if and .Unwraps .Cause}}{{use "errors"}}

	t.Run("Unwrap", func(t *testing.T) {
		t.Parallel()

		t.Run("returns the cause", func(t *testing.T) {
			t.Parallel()
			cause := errors.New("cause")
{{- if .Pointer}}
			got := &{{spell .Ref}}{}
{{- else}}
			var got {{spell .Ref}}
{{- end}}
			got.{{.Cause}} = cause
			assert.Equal(t, errors.Unwrap(got), cause, "errors.Unwrap returns the cause")
		})
	})
{{- end}}
{{- if gt (len $c.Kinds) 1}}

	t.Run("errors.Is", func(t *testing.T) {
		t.Parallel()

		t.Run("matches no other error type of the package", func(t *testing.T) {
			t.Parallel()
			subject := {{$lit}}
			for _, other := range []error{
{{- range $c.Kinds}}
{{- if ne .Name $self}}
				{{if .Pointer}}&{{end}}{{spell .Ref}}{},
{{- end}}
{{- end}}
			} {
				assert.ErrorIsNot(t, subject, other, "{{$self}} does not match another error type of the package")
			}
		})
	})
{{- end}}
}
{{- end}}
{{- end}}
