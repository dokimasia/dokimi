{{- use "vitest" "describe"}}{{use "vitest" "expect"}}{{use "vitest" "it"}}
{{- $surface := surfaceModule $.Name}}
{{- $source := sourceModule $.Name}}
{{- define "enum.ts.variants"}}
{{- $e := spellvalue .Type}}[{{range $i, $v := .Variants}}{{if $i}}, {{end}}{{$e}}{{$v.Member}}{{end}}]
{{- end}}
{{- range .Records}}
{{- $c := .Data}}
{{- $t := spell $c.Type}}
{{- $e := spellvalue $c.Type}}
{{- $n := $c.Names}}
{{- if $c.Calls.Values}}{{use $surface $n.Values}}{{use "@dokimi/assert" "byIdentity"}}{{end}}
{{- if $c.Calls.Render}}{{use (or (and $c.Generate.Render $surface) $source) $n.Render}}{{end}}
{{- if $c.Calls.Valid}}{{use (or (and $c.Generate.Valid $surface) $source) $n.Valid}}{{end}}
{{- if $c.Calls.Parse}}{{use $surface $n.Parse}}{{use $surface $n.Sentinel}}{{end}}

describe("{{$c.Subject}}", () => {
  it("gives each variant a value of its own", () => {
    const values = {{template "enum.ts.variants" $c}};
    expect(new Set(values)).hasLength(values.length, "each variant has a value of its own");
  });
{{- if $c.Calls.Values}}

  describe("{{$n.Values}}", () => {
    it("returns the declared variants in the order of their declaration", () => {
      const want = {{template "enum.ts.variants" $c}};
      expect({{$n.Values}}()).isEqualTo(want, "{{$n.Values}} returns the declared variants");
    });

    it("returns a new array for each call", () => {
      expect({{$n.Values}}()).isNotEqualTo({{$n.Values}}(), "the two calls return two arrays", byIdentity());
    });
  });
{{- end}}
{{- if $c.Calls.Render}}

  describe("{{$n.Render}}", () => {
{{- if $c.Stated}}
    const tests = [
{{- range $c.Variants}}
{{- if .Stated}}
      { name: "returns the declared text of {{.Name}}", give: {{$e}}{{.Member}}, want: {{.Text}} },
{{- end}}
{{- end}}
    ];
    for (const tt of tests) {
      it(tt.name, () => {
        expect({{$n.Render}}(tt.give)).isEqualTo(tt.want, "{{$n.Render}} returns the declared text of the variant");
      });
    }

{{- end}}
{{- if $c.Stated}}
{{end}}
    it("returns a text of its own for each variant", () => {
      const texts = {{template "enum.ts.variants" $c}}.map((value) => {{$n.Render}}(value));
      expect(new Set(texts)).hasLength(texts.length, "each variant has a text of its own");
    });
{{- if and $c.OutOfRange $c.Generate.Render}}

    it("renders a value outside the declared set with a text of its own", () => {
      const out = {{$c.OutOfRange}} as unknown as {{$t}};
      const texts = {{template "enum.ts.variants" $c}}.map((value) => {{$n.Render}}(value));
      expect(texts).doesNotContain({{$n.Render}}(out), "an undeclared value has a text of its own");
    });
{{- end}}
  });
{{- end}}
{{- if $c.Calls.Valid}}

  describe("{{$n.Valid}}", () => {
    const tests = [
{{- range $c.Variants}}
      { name: "accepts {{.Name}}", give: {{$e}}{{.Member}} },
{{- end}}
    ];
    for (const tt of tests) {
      it(tt.name, () => {
        expect({{$n.Valid}}(tt.give)).isTrue("{{$n.Valid}} accepts each declared variant");
      });
    }
{{- if $c.OutOfRange}}

    it("refuses a value outside the declared set", () => {
      expect({{$n.Valid}}({{$c.OutOfRange}})).isFalse("{{$n.Valid}} refuses an undeclared value");
    });
{{- end}}
  });
{{- end}}
{{- if $c.Calls.Parse}}

  describe("{{$n.Parse}}", () => {
    const tests = [
{{- range $c.Variants}}
      { name: "returns {{.Name}} for its text", give: {{$e}}{{.Member}} },
{{- end}}
    ];
    for (const tt of tests) {
      it(tt.name, () => {
        expect({{$n.Parse}}({{$n.Render}}(tt.give))).isEqualTo(tt.give, "{{$n.Parse}} returns the variant of the text");
      });
    }

    it("refuses a text that no variant has", () => {
      let thrown: unknown;
      try {
        {{$n.Parse}}({{$c.Unknown}});
      } catch (error) {
        thrown = error;
      }
      expect(thrown).errorAs({{$n.Sentinel}}, "{{$n.Parse}} refuses the text with {{$n.Sentinel}}");
    });
  });
{{- end}}
});
{{- end}}
