{{- $sim := import "go.dokimi.dev/sim"}}
{{- range .Records}}
{{- $c := .Data}}
{{- $E := spell $c.Event}}
{{- $F := spell $c.Effect}}
{{- $S := "struct{}"}}{{with $c.State}}{{$S = spell .}}{{end}}
{{- with $c.Spec}}{{if .From}}{{$S = printf "[]%s.Operation" (import "go.dokimi.dev/assert/history")}}{{end}}{{end}}
{{- $W := printf "*%s.World[%s, %s]" $sim $E $F}}
{{- if not $c.Components}}

{{docs (wrapdocs (printf `%s is how a world reads the events and the effects of %s.` $c.Names.Anatomy $c.Machine))}}
{{- ""}}var {{$c.Names.Anatomy}} = {{$sim}}.Anatomy[{{$E}}, {{$F}}]{
	Started: func(reply uint64) {{$E}} {
		return {{spell $c.Started.Type}}{ {{- $c.Started.Field}}: {{spell $c.Started.Token}}(reply)}
	},
	Stopped: func() {{$E}} { return {{spell $c.Stopped}}{} },
{{- with $c.Cancelled}}
	Cancelled: func(reply uint64) {{$E}} {
		return {{spell .Type}}{ {{- .Field}}: {{spell .Token}}(reply)}
	},
{{- end}}
{{- if $c.Calls}}
	Call: func(ev {{$E}}) (uint64, bool) {
		switch ev := ev.(type) {
{{- range $c.Calls}}
		case {{spell .Type}}:
			return uint64(ev.{{.Field}}), true
{{- end}}
		default:
			return 0, false
		}
	},
{{- else}}
	Call: func({{$E}}) (uint64, bool) { return 0, false },
{{- end}}
{{- if $c.Replies}}
	Reply: func(f {{$F}}) (uint64, any, error, bool) {
		switch f := f.(type) {
{{- range $c.Replies}}
		case {{spell .Type}}:
			return uint64(f.{{.To}}), f.{{.Value}}, f.{{.Err}}, true
{{- end}}
		default:
			return 0, nil, nil, false
		}
	},
{{- else}}
	Reply: func({{$F}}) (uint64, any, error, bool) { return 0, nil, nil, false },
{{- end}}
{{- with $c.Unknown}}
	Unknown: func(err error) bool {
		return {{range $i, $u := .}}{{if $i}} || {{end}}{{import "errors"}}.Is(err, {{spell $u}}){{end}}
	},
{{- end}}
{{- if $c.Tokens}}
	Token: func(f {{$F}}) (uint64, bool) {
		switch f := f.(type) {
{{- range $c.Tokens}}
		case {{spell .Type}}:
			return uint64(f.{{.Field}}), true
{{- end}}
		default:
			return 0, false
		}
	},
{{- else}}
	Token: func({{$F}}) (uint64, bool) { return 0, false },
{{- end}}
{{- if $c.Ends}}
	Ends: func(f {{$F}}) (uint64, bool) {
		switch f := f.(type) {
{{- range $c.Ends}}
		case {{spell .Type}}:
			return uint64(f.{{.Field}}), true
{{- end}}
		default:
			return 0, false
		}
	},
{{- end}}
{{- $depended := false}}{{range $c.Performs}}{{if .Dependency}}{{$depended = true}}{{end}}{{end}}
{{- if $depended}}
	Dependency: func(f {{$F}}) (string, bool) {
		switch f.(type) {
{{- range $p := $c.Performs}}{{with $p.Dependency}}
		case {{spell $p.Type}}:
			return {{printf "%q" .Name}}, true
{{- end}}{{end}}
		default:
			return "", false
		}
	},
	Fail: func(f {{$F}}, err error) ({{$E}}, bool) {
		switch f := f.(type) {
{{- range $p := $c.Performs}}{{with $p.Dependency}}
		case {{spell $p.Type}}:
			return {{spell .Event}}{ {{- .Token}}: f.{{.EffectToken}}, {{.Err}}: err}, true
{{- end}}{{end}}
		default:
			return nil, false
		}
	},
{{- $ended := false}}{{range $c.Performs}}{{with .Dependency}}{{if .End}}{{$ended = true}}{{end}}{{end}}{{end}}
{{- if $ended}}
	End: func(f {{$F}}, err error) ({{$E}}, bool) {
		switch f := f.(type) {
{{- range $p := $c.Performs}}{{with $p.Dependency}}{{$d := .}}{{with .End}}
		case {{spell $p.Type}}:
			return {{spell .Event}}{ {{- .Token}}: f.{{$d.EffectToken}}{{with .Err}}, {{.}}: err{{end}}}, true
{{- end}}{{end}}{{end}}
		default:
			return nil, false
		}
	},
{{- end}}
	Errors: func(f {{$F}}) []error {
		switch f.(type) {
{{- range $p := $c.Performs}}{{with $p.Dependency}}{{if .Errors}}
		case {{spell $p.Type}}:
			return []error{ {{- range $i, $e := .Errors}}{{if $i}}, {{end}}{{spell $e}}{{end -}} }
{{- end}}{{end}}{{end}}
		default:
			return nil
		}
	},
{{- else}}
	Dependency: func({{$F}}) (string, bool) { return "", false },
	Fail:       func({{$F}}, error) ({{$E}}, bool) { return nil, false },
	Errors:     func({{$F}}) []error { return nil },
{{- end}}
{{- if $c.Timeouts}}
	Timeout: func(f {{$F}}) {{$time := import "time"}}{{$time}}.Duration {
		switch f := f.(type) {
{{- range $c.Performs}}{{if .Timeout}}
		case {{spell .Type}}:
			return f.{{.Timeout}}
{{- end}}{{end}}
		default:
			return 0
		}
	},
{{- else}}
	Timeout: func({{$F}}) {{$time := import "time"}}{{$time}}.Duration { return 0 },
{{- end}}
	Perform: {{$c.Names.Perform}},
}

{{docs (wrapdocs (printf `%s performs the effect f of the process p of %s through the function or the call of its directive perform.` $c.Names.Perform $c.Machine))}}
{{- ""}}func {{$c.Names.Perform}}(w {{$W}}, p *{{$sim}}.Process[{{$E}}, {{$F}}], f {{$F}}) {{$sim}}.Outcome[{{$E}}, {{$F}}] {
{{- if $c.Performs}}
	switch f := f.(type) {
{{- range $c.Performs}}
	case {{spell .Type}}:
{{- $d := .Dependency}}
{{- with .Call}}
		ev := {{spell $d.Event}}{ {{- $d.Token}}: f.{{$d.EffectToken}}}
		{{range $i, $v := .Values}}{{if $i}}, {{end}}ev.{{$v}}{{end}}{{if .Fails}}{{if .Values}}, {{end}}ev.{{$d.Err}}{{end}}{{if or .Values .Fails}} = {{end}}{{$sim}}.Dependency[{{spell .Interface}}](w, p).{{.Method}}({{range $i, $a := .Args}}{{if $i}}, {{end}}{{if $a.Context}}w.Context(){{else}}f.{{$a.Field}}{{end}}{{end}})
		return {{$sim}}.Outcome[{{$E}}, {{$F}}]{Event: ev}
{{- else}}
		return {{.Func}}(w, p, {{if .Pointer}}&{{end}}f)
{{- end}}
{{- end}}
	default:
		return {{$sim}}.Outcome[{{$E}}, {{$F}}]{}
	}
{{- else}}
	return {{$sim}}.Outcome[{{$E}}, {{$F}}]{}
{{- end}}
}

{{docs (wrapdocs (printf `%s returns the simulation of the system of the machines of %s, with its checks.` $c.Names.Simulation $c.Machine))}}
{{- else}}

{{docs (wrapdocs (printf `%s returns the simulation of the system of the components that %s spawns, with its checks.` $c.Names.Simulation $c.System))}}
{{- end}}
{{- ""}}func {{$c.Names.Simulation}}() {{$sim}}.Simulation[{{$E}}, {{$F}}, {{$S}}] {
	return {{$sim}}.Simulation[{{$E}}, {{$F}}, {{$S}}]{
{{- if not $c.Components}}
		Anatomy: {{$c.Names.Anatomy}},
{{- else if $c.Unknown}}
		Anatomy: {{$sim}}.Anatomy[{{$E}}, {{$F}}]{
			Unknown: func(err error) bool {
				return {{range $i, $u := $c.Unknown}}{{if $i}} || {{end}}{{import "errors"}}.Is(err, {{spell $u}}){{end}}
			},
		},
{{- end}}
		System:{{if $c.Inputs}}{{$c.System}}{{else}}func(*{{import "go.dokimi.dev/assert/prop"}}.Case) func(w {{$W}}) { return {{$c.System}} }{{end}},
{{- with $c.Spec}}
{{- if .From}}
		Spec: {{$history := import "go.dokimi.dev/assert/history"}}{{$history}}.SpecFrom({{.Func}}),
{{- else}}
		Spec: {{.Func}}(),
{{- end}}
{{- end}}
{{- with $c.Fingerprint}}
		Fingerprint: {{.}},
{{- end}}
{{- if $c.Tolerate}}
		Tolerate: map[{{$sim}}.Fault]int{
{{- range $c.Tolerate}}
			{{$sim}}.{{.Fault}}: {{.N}},
{{- end}}
		},
{{- end}}
{{- if $c.Require}}
		Require: map[{{$sim}}.Fault]float64{
{{- range $c.Require}}
			{{$sim}}.{{.Fault}}: {{.Share}},
{{- end}}
		},
{{- end}}
{{- if $c.Actions}}
		Actions: []{{$sim}}.Action[{{$E}}, {{$F}}]{
{{- range $c.Actions}}
			{
				Name: {{simQuote .Func}},
{{- if .Call}}
				Call: true,
{{- end}}
{{- if .Final}}
				Drain: true,
{{- end}}
				Input: func(c *{{$prop := import "go.dokimi.dev/assert/prop"}}{{$prop}}.Case) any { return {{.Func}}(c) },
{{- if .Call}}
				Run: func(w {{$W}}, client int, in any) {
					run, _ := in.(func({{$W}}, int))
					run(w, client)
				},
{{- else}}
				Run: func(w {{$W}}, _ int, in any) {
					run, _ := in.(func({{$W}}))
					run(w)
				},
{{- end}}
			},
{{- end}}
		},
{{- end}}
{{- if $c.Rules}}
		Rules: []{{$sim}}.Rule{
{{- range $c.Rules}}
			{
				ID:        {{simQuote .ID}},
				Statement: {{simQuote .Statement}},
				Claim:     {{simQuote .Claim}},
				Probe:     {{simQuote .Probe}},
				Reason:    {{simQuote .Reason}},
				Form:      {{simQuote .Form}},
			},
{{- end}}
		},
{{- end}}
{{- if $c.Invariants}}
		Invariants: []{{$sim}}.Invariant[{{$E}}, {{$F}}]{
{{- range $c.Invariants}}
			{Statement: {{simQuote .Statement}}, Check: {{.Func}}, Defect: {{if .Inputs}}{{.Defect}}{{else}}func(*{{import "go.dokimi.dev/assert/prop"}}.Case) func(w {{$W}}) { return {{.Defect}} }{{end}}},
{{- end}}
		},
{{- end}}
{{- if $c.Converges}}
		Converges: []{{$sim}}.Convergence[{{$E}}, {{$F}}]{
{{- range $c.Converges}}
			{Statement: {{simQuote .Statement}}, Check: {{.Func}}{{with .Within}}, Within: {{.}}(){{end}}},
{{- end}}
		},
{{- end}}
{{- if $c.Scenarios}}
		Scenarios: []{{$sim}}.Scenario[{{$E}}, {{$F}}]{
{{- range $c.Scenarios}}
			{Name: {{simQuote .Func}}, Run: {{.Func}}},
{{- end}}
		},
{{- end}}
{{- if $c.Components}}
		Around: {{import "go.dokimi.dev/conform"}}.Bubble,
		Mode:   {{import "go.dokimi.dev/spec"}}.{{if $c.Tasks}}ModeTasks{{else}}ModeNative{{end}},
{{- end}}
{{- with $c.MeanSteps}}
		MeanSteps: {{.}},
{{- end}}
{{- with $c.MaxSteps}}
		MaxSteps: {{.}},
{{- end}}
{{- if eq $c.Strategy "uniform"}}
		Strategy: {{$sim}}.Uniform(),
{{- else if eq $c.Strategy "pct"}}
		Strategy: {{$sim}}.PCT({{$c.Depth}}),
{{- end}}
{{- if eq $c.Isolation "serializable"}}
		Isolation: {{$sim}}.Serializable,
{{- else if eq $c.Isolation "snapshot-isolation"}}
		Isolation: {{$sim}}.SnapshotIsolation,
{{- end}}
{{- if $c.Blocking}}
		Blocking: true,
{{- end}}
	}
}
{{- end}}
