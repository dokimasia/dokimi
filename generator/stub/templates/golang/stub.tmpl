{{- use "time"}}{{use "math/rand/v2"}}{{use "go.dokimi.dev/assert"}}{{use "go.dokimi.dev/stub"}}
{{- range .Records}}
{{- $d := .Decl}}
{{- $c := .Data}}
{{- if eq $d.Name $c.Double}}
{{- $stub := $d.Name}}
{{- $iface := $c.Subject}}
{{- $new := stubNew $stub}}
{{- $tp := typeparams $d.TypeParams}}
{{- $ta := typeargs $d.TypeParams}}
{{- $unset := "its zero value"}}{{range $c.Methods}}{{if .Defaulted}}{{$unset = "its default results"}}{{end}}{{end}}
{{- $retries := false}}{{range $c.Methods}}{{if .Retry}}{{$retries = true}}{{end}}{{end}}
{{- with $c.Producer}}

// {{$iface}} is a handle that a method of {{.}} returns.
{{- end}}
{{- range $c.Methods}}

{{docs (wrapdocs (printf `%s records one call of %s.%s.` .Call $iface .Name))}}
{{- ""}}type {{.Call}}{{$tp}} struct {
{{- range .Params}}
	{{.Field}} {{if .Variadic}}[]{{end}}{{spell .Type}}
{{- end}}
{{- range .Returns}}
	{{.Field}} {{spell .Type}}
{{- end}}
}
{{- end}}
{{- range $m := $c.Methods}}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `%s configures %s and records its calls. A fault armed through it takes
precedence over the function and the fixed results.` $m.Stub $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `%s configures %s and records its calls. %s returns no error, so a fault
armed through it fails the test.` $m.Stub $m.Name $m.Name))}}
{{- end}}
{{- ""}}type {{$m.Stub}}{{$tp}} struct {
	*stub.MethodStub[{{$m.Call}}{{$ta}}]

	fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}
{{- if $m.Returns}}
	fallback *{{$m.Return}}{{$ta}}
{{- end}}
}
{{- if $m.Returns}}

{{docs (wrapdocs (printf `%s contains the fixed results of %s.` $m.Return $m.Name))}}
{{- ""}}type {{$m.Return}}{{$tp}} struct {
{{- range $m.Returns}}
	{{.Field}} {{spell .Type}}
{{- end}}
}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `Returns sets the results of every call of %s. A function and an
injected fault take precedence over them.` $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `Returns sets the results of every call of %s. A function takes
precedence over them.` $m.Name))}}
{{- end}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Returns({{template "stub.returnparams" $m}}) *{{$m.Stub}}{{$ta}} {
	s.fallback = &{{$m.Return}}{{$ta}}{{"{"}}{{range $i, $r := $m.Returns}}{{if $i}}, {{end}}{{$r.Field}}: {{$r.Param}}{{end}}{{"}"}}
	return s
}
{{- end}}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `Func sets the function that computes the results of %s from its
arguments. An injected fault takes precedence over it.` $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `Func sets the function that computes the results of %s from its
arguments.` $m.Name))}}
{{- end}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Func(fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}) *{{$m.Stub}}{{$ta}} {
	s.fn = fn
	return s
}
{{- with $q := $m.Sequence}}

{{docs (wrapdocs (printf `Yields makes %s return a sequence of items. The sequence stops where the
caller breaks out of the loop.` $m.Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Yields(items ...{{spell $q.Elem}}) *{{$m.Stub}}{{$ta}} {
	s.fn = func({{template "stub.blankparams" $m}}){{template "stub.results" $m}} {
		return func(yield func({{spell $q.Elem}}{{with $q.Second}}, {{spell .}}{{end}}) bool) {
{{- if and $q.Second (not $q.Errors)}}
			var second {{spell $q.Second}}
{{- end}}
			for _, v := range items {
				if !yield(v{{if $q.Second}}, {{if $q.Errors}}nil{{else}}second{{end}}{{end}}) {
					return
				}
			}
		}
	}
	return s
}
{{- if $q.Errors}}

{{docs (wrapdocs (printf `YieldsError makes %s return a sequence of items that fails with err after
the last item.` $m.Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) YieldsError(items []{{spell $q.Elem}}, err error) *{{$m.Stub}}{{$ta}} {
	s.fn = func({{template "stub.blankparams" $m}}){{template "stub.results" $m}} {
		return func(yield func({{spell $q.Elem}}, {{spell $q.Second}}) bool) {
			for _, v := range items {
				if !yield(v, nil) {
					return
				}
			}
			var zero {{spell $q.Elem}}
			yield(zero, err)
		}
	}
	return s
}
{{- end}}
{{- end}}
{{- range $m.Errors}}

{{docs (wrapdocs (printf `%s makes the next call of %s fail with %s. The calls after it
succeed.` .Helper $m.Name .Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) {{.Helper}}() *{{$m.Stub}}{{$ta}} {
	s.FaultsOnce({{value .Value}})
	return s
}
{{- end}}
{{- if $m.Retry}}{{use "go.dokimi.dev/fault"}}

{{docs (wrapdocs (printf `RetrySchedule makes %s fail with err on every call before call %d. Call %d
and every call after it succeed.` $m.Name $m.Retry $m.Retry))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) RetrySchedule(err error) *{{$m.Stub}}{{$ta}} {
	s.SetFault(fault.NewRetryFault[{{$m.Call}}{{$ta}}](err, {{$m.Retry}}))
	return s
}
{{- end}}
{{- if ge $m.Partition 0}}
{{- $p := index $m.Params $m.Partition}}

{{docs (wrapdocs (printf `FaultForPartition makes %s fail every nth call whose %s matches key. The
fault leaves the calls of the other partitions alone. A test of the isolation
of a partition needs a fault that selects its calls.` $m.Name $p.Field))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) FaultForPartition(key {{spell $p.Type}}, err error, n int) *{{$m.Stub}}{{$ta}} {
	s.FaultsWhen(func(c {{$m.Call}}{{$ta}}) bool { return c.{{$p.Field}} == key }, err, n)
	return s
}

{{docs (wrapdocs (printf `FaultForOtherPartitions makes %s fail every nth call whose %s differs
from key. The fault leaves the calls of the partition of key alone.` $m.Name $p.Field))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) FaultForOtherPartitions(key {{spell $p.Type}}, err error, n int) *{{$m.Stub}}{{$ta}} {
	s.FaultsWhen(func(c {{$m.Call}}{{$ta}}) bool { return c.{{$p.Field}} != key }, err, n)
	return s
}
{{- end}}
{{- end}}

// The reference to stub.CompatV1 fails the build against another major
// version of the runtime of doubles.
var _ = stub.CompatV1
{{- if $retries}}

// The reference to fault.CompatV1 fails the build against another major
// version of the fault strategies.
var _ = fault.CompatV1
{{- end}}

{{docs (wrapdocs (printf `%sOption configures a [%s] at its construction.` $stub $stub))}}
{{- ""}}type {{$stub}}Option{{$tp}} func(*{{$stub}}{{$ta}})

{{docs (wrapdocs (printf `%sStrict returns the option that makes an unconfigured method fail the
test instead of returning %s.` $stub $unset))}}
{{- ""}}func {{$stub}}Strict{{$tp}}() {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.strict = true }
}

{{if $c.Delegate -}}
{{docs (wrapdocs (printf `%sDelegateTo returns the option that passes each call to impl. The double
still records the call.` $stub))}}
{{- else -}}
{{docs (wrapdocs (printf `%sDelegateTo returns the option that passes each call to impl. impl has the
methods of %s. Both a pointer to a %s and a second double have them. The double
still records the call.` $stub $iface $iface))}}
{{- end}}
{{- ""}}func {{$stub}}DelegateTo{{$tp}}(impl {{with $c.Delegate}}{{spell .}}{{else}}interface {
{{- range $dm := $d.Methods.Items}}
	{{$dm.Name}}({{params $dm.Params}}){{results $dm.Returns}}
{{- end}}
}{{end}}) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) {
{{- range $c.Methods}}
		s.{{.Field}}.Func(impl.{{.Name}})
{{- end}}
	}
}

{{docs (wrapdocs (printf `%sWithClock returns the option that sets the clock of the double to clk.
The double takes the latency, the windows of the faults and the instants of
the calls from clk. A latency on a controlled clock costs no real time.` $stub))}}
{{- ""}}func {{$stub}}WithClock{{$tp}}(clk assert.Clock) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetClock(clk) }
}

{{docs (wrapdocs (printf `%sWithRandSource returns the option that sets the random source of the
probabilistic faults to src. A seeded source repeats the faults of a run.` $stub))}}
{{- ""}}func {{$stub}}WithRandSource{{$tp}}(src rand.Source) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetRandSource(src) }
}

{{docs (wrapdocs (printf `%sBenchMode returns the option that turns the recording of calls off. The
methods still return their results.` $stub))}}
{{- ""}}func {{$stub}}BenchMode{{$tp}}() {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.BenchMode() }
}

{{docs (wrapdocs (printf `%sWithLatency returns the option that makes every method sleep d before it
returns. Without %sWithClock, d passes in real time.` $stub $stub))}}
{{- ""}}func {{$stub}}WithLatency{{$tp}}(d time.Duration) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetLatency(d) }
}
{{- if $c.Fallible}}

{{docs (wrapdocs (printf `%sFailing returns the option that arms err on each method that can fail.
Each call of such a method then fails with err.` $stub))}}
{{- ""}}func {{$stub}}Failing{{$tp}}(err error) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) {
{{- range $c.Methods}}
{{- if ge .Err 0}}
		s.{{.Field}}.Faults(err, 1)
{{- end}}
{{- end}}
	}
}
{{- end}}
{{- range $m := $c.Methods}}
{{- $with := stubWith $iface $m.Name}}

{{docs (wrapdocs (printf `%s returns the option that sets the function of %s.` $with $m.Name))}}
{{- ""}}func {{$with}}{{$tp}}(fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.{{$m.Field}}.Func(fn) }
}
{{- end}}

{{if eq $unset "its zero value" -}}
{{docs (wrapdocs (printf `%s is a recording test double of %s. Each field On<Method> configures its
method. An unconfigured method records the call and returns the zero values
of its results.` $stub $iface))}}
{{- else -}}
{{docs (wrapdocs (printf `%s is a recording test double of %s. Each field On<Method> configures its
method. An unconfigured method records the call and returns its default
results. The default result of a type with a builder is a new value from the
builder, and every other result is its zero value.` $stub $iface))}}
{{- end}}
{{- ""}}type {{$stub}}{{$tp}} struct {
{{- range $c.Methods}}
{{if .From}}{{memberdocs (wrapdocs (printf `%s configures %s, which %s declares.` .Field .Name .From))}}{{end}}
{{- ""}}	{{.Field}} *{{.Stub}}{{$ta}}
{{- end}}

	// group contains the stub of each method.
	group *stub.Group
{{- if $c.Ordered}}

	order *stub.OrderTracker
{{- end}}
	strict bool
}
{{- with $c.Guard}}

{{if $c.Witnesses -}}
{{docs (wrapdocs (printf `The compiler checks that %s implements %s at the witnesses of its type
parameters. The double does not branch on its type parameters, so it implements
%s at every instance.` $stub $iface $iface))}}
{{- else -}}
{{docs (wrapdocs (printf `The compiler checks that %s implements %s.` $stub $iface))}}
{{- end}}
{{- ""}}var _ {{spell .}} = (*{{$stub}}{{typeargs $c.Witnesses}})(nil)
{{- end}}

{{docs (wrapdocs (printf `%s returns a double of %s that reports its failures to tb and applies
opts. The double checks the expected counts of calls at the end of the test.
With a nil tb, the double reports nothing.` $new $iface))}}
{{- ""}}func {{$new}}{{$tp}}(tb assert.TB, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	s := &{{$stub}}{{$ta}}{
{{- range $c.Methods}}
		{{.Field}}: &{{.Stub}}{{$ta}}{MethodStub: stub.NewMethodStub[{{.Call}}{{$ta}}](tb, "{{.Qualified}}")},
{{- end}}
	}
	s.group = stub.NewGroup(
{{- range $c.Methods}}
		s.{{.Field}}.MethodStub,
{{- end}}
	)
	for _, opt := range opts {
		opt(s)
	}
	if s.strict {
		s.group.StrictAll()
	}
{{- if $c.Ordered}}
	// The tracker fails the test in strict mode alone, so it follows the
	// options.
	s.order = stub.NewOrderTracker(tb, s.strict)
{{- end}}
	s.group.Bind(tb)
	return s
}

{{docs (wrapdocs (printf `%sDelayed returns a double whose methods sleep d on clk before they
return. It applies opts after the clock and the latency.` $new))}}
{{- ""}}func {{$new}}Delayed{{$tp}}(tb assert.TB, d time.Duration, clk assert.Clock, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	return {{$new}}{{$ta}}(tb, append([]{{$stub}}Option{{$ta}}{
		{{$stub}}WithClock{{$ta}}(clk),
		{{$stub}}WithLatency{{$ta}}(d),
	}, opts...)...)
}
{{- if $c.Fallible}}

{{docs (wrapdocs (printf `%sFailing returns a double on which each call of a method that can
fail fails with err. It applies opts after the failure.` $new))}}
{{- ""}}func {{$new}}Failing{{$tp}}(tb assert.TB, err error, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	return {{$new}}{{$ta}}(tb, append([]{{$stub}}Option{{$ta}}{ {{- $stub}}Failing{{$ta}}(err)}, opts...)...)
}
{{- end}}

// ResetCalls clears the recorded calls, the counters of the faults and the
// expected counts. It keeps the functions, the fixed results and the faults.
func (s *{{$stub}}{{$ta}}) ResetCalls() {
	s.group.Reset()
{{- if $c.Ordered}}
	s.order.Reset()
{{- end}}
}
{{- range $i, $m := $c.Methods}}
{{- $dm := index $d.Methods.Items $i}}
{{- if $m.Returns}}

// invoke returns a call of the function of Func with the arguments, and nil
// where no function is set.
func ({{$m.Receiver}} *{{$m.Stub}}{{$ta}}) invoke({{template "stub.paramdecls" $m}}) func() {{$m.Return}}{{$ta}} {
	if {{$m.Receiver}}.fn == nil {
		return nil
	}
	return func() {{$m.Return}}{{$ta}} {
		{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Local}}{{end}} := {{$m.Receiver}}.fn({{template "stub.args" $m}})
		return {{$m.Return}}{{$ta}}{{"{"}}{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Field}}: {{$r.Local}}{{end}}{{"}"}}
	}
}
{{- else}}

// invokeVoid returns a call of the function of Func with the arguments, and
// nil where no function is set. The empty struct is the result of a method
// without results.
func ({{$m.Receiver}} *{{$m.Stub}}{{$ta}}) invokeVoid({{template "stub.paramdecls" $m}}) func() struct{} {
	if {{$m.Receiver}}.fn == nil {
		return nil
	}
	return func() struct{} {
		{{$m.Receiver}}.fn({{template "stub.args" $m}})
		return struct{}{}
	}
}
{{- end}}

{{docs (wrapdocs (printf `%s records the call. An armed fault comes first, then the function of
Func, then the results of Returns, and then the %s.` $m.Name (or (and $m.Defaulted "default results") "zero values")))}}
{{- ""}}func ({{receiver $dm}}) {{$dm.Name}}({{params $dm.Params}}){{results $dm.Returns}} {
{{- if $m.Deprecated}}
	// Bench mode logs nothing, because a log allocates on each call.
	if tb, logs := {{$m.Receiver}}.{{$m.Field}}.TB().(interface{ Logf(string, ...any) }); logs && !{{$m.Receiver}}.{{$m.Field}}.IsBenchMode() {
		tb.Logf("{{$m.Qualified}} is deprecated")
	}
{{- end}}
{{- with $m.After}}
	{{$m.Receiver}}.order.AssertAfter("{{$m.Name}}", "{{.}}")
{{- end}}
{{- if $c.Ordered}}
	defer {{$m.Receiver}}.order.Record("{{$m.Name}}")
{{- end}}
	{{$m.Record}} := {{$m.Call}}{{$ta}}{{"{"}}{{range $j, $p := $m.Params}}{{if $j}}, {{end}}{{$p.Field}}: {{$p.Name}}{{end}}{{"}"}}
{{- if $m.Returns}}
	{{$m.Answer}} := stub.Answer({{$m.Receiver}}.{{$m.Field}}.MethodStub, {{$m.Record}}, stub.Arms[{{$m.Call}}{{$ta}}, {{$m.Return}}{{$ta}}]{
		Invoke:   {{$m.Receiver}}.{{$m.Field}}.invoke({{template "stub.args" $m}}),
		Fallback: {{$m.Receiver}}.{{$m.Field}}.fallback,
{{- if ge $m.Err 0}}
		Fault:    func(err error) {{$m.Return}}{{$ta}} { return {{$m.Return}}{{$ta}}{{"{"}}{{(index $m.Returns $m.Err).Field}}: err{{"}"}} },
{{- end}}
{{- if $m.Defaulted}}
		Default: func() {{$m.Return}}{{$ta}} {
{{- range $r := $m.Returns}}{{with $r.Default}}
			{{$r.Local}} := {{spell (stubRef $d .Ref)}}{{typeargs .Args}}().Build()
{{- end}}{{end}}
			return {{$m.Return}}{{$ta}}{{"{"}}{{template "stub.defaults" $m}}{{"}"}}
		},
{{- end}}
		Stamp: func(c {{$m.Call}}{{$ta}}, r {{$m.Return}}{{$ta}}) {{$m.Call}}{{$ta}} {
{{- range $m.Returns}}
			c.{{.Field}} = r.{{.Field}}
{{- end}}
			return c
		},
	})
	return {{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$m.Answer}}.{{$r.Field}}{{end}}
{{- else}}
	stub.Answer({{$m.Receiver}}.{{$m.Field}}.MethodStub, {{$m.Record}}, stub.Arms[{{$m.Call}}{{$ta}}, struct{}]{
		Invoke: {{$m.Receiver}}.{{$m.Field}}.invokeVoid({{template "stub.args" $m}}),
	})
{{- end}}
}
{{- end}}
{{- end}}
{{- end}}

{{- define "stub.paramtypes"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.paramdecls"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}} {{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.blankparams"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}_ {{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.args"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{if $p.Variadic}}...{{end}}{{end}}
{{- end}}

{{- define "stub.results"}}
{{- if eq (len .Returns) 1}} {{spell (index .Returns 0).Type}}
{{- else if .Returns}} ({{range $i, $r := .Returns}}{{if $i}}, {{end}}{{spell $r.Type}}{{end}})
{{- end}}
{{- end}}

{{- define "stub.returnparams"}}
{{- range $i, $r := .Returns}}{{if $i}}, {{end}}{{$r.Param}} {{spell $r.Type}}{{end}}
{{- end}}

{{- define "stub.defaults"}}
{{- $sep := ""}}
{{- range $r := .Returns}}{{with $r.Default}}{{$sep}}{{$r.Field}}: {{if .Optional}}&{{end}}{{$r.Local}}{{$sep = ", "}}{{end}}{{end}}
{{- end}}
