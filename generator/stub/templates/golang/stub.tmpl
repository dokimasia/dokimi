{{- use "time"}}{{use "math/rand/v2"}}{{use "go.dokimi.dev/assert"}}{{use "go.dokimi.dev/stub"}}
{{- range .Records}}
{{- $d := .Decl}}
{{- $c := .Data}}
{{- if eq $d.Name $c.Double}}
{{- $stub := $d.Name}}
{{- $iface := $c.Subject}}
{{- $tp := typeparams $d.TypeParams}}
{{- $ta := typeargs $d.TypeParams}}
{{- $unset := "its zero value"}}{{range $c.Methods}}{{if .Defaulted}}{{$unset = "its default results"}}{{end}}{{end}}
{{- $retries := false}}{{range $c.Methods}}{{if .Retry}}{{$retries = true}}{{end}}{{end}}
{{- with $c.Producer}}

// --- {{$iface}}, the handle {{.}}'s methods answer ---
{{- end}}
{{- range $c.Methods}}

{{docs (wrapdocs (printf `%s records one invocation of %s.%s.

Fields take their names from the source signature; a slot the source
left unnamed or blank falls back to a positional name.` .Call $iface .Name))}}
{{- ""}}type {{.Call}}{{$tp}} struct {
{{- range .Params}}
	{{.Field}} {{if .Variadic}}[]{{end}}{{spell .Type}}
{{- end}}
{{- range .Returns}}
	{{.Field}} {{spell .Type}}
{{- end}}
}
{{- end}}

// --- Per-method configuration ---
{{- range $m := $c.Methods}}

{{docs (wrapdocs (printf `%s controls how the double answers %s and records
what it was asked.

The embedded MethodStub supplies the machinery every method shares: call
recording, fault injection, latency against a virtual clock, gates,
call-count expectations, and strict mode.` $m.Stub $m.Name))}}
{{- ""}}type {{$m.Stub}}{{$tp}} struct {
	*stub.MethodStub[{{$m.Call}}{{$ta}}]

	fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}
{{- if $m.Returns}}
	fallback *{{$m.Return}}{{$ta}}
{{- end}}
}
{{- if $m.Returns}}

{{docs (wrapdocs (printf `%s holds the fixed answer configured through Returns.` $m.Return))}}
{{- ""}}type {{$m.Return}}{{$tp}} struct {
{{- range $m.Returns}}
	{{.Field}} {{spell .Type}}
{{- end}}
}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `Returns pins a fixed result for every call to %s. A Func
override takes precedence over it, and so does an injected fault.` $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `Returns pins a fixed result for every call to %s. A Func
override takes precedence over it.

No fault can take precedence here: %s answers no error, so
the double is built with no fault arm and a fault armed through Faults
fails the test.` $m.Name $m.Name))}}
{{- end}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Returns({{template "stub.returnparams" $m}}) *{{$m.Stub}}{{$ta}} {
	s.fallback = &{{$m.Return}}{{$ta}}{{"{"}}{{range $i, $r := $m.Returns}}{{if $i}}, {{end}}{{$r.Field}}: {{$r.Param}}{{end}}{{"}"}}
	return s
}
{{- end}}

{{if ge $m.Err 0 -}}
{{docs (wrapdocs (printf `Func supplies a body for %s, for when the answer depends on the
arguments. An injected fault still takes precedence.` $m.Name))}}
{{- else -}}
{{docs (wrapdocs (printf `Func supplies a body for %s, for when the answer depends on the
arguments.
Nothing takes precedence over it: %s answers no error, so the
double carries no fault arm for one to be reported through.` $m.Name $m.Name))}}
{{- end}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Func(fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}) *{{$m.Stub}}{{$ta}} {
	s.fn = fn
	return s
}
{{- with $q := $m.Sequence}}

{{docs (wrapdocs (printf `Yields makes %s return a sequence over items.

Building a range-over-func by hand is a closure with a break-handling
branch in it, and a test that gets that branch wrong reports a bug in
itself rather than in the subject.` $m.Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) Yields(items ...{{spell $q.Elem}}) *{{$m.Stub}}{{$ta}} {
	s.fn = func({{template "stub.blankparams" $m}}){{template "stub.results" $m}} {
		return func(yield func({{spell $q.Elem}}{{with $q.Second}}, {{spell .}}{{end}}) bool) {
{{- if and $q.Second (not $q.Errors)}}
			var second {{spell $q.Second}}
{{- end}}
			for _, v := range items {
				if !yield(v{{if $q.Second}}, {{if $q.Errors}}nil{{else}}second{{end}}{{end}}) {
					return
				}
			}
		}
	}
	return s
}
{{- if $q.Errors}}

{{docs (wrapdocs (printf `YieldsError makes %s return a sequence that produces items and
then fails.

Failing partway through is the case a consumer's loop most often gets
wrong, and it cannot be reached by a sequence that only ever succeeds.` $m.Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) YieldsError(items []{{spell $q.Elem}}, err error) *{{$m.Stub}}{{$ta}} {
	s.fn = func({{template "stub.blankparams" $m}}){{template "stub.results" $m}} {
		return func(yield func({{spell $q.Elem}}, {{spell $q.Second}}) bool) {
			for _, v := range items {
				if !yield(v, nil) {
					return
				}
			}
			var zero {{spell $q.Elem}}
			yield(zero, err)
		}
	}
	return s
}
{{- end}}
{{- end}}
{{- range $m.Errors}}

{{docs (wrapdocs (printf `%s makes the next %s call fail with %s;
the calls after it succeed.

One-shot, because that is what a test asserting on this error's handling
wants: poison a single call, then let the scenario continue. Faults is
the periodic form for the rest.` .Helper $m.Name .Name))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) {{.Helper}}() *{{$m.Stub}}{{$ta}} {
	s.FaultsOnce({{value .Value}})
	return s
}
{{- end}}
{{- if $m.Retry}}{{use "go.dokimi.dev/fault"}}

{{docs (wrapdocs (printf `RetrySchedule makes %s fail with err on every call before call
number %d, which succeeds along with every call after it.` $m.Name $m.Retry))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) RetrySchedule(err error) *{{$m.Stub}}{{$ta}} {
	s.SetFault(fault.NewRetryFault[{{$m.Call}}{{$ta}}](err, {{$m.Retry}}))
	return s
}
{{- end}}
{{- if ge $m.Partition 0}}
{{- $p := index $m.Params $m.Partition}}

{{docs (wrapdocs (printf `FaultForPartition makes %s fail every nth call whose
%s matches key, leaving other partitions untouched.

Partitioned failure is what proves isolation: a test asserting that one
tenant's outage does not reach another needs the fault to be selective.` $m.Name $p.Field))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) FaultForPartition(key {{spell $p.Type}}, err error, n int) *{{$m.Stub}}{{$ta}} {
	s.FaultsWhen(func(c {{$m.Call}}{{$ta}}) bool { return c.{{$p.Field}} == key }, err, n)
	return s
}

{{docs (wrapdocs (printf `FaultForOtherPartitions inverts FaultForPartition: every nth call whose
%s does not match key fails, and the named partition is left
healthy.` $p.Field))}}
{{- ""}}func (s *{{$m.Stub}}{{$ta}}) FaultForOtherPartitions(key {{spell $p.Type}}, err error, n int) *{{$m.Stub}}{{$ta}} {
	s.FaultsWhen(func(c {{$m.Call}}{{$ta}}) bool { return c.{{$p.Field}} != key }, err, n)
	return s
}
{{- end}}
{{- end}}

// --- {{$stub}} ---

// The witness of the major version of the runtime of doubles.
var _ = stub.CompatV1
{{- if $retries}}

// The witness of the major version of the fault strategies.
var _ = fault.CompatV1
{{- end}}

{{docs (wrapdocs (printf `%sOption configures a [%s] at construction time.` $stub $stub))}}
{{- ""}}type {{$stub}}Option{{$tp}} func(*{{$stub}}{{$ta}})

{{docs (wrapdocs (printf `%sStrict makes an unconfigured method fail the test rather than
return %s.` $stub $unset))}}
{{- ""}}func {{$stub}}Strict{{$tp}}() {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.strict = true }
}

{{docs (wrapdocs (printf `%sDelegateTo wraps a real implementation: every method forwards to
impl and is recorded on the double on the way through.` $stub))}}
{{- ""}}func {{$stub}}DelegateTo{{$tp}}(impl {{spell $c.Delegate}}) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) {
{{- range $c.Methods}}
		s.{{.Field}}.Func(impl.{{.Name}})
{{- end}}
	}
}

{{docs (wrapdocs (printf `%sWithClock drives latency and time-windowed faults from clk
rather than from wall time, so a test asserting on a five-second timeout
does not take five seconds.` $stub))}}
{{- ""}}func {{$stub}}WithClock{{$tp}}(clk assert.Clock) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetClock(clk) }
}

{{docs (wrapdocs (printf `%sWithRandSource makes probabilistic fault injection reproducible.
A failure nobody can replay is not a finding.` $stub))}}
{{- ""}}func {{$stub}}WithRandSource{{$tp}}(src rand.Source) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetRandSource(src) }
}

{{docs (wrapdocs (printf `%sBenchMode disables call recording. Dispatch still works; only
the accumulating call log is dropped.` $stub))}}
{{- ""}}func {{$stub}}BenchMode{{$tp}}() {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.BenchMode() }
}

{{docs (wrapdocs (printf `%sWithLatency makes every method sleep d before answering, for a
test standing in for a slow dependency rather than one slow method. Pair
it with %sWithClock, or d elapses in wall time.` $stub $stub))}}
{{- ""}}func {{$stub}}WithLatency{{$tp}}(d time.Duration) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.group.SetLatency(d) }
}
{{- if $c.Fallible}}

{{docs (wrapdocs (printf `%sFailing arms every method that can fail with err, so a
caller's error path is one option rather than one Faults call per
method. A method answering no error is left alone.` $stub))}}
{{- ""}}func {{$stub}}Failing{{$tp}}(err error) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) {
{{- range $c.Methods}}
{{- if ge .Err 0}}
		s.{{.Field}}.Faults(err, 1)
{{- end}}
{{- end}}
	}
}
{{- end}}
{{- range $m := $c.Methods}}

{{docs (wrapdocs (printf `With%s%s sets %s's body at construction
time, for the common case of configuring one method and taking the
defaults for the rest.` $iface $m.Name $m.Name))}}
{{- ""}}func With{{$iface}}{{$m.Name}}{{$tp}}(fn func({{template "stub.paramtypes" $m}}){{template "stub.results" $m}}) {{$stub}}Option{{$ta}} {
	return func(s *{{$stub}}{{$ta}}) { s.{{$m.Field}}.Func(fn) }
}
{{- end}}

{{if eq $unset "its zero value" -}}
{{docs (wrapdocs (printf `%s is a recording test double for %s.

Each On<Method> field is that method's configuration point. Left alone, a
method returns its zero value and records the call.` $stub $iface))}}
{{- else -}}
{{docs (wrapdocs (printf `%s is a recording test double for %s.

Each On<Method> field is that method's configuration point. Left alone, a
method records the call and returns its default results: a new value from
the builder of each result type that has one, and the zero value of each
other result.` $stub $iface))}}
{{- end}}
{{- ""}}type {{$stub}}{{$tp}} struct {
{{- range $c.Methods}}
{{if .From}}{{memberdocs (wrapdocs (printf `%s configures %s, contributed by %s.` .Field .Name .From))}}{{end}}
{{- ""}}	{{.Field}} *{{.Stub}}{{$ta}}
{{- end}}

	// group is every method stub above, viewed through the surface that
	// does not depend on a signature.
	group *stub.Group
{{- if $c.Ordered}}

	order *stub.OrderTracker
{{- end}}
	strict bool
}
{{- with $c.Guard}}

{{if $c.Witnesses -}}
{{docs (wrapdocs (printf `Compile-time proof that %s satisfies %s.

A generic double is asserted at one instantiation. It never branches on its
type parameters, so satisfying the interface at these types means satisfying
it at every type the constraints admit.` $stub $iface))}}
{{- else -}}
{{docs (wrapdocs (printf `Compile-time proof that %s satisfies %s.` $stub $iface))}}
{{- end}}
{{- ""}}var _ {{spell .}} = (*{{$stub}}{{typeargs $c.Witnesses}})(nil)
{{- end}}

{{docs (wrapdocs (printf `New%s returns a double bound to tb.

Passing tb registers a cleanup that verifies every method's call-count
expectations when the test ends, so an unmet Times is reported without the
caller remembering to check. A nil tb skips that, which is what benchmarks
and non-test callers want.` $stub))}}
{{- ""}}func New{{$stub}}{{$tp}}(tb assert.TB, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	s := &{{$stub}}{{$ta}}{
{{- range $c.Methods}}
		{{.Field}}: &{{.Stub}}{{$ta}}{MethodStub: stub.NewMethodStub[{{.Call}}{{$ta}}](tb, "{{.Qualified}}")},
{{- end}}
	}
	s.group = stub.NewGroup(
{{- range $c.Methods}}
		s.{{.Field}}.MethodStub,
{{- end}}
	)
	for _, opt := range opts {
		opt(s)
	}
	if s.strict {
		s.group.StrictAll()
	}
{{- if $c.Ordered}}
	// Allocated after the options run: the tracker only fails the test in
	// strict mode, so it has to be told which mode it is in.
	s.order = stub.NewOrderTracker(tb, s.strict)
{{- end}}
	s.group.Bind(tb)
	return s
}

{{docs (wrapdocs (printf `New%sDelayed returns a double whose every method sleeps d against
clk before answering — the clock and the latency a slow-dependency test
wants, in one call rather than two options. Further options apply after
the pair, so a caller can still add Strict or a method override.` $stub))}}
{{- ""}}func New{{$stub}}Delayed{{$tp}}(tb assert.TB, d time.Duration, clk assert.Clock, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	return New{{$stub}}{{$ta}}(tb, append([]{{$stub}}Option{{$ta}}{
		{{$stub}}WithClock{{$ta}}(clk),
		{{$stub}}WithLatency{{$ta}}(d),
	}, opts...)...)
}
{{- if $c.Fallible}}

{{docs (wrapdocs (printf `New%sFailing returns a double whose every fallible method answers
err — [%sFailing] applied at construction, for the test whose
whole subject is the caller's error path. Further options apply after it.` $stub $stub))}}
{{- ""}}func New{{$stub}}Failing{{$tp}}(tb assert.TB, err error, opts ...{{$stub}}Option{{$ta}}) *{{$stub}}{{$ta}} {
	return New{{$stub}}{{$ta}}(tb, append([]{{$stub}}Option{{$ta}}{ {{- $stub}}Failing{{$ta}}(err)}, opts...)...)
}
{{- end}}

// ResetCalls clears recorded calls, fault counters, and call-count
// expectations. Func and Returns configuration is deliberately preserved, so
// a test can reuse one double across phases without rebuilding it.
func (s *{{$stub}}{{$ta}}) ResetCalls() {
	s.group.Reset()
{{- if $c.Ordered}}
	s.order.Reset()
{{- end}}
}

// --- Interface methods ---
{{- range $i, $m := $c.Methods}}
{{- $dm := index $d.Methods.Items $i}}
{{- if $m.Returns}}

// invoke adapts the Func override to the shape [stub.Answer] consumes, or
// returns nil when no override is set — which is how Answer tells "no
// override" from "an override that returns zero".
func ({{$m.Receiver}} *{{$m.Stub}}{{$ta}}) invoke({{template "stub.paramdecls" $m}}) func() {{$m.Return}}{{$ta}} {
	if {{$m.Receiver}}.fn == nil {
		return nil
	}
	return func() {{$m.Return}}{{$ta}} {
		{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Local}}{{end}} := {{$m.Receiver}}.fn({{template "stub.args" $m}})
		return {{$m.Return}}{{$ta}}{{"{"}}{{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$r.Field}}: {{$r.Local}}{{end}}{{"}"}}
	}
}
{{- else}}

// invokeVoid adapts the Func override to the shape [stub.Answer] consumes.
// A method returning nothing still has an override worth dispatching to and
// a call worth recording; the empty struct is the return tuple of no returns.
func ({{$m.Receiver}} *{{$m.Stub}}{{$ta}}) invokeVoid({{template "stub.paramdecls" $m}}) func() struct{} {
	if {{$m.Receiver}}.fn == nil {
		return nil
	}
	return func() struct{} {
		{{$m.Receiver}}.fn({{template "stub.args" $m}})
		return struct{}{}
	}
}
{{- end}}

{{docs (wrapdocs (printf `%s records the call and answers it.

Which arm answers — injected fault, Func override, Returns fallback, or the
%s — is [stub.Answer]'s to decide, so every generated double
resolves a call the same way and the ordering is tested once rather than
restated per method.` $m.Name (or (and $m.Defaulted "default results") "zero value")))}}
{{- ""}}func ({{receiver $dm}}) {{$dm.Name}}({{params $dm.Params}}){{results $dm.Returns}} {
{{- if $m.Deprecated}}
	// Skipped in bench mode: Logf allocates the formatted message per
	// dispatch, which is what a benchmark through this double would
	// otherwise be measuring.
	if tb, logs := {{$m.Receiver}}.{{$m.Field}}.TB().(interface{ Logf(string, ...any) }); logs && !{{$m.Receiver}}.{{$m.Field}}.IsBenchMode() {
		tb.Logf("{{$m.Qualified}} is deprecated")
	}
{{- end}}
{{- with $m.After}}
	{{$m.Receiver}}.order.AssertAfter("{{$m.Name}}", "{{.}}")
{{- end}}
{{- if $c.Ordered}}
	defer {{$m.Receiver}}.order.Record("{{$m.Name}}")
{{- end}}
	{{$m.Record}} := {{$m.Call}}{{$ta}}{{"{"}}{{range $j, $p := $m.Params}}{{if $j}}, {{end}}{{$p.Field}}: {{$p.Name}}{{end}}{{"}"}}
{{- if $m.Returns}}
	{{$m.Answer}} := stub.Answer({{$m.Receiver}}.{{$m.Field}}.MethodStub, &{{$m.Record}}, stub.Arms[{{$m.Call}}{{$ta}}, {{$m.Return}}{{$ta}}]{
		Invoke:   {{$m.Receiver}}.{{$m.Field}}.invoke({{template "stub.args" $m}}),
		Fallback: {{$m.Receiver}}.{{$m.Field}}.fallback,
{{- if ge $m.Err 0}}
		Fault:    func(err error) {{$m.Return}}{{$ta}} { return {{$m.Return}}{{$ta}}{{"{"}}{{(index $m.Returns $m.Err).Field}}: err{{"}"}} },
{{- end}}
{{- if $m.Defaulted}}
		Default: func() {{$m.Return}}{{$ta}} {
{{- range $r := $m.Returns}}{{with $r.Default}}
			{{$r.Local}} := {{spell (stubRef $d .Ref)}}{{typeargs .Args}}().Build()
{{- end}}{{end}}
			return {{$m.Return}}{{$ta}}{{"{"}}{{template "stub.defaults" $m}}{{"}"}}
		},
{{- end}}
		Stamp: func(c *{{$m.Call}}{{$ta}}, r {{$m.Return}}{{$ta}}) {
{{- range $m.Returns}}
			c.{{.Field}} = r.{{.Field}}
{{- end}}
		},
	})
	return {{range $j, $r := $m.Returns}}{{if $j}}, {{end}}{{$m.Answer}}.{{$r.Field}}{{end}}
{{- else}}
	stub.Answer({{$m.Receiver}}.{{$m.Field}}.MethodStub, &{{$m.Record}}, stub.Arms[{{$m.Call}}{{$ta}}, struct{}]{
		Invoke: {{$m.Receiver}}.{{$m.Field}}.invokeVoid({{template "stub.args" $m}}),
	})
{{- end}}
}
{{- end}}
{{- end}}
{{- end}}

{{- define "stub.paramtypes"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.paramdecls"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}} {{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.blankparams"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}_ {{if $p.Variadic}}...{{end}}{{spell $p.Type}}{{end}}
{{- end}}

{{- define "stub.args"}}
{{- range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{if $p.Variadic}}...{{end}}{{end}}
{{- end}}

{{- define "stub.results"}}
{{- if eq (len .Returns) 1}} {{spell (index .Returns 0).Type}}
{{- else if .Returns}} ({{range $i, $r := .Returns}}{{if $i}}, {{end}}{{spell $r.Type}}{{end}})
{{- end}}
{{- end}}

{{- define "stub.returnparams"}}
{{- range $i, $r := .Returns}}{{if $i}}, {{end}}{{$r.Param}} {{spell $r.Type}}{{end}}
{{- end}}

{{- define "stub.defaults"}}
{{- $sep := ""}}
{{- range $r := .Returns}}{{with $r.Default}}{{$sep}}{{$r.Field}}: {{if .Optional}}&{{end}}{{$r.Local}}{{$sep = ", "}}{{end}}{{end}}
{{- end}}
