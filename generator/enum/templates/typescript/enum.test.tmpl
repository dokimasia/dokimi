{{- use "vitest" "describe"}}{{use "@dokimi/assert/vitest" "test"}}{{use "@dokimi/assert" "check"}}
{{- $surface := surfaceModule $.Name}}
{{- $source := sourceModule $.Name}}
{{- define "set"}}
{{- if .Calls.Values}}
  const all = {{.Names.Values}}();
{{- else}}
  const all = [
{{- $e := spellvalue .Type}}
{{- range .Variants}}
    {{$e}}{{.Member}},
{{- end}}
  ];
{{- end}}
{{- end}}
{{- range .Records}}
{{- $c := .Data}}
{{- $t := spell $c.Type}}
{{- $e := spellvalue $c.Type}}
{{- $n := $c.Names}}
{{- if $c.Calls.Values}}{{use $surface $n.Values}}{{end}}
{{- if $c.Calls.Render}}{{use (or (and $c.Generate.Render $surface) $source) $n.Render}}{{end}}
{{- if $c.Calls.Valid}}{{use (or (and $c.Generate.Valid $surface) $source) $n.Valid}}{{end}}
{{- if $c.Calls.Parse}}{{use $surface $n.Parse}}{{use $surface $n.Sentinel}}{{end}}

describe("{{$c.Subject}} variants", () => {
{{- template "set" $c}}

  test("declares exactly {{len $c.Variants}} variants", ({ seat }) => {
    check.length(seat, all, {{len $c.Variants}}, "the declared set must not change unnoticed");
  });

  test("no two variants share a value", ({ seat }) => {
    const seen = new Set<{{$t}}>();
    for (const value of all) {
      check.isFalse(seat, seen.has(value), "each variant must hold a distinct value");
      seen.add(value);
    }
  });
{{- if $c.Calls.Render}}
{{- if $c.Stated}}

  test("every variant renders the value it declares", ({ seat }) => {
{{- range $c.Variants}}
{{- if .Stated}}
    check.equal(seat, {{$n.Render}}({{$e}}{{.Member}}), {{.Text}}, "the declared value is the textual form");
{{- end}}
{{- end}}
  });
{{- end}}

  test("no two variants share a textual form", ({ seat }) => {
    const seen = new Set<string>();
    for (const value of all) {
      check.isFalse(seat, seen.has({{$n.Render}}(value)), "each variant must render distinctly");
      seen.add({{$n.Render}}(value));
    }
  });
{{- end}}
{{- if $c.Calls.Valid}}
{{- if $c.OutOfRange}}

  test("a value outside the set is not valid", ({ seat }) => {
    check.isFalse(seat, {{$n.Valid}}({{$c.OutOfRange}}), "an undeclared value must not be valid");
  });
{{- end}}

  test("every declared variant is valid", ({ seat }) => {
    for (const value of all) {
      check.isTrue(seat, {{$n.Valid}}(value), "a declared variant must be valid");
    }
  });
{{- end}}
});
{{- if $c.Calls.Parse}}

describe("{{$c.Subject}} text", () => {
{{- template "set" $c}}

  test("every variant survives a text round trip", ({ seat }) => {
    for (const value of all) {
      check.equal(seat, {{$n.Parse}}({{$n.Render}}(value)), value, "the round trip must be lossless");
    }
  });

  test("text naming no variant is refused", ({ seat }) => {
    const err = check.throws(seat, () => {{$n.Parse}}({{$c.Unknown}}), "unknown text must be refused");
    check.errorAs(seat, err, {{$n.Sentinel}}, "unknown text must be refused with the declared refusal");
  });
{{- if $c.OutOfRange}}

  test("a value outside the set does not render as one inside it", ({ seat }) => {
    const out = {{$c.OutOfRange}} as unknown as {{$t}};
    for (const value of all) {
      check.notEqual(seat, {{$n.Render}}(out), {{$n.Render}}(value), "an undeclared value must render distinctly");
    }
  });
{{- end}}
});
{{- end}}
{{- end}}
