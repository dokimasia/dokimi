{{- define "suite.apply"}}func(ctx {{import "context"}}.Context, args []any) {{import "go.dokimi.dev/conform"}}.Output {
{{- range .Lets}}
	{{.Name}}, _ := args[{{.Index}}].({{spell .Type}})
{{- end}}
